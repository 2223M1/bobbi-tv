<?xml version='1.0' encoding='utf-8'?>
<includes>
  <expression name="BobiRailRecovery">String.IsEqual(ListItem.Property(Bobi.Rail.State),empty) | String.IsEqual(ListItem.Property(Bobi.Rail.State),error) | String.IsEqual(ListItem.Property(Bobi.Rail.State),auth_required)</expression>
  <include name="HomeRailStateCard">
    <param name="w">232</param><param name="h">348</param>
    <param name="focused">false</param>
    <definition>
      <control type="group">
        <visible>$EXP[BobiRailRecovery]</visible>
        <control type="image">
          <width>$PARAM[w]</width><height>$PARAM[h]</height>
          <texture colordiffuse="surface_hi" border="14">bobi/r14.png</texture>
        </control>
        <control type="textbox">
          <left>20</left><top>68</top><width>192</width><height>180</height>
          <font>Body26</font><textcolor>text</textcolor>
          <label>$INFO[ListItem.Label]</label>
        </control>
        <control type="label">
          <left>20</left><top>20</top><width>192</width><height>36</height>
          <label>按确定打开</label><font>Meta22</font><textcolor>text3</textcolor>
        </control>
        <control type="group">
          <visible>$PARAM[focused]</visible>
          <include content="FocusRing"><param name="w">$PARAM[w]</param><param name="h">$PARAM[h]</param></include>
        </control>
      </control>
    </definition>
  </include>
  <!-- Home rail declarations and shared selectors are statically generated. -->
  <!-- 我的 hub: the newest resume item, read from the hidden 继续观看 list (container 9130) -->
  <variable name="HubResumeStateTitle">
    <value condition="Container(9130).IsUpdating">正在读取观看记录</value>
    <value condition="String.IsEqual(Container(9130).ListItem.Property(Bobi.Resume.State),empty)">还没有在看的影片</value>
    <value condition="String.IsEqual(Container(9130).ListItem.Property(Bobi.Resume.State),error)">暂时无法读取观看记录</value>
    <value>正在读取观看记录</value>
  </variable>
  <variable name="HubResumeStateDescription">
    <value condition="Container(9130).IsUpdating">正在与首页同步；你可以先使用左侧菜单。</value>
    <value condition="String.IsEqual(Container(9130).ListItem.Property(Bobi.Resume.State),empty)">从首页片单选一部开始；未看完的影院影片会留在这里。</value>
    <value condition="String.IsEqual(Container(9130).ListItem.Property(Bobi.Resume.State),error)">观看记录未被清除；请从左侧“继续观看”重试。</value>
    <value>你可以从左侧“继续观看”查看或重试。</value>
  </variable>
  <variable name="HubResumeArt">
    <value condition="!String.IsEmpty(Container(9130).ListItem.Art(thumb))">$INFO[Container(9130).ListItem.Art(thumb)]</value>
    <value condition="!String.IsEmpty(Container(9130).ListItem.Art(fanart))">$INFO[Container(9130).ListItem.Art(fanart)]</value>
    <value>$INFO[Container(9130).ListItem.Art(landscape)]</value>
  </variable>
  <variable name="HubResumeTitle">
    <value condition="!String.IsEmpty(Container(9130).ListItem.Property(Bobi.Title.zh))">$INFO[Container(9130).ListItem.Property(Bobi.Title.zh)]</value>
    <value condition="!String.IsEmpty(Container(9130).ListItem.TVShowTitle)">$INFO[Container(9130).ListItem.TVShowTitle]</value>
    <value condition="!String.IsEmpty(Container(9130).ListItem.Title)">$INFO[Container(9130).ListItem.Title]</value>
    <value>$INFO[Container(9130).ListItem.Label]</value>
  </variable>
  <variable name="HubResumeSubline">
    <value condition="!String.IsEmpty(Container(9130).ListItem.Season) + !String.IsEmpty(Container(9130).ListItem.Episode)">第$INFO[Container(9130).ListItem.Season]季 · 第$INFO[Container(9130).ListItem.Episode]集$INFO[Container(9130).ListItem.Year,   ·   ]</value>
    <value condition="!String.IsEmpty(Container(9130).ListItem.Year)">$INFO[Container(9130).ListItem.Year]$INFO[Container(9130).ListItem.Genre,   ·   ]</value>
    <value>$INFO[Container(9130).ListItem.Label2]</value>
  </variable>

  <!-- poster rail (2:3) -->
  <include name="HomeRail">
    <param name="id" />
    <param name="title" />
    <param name="content" />
    <param name="key" />
    <param name="limit">20</param>
    <param name="preloaditems">2</param>
    <definition>
      <control type="group">
        <width>1920</width><height>420</height>
        <animation effect="slide" start="0,0" end="0,2160" time="0" condition="!String.IsEqual(Control.GetLabel(9791),$PARAM[id])">Conditional</animation>
        <!-- Keep the provider owner alive: Kodi evaluates node.visible one
             tick after DONE. Hiding this group on zero items prevents that
             tick and permanently hides account-filtered cards. Navigation
             still skips empty lists. Inactive rails are translated offscreen,
             not hidden, so they keep processing without occupying scroll slots. -->
        <control type="label">
          <left>96</left><top>0</top><width>1100</width><height>48</height>
          <label>$PARAM[title]</label>
          <visible>Integer.IsGreater(Container($PARAM[id]).NumItems,0) | Container($PARAM[id]).IsUpdating</visible>
          <font>Head30</font><textcolor>text</textcolor><aligny>center</aligny>
        </control>
        <control type="label">
          <left>1424</left><top>0</top><width>400</width><height>48</height>
          <label>$INFO[Container($PARAM[id]).CurrentItem]$INFO[Container($PARAM[id]).NumItems, / ,]</label>
          <font>Meta22</font><textcolor>text3</textcolor><align>right</align><aligny>center</aligny>
          <visible>Control.HasFocus($PARAM[id])</visible>
        </control>
        <control type="label">
          <left>980</left><top>0</top><width>420</width><height>48</height>
          <label>保留上次片单 · 可继续浏览</label><font>Meta22</font><textcolor>text3</textcolor>
          <visible>String.IsEqual(Container($PARAM[id]).ListItem.Property(Bobi.Rail.State),stale) | [Container($PARAM[id]).IsUpdating + String.IsEqual(Container($PARAM[id]).ListItem.Property(Bobi.Rail.State),ready)]</visible>
        </control>
        <control type="group">
          <left>96</left><top>60</top>
          <visible>Container($PARAM[id]).IsUpdating + Integer.IsEqual(Container($PARAM[id]).NumItems,0)</visible>
          <include content="SkeletonRow" />
        </control>
        <control type="list" id="$PARAM[id]">
          <left>72</left><top>40</top><width>1848</width><height>380</height>
          <orientation>horizontal</orientation>
          <scrolltime tween="cubic" easing="out">180</scrolltime>
          <focusposition>0</focusposition>
          <movement>0</movement>
          <preloaditems>$PARAM[preloaditems]</preloaditems>
          <enable>Integer.IsGreater(Container($PARAM[id]).NumItems,0)</enable>
          <onup>SetFocus($VAR[HomeRailUp])</onup>
          <ondown>SetFocus($VAR[HomeRailDown])</ondown>
          <onleft>noop</onleft>
          <onright>noop</onright>
          <onfocus>SetProperty(BobiRail,$PARAM[id],Home)</onfocus>
          <onback condition="!Integer.IsEqual(Container($PARAM[id]).CurrentItem,1)">Control.SetFocus($PARAM[id],0)</onback>
          <onback condition="Integer.IsEqual(Container($PARAM[id]).CurrentItem,1)">SetFocus(9701)</onback>
          <itemlayout width="264" height="380">
            <control type="group">
              <left>24</left><top>20</top>
              <control type="group">
                <visible>!$EXP[BobiIsMore] + !$EXP[BobiRailRecovery]</visible>
                <include content="PosterArt" />
                <include content="ArtBadges" />
              </control>
              <include content="MoreTile"><param name="visible">$EXP[BobiIsMore]</param></include>
              <include>HomeRailStateCard</include>
            </control>
          </itemlayout>
          <focusedlayout width="264" height="380">
            <control type="group">
              <left>24</left><top>20</top>
              <include content="Lift"><param name="center">116,174</param><param name="zoom">106</param></include>
              <control type="group">
                <visible>!$EXP[BobiIsMore] + !$EXP[BobiRailRecovery]</visible>
                <control type="group">
                  <visible>Control.HasFocus($PARAM[id])</visible>
                  <include content="CardShadow"><param name="w">288</param><param name="h">392</param></include>
                </control>
                <include content="PosterArt" />
                <include content="ArtBadges" />
                <control type="group">
                  <visible>Control.HasFocus($PARAM[id])</visible>
                  <include content="FocusRing" />
                </control>
              </control>
              <include content="MoreTile">
                <param name="visible">$EXP[BobiIsMore]</param>
                <param name="focused">Control.HasFocus($PARAM[id])</param>
              </include>
              <include content="HomeRailStateCard"><param name="focused">Control.HasFocus($PARAM[id])</param></include>
            </control>
          </focusedlayout>
          <content target="videos" limit="$PARAM[limit]" browse="never">$PARAM[content]&amp;rail=$PARAM[key]&amp;revision=$INFO[Window(Home).Property(Bobi.Rail.Revision.$PARAM[key])]</content>
        </control>
      </control>
    </definition>
  </include>

  <!-- wide rail (16:9) for resume: card + title + episode/progress line -->
  <include name="HomeRailWide">
    <param name="id" />
    <param name="title" />
    <param name="content" />
    <param name="key" />
    <param name="limit">20</param>
    <param name="preloaditems">2</param>
    <definition>
      <control type="group">
        <width>1920</width><height>420</height>
        <animation effect="slide" start="0,0" end="0,2160" time="0" condition="!String.IsEqual(Control.GetLabel(9791),$PARAM[id])">Conditional</animation>
        <!-- Same provider-lifetime rule as HomeRail; do not gate its parent
             processing on the result of the provider itself. -->
        <control type="label">
          <left>96</left><top>0</top><width>1100</width><height>48</height>
          <label>$PARAM[title]</label>
          <visible>Integer.IsGreater(Container($PARAM[id]).NumItems,0) | Container($PARAM[id]).IsUpdating</visible>
          <font>Head30</font><textcolor>text</textcolor><aligny>center</aligny>
        </control>
        <control type="label">
          <left>1424</left><top>0</top><width>400</width><height>48</height>
          <label>$INFO[Container($PARAM[id]).CurrentItem]$INFO[Container($PARAM[id]).NumItems, / ,]</label>
          <font>Meta22</font><textcolor>text3</textcolor><align>right</align><aligny>center</aligny>
          <visible>Control.HasFocus($PARAM[id])</visible>
        </control>
        <control type="label">
          <left>96</left><top>120</top><width>1600</width><height>48</height>
          <label>正在读取观看记录…</label>
          <font>Body26</font><textcolor>text3</textcolor><aligny>center</aligny>
          <visible>Container($PARAM[id]).IsUpdating + Integer.IsEqual(Container($PARAM[id]).NumItems,0)</visible>
        </control>
        <control type="list" id="$PARAM[id]">
          <left>72</left><top>40</top><width>1848</width><height>380</height>
          <orientation>horizontal</orientation>
          <scrolltime tween="cubic" easing="out">180</scrolltime>
          <focusposition>0</focusposition>
          <movement>0</movement>
          <preloaditems>$PARAM[preloaditems]</preloaditems>
          <enable>Integer.IsGreater(Container($PARAM[id]).NumItems,0)</enable>
          <onup>SetFocus($VAR[HomeRailUp])</onup>
          <ondown>SetFocus($VAR[HomeRailDown])</ondown>
          <onleft>noop</onleft>
          <onright>noop</onright>
          <onfocus>SetProperty(BobiRail,$PARAM[id],Home)</onfocus>
          <onback condition="!Integer.IsEqual(Container($PARAM[id]).CurrentItem,1)">Control.SetFocus($PARAM[id],0)</onback>
          <onback condition="Integer.IsEqual(Container($PARAM[id]).CurrentItem,1)">SetFocus(9701)</onback>
          <itemlayout width="432" height="380">
            <control type="group">
              <left>24</left><top>20</top>
              <control type="group">
                <visible>!$EXP[BobiIsMore] + !$EXP[BobiRailRecovery]</visible>
                <include content="WideCard" />
              </control>
              <include content="MoreTile">
                <param name="visible">$EXP[BobiIsMore]</param>
                <param name="w">400</param><param name="h">225</param>
              </include>
              <include content="HomeRailStateCard"><param name="w">400</param><param name="h">225</param></include>
            </control>
          </itemlayout>
          <focusedlayout width="432" height="380">
            <control type="group">
              <left>24</left><top>20</top>
              <control type="group">
                <visible>!$EXP[BobiIsMore] + !$EXP[BobiRailRecovery]</visible>
                <control type="group">
                  <include content="Lift"><param name="center">200,112</param><param name="zoom">105</param></include>
                  <control type="group">
                    <visible>Control.HasFocus($PARAM[id])</visible>
                    <include content="CardShadow"><param name="w">456</param><param name="h">269</param></include>
                  </control>
                  <include content="WideArt" />
                  <control type="group">
                    <visible>Control.HasFocus($PARAM[id])</visible>
                    <include content="FocusRing"><param name="w">416</param><param name="h">241</param></include>
                  </control>
                </control>
                <include content="WideCaption"><param name="focused">Control.HasFocus($PARAM[id])</param></include>
              </control>
              <include content="HomeRailStateCard"><param name="w">400</param><param name="h">225</param><param name="focused">Control.HasFocus($PARAM[id])</param></include>
              <control type="group">
                <include content="Lift"><param name="center">200,112</param><param name="zoom">105</param></include>
                <include content="MoreTile">
                  <param name="visible">$EXP[BobiIsMore]</param>
                  <param name="focused">Control.HasFocus($PARAM[id])</param>
                  <param name="w">400</param><param name="h">225</param>
                </include>
              </control>
            </control>
          </focusedlayout>
          <content target="videos" limit="$PARAM[limit]" browse="never">$PARAM[content]&amp;rail=$PARAM[key]&amp;revision=$INFO[Window(Home).Property(Bobi.Rail.Revision.$PARAM[key])]</content>
        </control>
      </control>
    </definition>
  </include>
  <include name="WideArt">
    <control type="image">
      <left>0</left><top>0</top><width>400</width><height>225</height>
      <texture colordiffuse="surface_hi" border="14">bobi/r14.png</texture>
    </control>
    <control type="image">
      <left>180</left><top>92</top><width>40</width><height>40</height>
      <texture colordiffuse="text3">bobi/icons/film.png</texture>
    </control>
    <control type="image">
      <left>0</left><top>0</top><width>400</width><height>225</height>
      <aspectratio scalediffuse="false">scale</aspectratio>
      <texture background="true" diffuse="bobi/mask-400x225.png">$VAR[LandscapeImage]</texture>
      <include>ArtFade</include>
    </control>
    <control type="image">
      <left>0</left><top>145</top><width>400</width><height>80</height>
      <texture colordiffuse="99000000" diffuse="bobi/mask-400x225.png">bobi/scrim-bottom.png</texture>
    </control>
    <include content="ArtBadges"><param name="barw">368</param><param name="bary">207</param></include>
  </include>
  <include name="WideCaption">
    <param name="focused">false</param>
    <definition>
      <control type="label">
        <left>2</left><top>238</top><width>396</width><height>40</height>
        <label>$VAR[CardTitle]</label>
        <font>Label28</font><textcolor>text</textcolor><aligny>center</aligny>
        <scroll>$PARAM[focused]</scroll>
      </control>
      <control type="label">
        <left>2</left><top>278</top><width>290</width><height>32</height>
        <label>$VAR[CardSubline]</label>
        <font>Meta22</font><textcolor>text3</textcolor><aligny>center</aligny>
      </control>
      <control type="label">
        <left>298</left><top>278</top><width>100</width><height>32</height>
        <label>$VAR[BobiPercentPlayed]%</label>
        <font>Label24</font><textcolor>accent</textcolor><align>right</align><aligny>center</aligny>
        <visible>Integer.IsGreater(ListItem.Property(PercentPlayed),0) | Integer.IsGreater(ListItem.PercentPlayed,0)</visible>
      </control>
    </definition>
  </include>
  <include name="WideCard">
    <include>WideArt</include>
    <include>WideCaption</include>
  </include>

  <!-- ===== "more" tile: replaces a plugin's 下一页 row in rails and walls =====
       Quiet outline card with an arrow in a disc; focus fills the card white. -->
  <include name="MoreTile">
    <param name="visible">true</param>
    <param name="focused">false</param>
    <param name="w">232</param>
    <param name="h">348</param>
    <definition>
      <control type="group">
        <visible>$PARAM[visible]</visible>
        <control type="image">
          <left>0</left><top>0</top><width>$PARAM[w]</width><height>$PARAM[h]</height>
          <texture colordiffuse="surface" border="14">bobi/r14.png</texture>
          <visible>!$PARAM[focused]</visible>
        </control>
        <control type="image">
          <left>0</left><top>0</top><width>$PARAM[w]</width><height>$PARAM[h]</height>
          <texture colordiffuse="surface_line" border="12">bobi/ring-thin-r10.png</texture>
          <visible>!$PARAM[focused]</visible>
        </control>
        <control type="image">
          <left>0</left><top>0</top><width>$PARAM[w]</width><height>$PARAM[h]</height>
          <texture colordiffuse="focus" border="14">bobi/r14.png</texture>
          <visible>$PARAM[focused]</visible>
        </control>
        <control type="group">
          <centerleft>50%</centerleft><centertop>50%</centertop><width>200</width><height>136</height>
          <control type="image">
            <left>64</left><top>0</top><width>72</width><height>72</height>
            <texture colordiffuse="surface_hi">bobi/pill.png</texture>
            <visible>!$PARAM[focused]</visible>
          </control>
          <control type="image">
            <left>64</left><top>0</top><width>72</width><height>72</height>
            <texture colordiffuse="on_focus">bobi/pill.png</texture>
            <visible>$PARAM[focused]</visible>
          </control>
          <control type="image">
            <left>82</left><top>18</top><width>36</width><height>36</height>
            <texture colordiffuse="text">bobi/icons/arrow-right.png</texture>
            <visible>!$PARAM[focused]</visible>
          </control>
          <control type="image">
            <left>82</left><top>18</top><width>36</width><height>36</height>
            <texture colordiffuse="focus">bobi/icons/arrow-right.png</texture>
            <visible>$PARAM[focused]</visible>
          </control>
          <control type="label">
            <left>0</left><top>88</top><width>200</width><height>44</height>
            <label>查看更多</label>
            <font>Label28</font><textcolor>text2</textcolor><align>center</align><aligny>center</aligny>
            <visible>!$PARAM[focused]</visible>
          </control>
          <control type="label">
            <left>0</left><top>88</top><width>200</width><height>44</height>
            <label>查看更多</label>
            <font>Label28</font><textcolor>on_focus</textcolor><align>center</align><aligny>center</aligny>
            <visible>$PARAM[focused]</visible>
          </control>
        </control>
      </control>
    </definition>
  </include>

  <!-- ===== library source tile (网盘 / NAS / 片库): 16:9 surface card, never a blank poster =====
       Item kinds from plugin.video.bobbi.library root: a source (folder) or the manage entry. -->
  <variable name="LibraryTileIcon">
    <value condition="$EXP[BobiIsManage]">bobi/icons/plus.png</value>
    <value condition="String.Contains(ListItem.Label,网盘) | String.Contains(ListItem.Label,云) | String.Contains(ListItem.Label,115) | String.Contains(ListItem.Label,WebDAV)">bobi/icons/cloud.png</value>
    <value condition="ListItem.IsFolder">bobi/icons/server.png</value>
    <value>bobi/icons/file-video.png</value>
  </variable>
  <variable name="LibraryTileTitle">
    <value condition="$EXP[BobiIsManage]">添加或管理</value>
    <value>$INFO[ListItem.Label]</value>
  </variable>
  <variable name="LibraryTileHint">
    <value condition="$EXP[BobiIsManage]">网盘 · NAS · 片库</value>
    <value condition="!String.IsEmpty(ListItem.Property(Bobi.Library.Location)) | !String.IsEmpty(ListItem.Label2)">$VAR[BobiLibraryLocation]</value>
    <value condition="ListItem.IsFolder">打开目录</value>
    <value>播放</value>
  </variable>
  <include name="LibraryTile">
    <param name="focused">false</param>
    <param name="w">400</param>
    <param name="h">225</param>
    <definition>
      <!-- card -->
      <control type="image">
        <left>0</left><top>0</top><width>$PARAM[w]</width><height>$PARAM[h]</height>
        <texture colordiffuse="surface_hi" border="14">bobi/r14.png</texture>
        <visible>!$PARAM[focused]</visible>
      </control>
      <control type="image">
        <left>0</left><top>0</top><width>$PARAM[w]</width><height>$PARAM[h]</height>
        <texture colordiffuse="1FFF8A3D" diffuse="bobi/mask-400x225.png">bobi/glow-corner.png</texture>
        <visible>!$PARAM[focused] + !$EXP[BobiIsManage]</visible>
      </control>
      <control type="image">
        <left>0</left><top>0</top><width>$PARAM[w]</width><height>$PARAM[h]</height>
        <texture colordiffuse="surface_line" border="12">bobi/ring-thin-r10.png</texture>
        <visible>!$PARAM[focused] + $EXP[BobiIsManage]</visible>
      </control>
      <control type="image">
        <left>0</left><top>0</top><width>$PARAM[w]</width><height>$PARAM[h]</height>
        <texture colordiffuse="focus" border="14">bobi/r14.png</texture>
        <visible>$PARAM[focused]</visible>
      </control>
      <!-- icon disc -->
      <control type="image">
        <left>32</left><top>32</top><width>72</width><height>72</height>
        <texture colordiffuse="33FF8A3D">bobi/pill.png</texture>
        <visible>!$PARAM[focused] + !$EXP[BobiIsManage]</visible>
      </control>
      <control type="image">
        <left>32</left><top>32</top><width>72</width><height>72</height>
        <texture colordiffuse="surface">bobi/pill.png</texture>
        <visible>!$PARAM[focused] + $EXP[BobiIsManage]</visible>
      </control>
      <control type="image">
        <left>32</left><top>32</top><width>72</width><height>72</height>
        <texture colordiffuse="on_focus">bobi/pill.png</texture>
        <visible>$PARAM[focused]</visible>
      </control>
      <control type="image">
        <left>50</left><top>50</top><width>36</width><height>36</height>
        <texture colordiffuse="accent_text">$VAR[LibraryTileIcon]</texture>
        <visible>!$PARAM[focused] + !$EXP[BobiIsManage]</visible>
      </control>
      <control type="image">
        <left>50</left><top>50</top><width>36</width><height>36</height>
        <texture colordiffuse="text2">$VAR[LibraryTileIcon]</texture>
        <visible>!$PARAM[focused] + $EXP[BobiIsManage]</visible>
      </control>
      <control type="image">
        <left>50</left><top>50</top><width>36</width><height>36</height>
        <texture colordiffuse="focus">$VAR[LibraryTileIcon]</texture>
        <visible>$PARAM[focused]</visible>
      </control>
      <!-- text -->
      <control type="label">
        <left>32</left><top>124</top><width>336</width><height>48</height>
        <label>$VAR[LibraryTileTitle]</label>
        <font>Head34</font><textcolor>text</textcolor><aligny>center</aligny>
        <visible>!$PARAM[focused]</visible>
      </control>
      <control type="label">
        <left>32</left><top>124</top><width>336</width><height>48</height>
        <label>$VAR[LibraryTileTitle]</label>
        <font>Head34</font><textcolor>on_focus</textcolor><aligny>center</aligny>
        <scroll>true</scroll>
        <visible>$PARAM[focused]</visible>
      </control>
      <control type="label">
        <left>32</left><top>170</top><width>300</width><height>32</height>
        <label>$VAR[LibraryTileHint]</label>
        <font>Meta22</font><textcolor>text3</textcolor><aligny>center</aligny>
        <visible>!$PARAM[focused]</visible>
      </control>
      <control type="label">
        <left>32</left><top>170</top><width>300</width><height>32</height>
        <label>$VAR[LibraryTileHint]</label>
        <font>Meta22</font><textcolor>B30A0B0E</textcolor><aligny>center</aligny>
        <visible>$PARAM[focused]</visible>
