  <!-- quiet placeholder posters while a rail loads (no spinner, no motion) -->
  <include name="SkeletonRow">
    <control type="image"><left>0</left><top>0</top><width>232</width><height>348</height><texture colordiffuse="surface" border="14">bobi/r14.png</texture></control>
    <control type="image"><left>264</left><top>0</top><width>232</width><height>348</height><texture colordiffuse="surface" border="14">bobi/r14.png</texture></control>
    <control type="image"><left>528</left><top>0</top><width>232</width><height>348</height><texture colordiffuse="surface" border="14">bobi/r14.png</texture></control>
    <control type="image"><left>792</left><top>0</top><width>232</width><height>348</height><texture colordiffuse="surface" border="14">bobi/r14.png</texture></control>
    <control type="image"><left>1056</left><top>0</top><width>232</width><height>348</height><texture colordiffuse="surface" border="14">bobi/r14.png</texture></control>
    <control type="image"><left>1320</left><top>0</top><width>232</width><height>348</height><texture colordiffuse="surface" border="14">bobi/r14.png</texture></control>
    <control type="image"><left>1584</left><top>0</top><width>232</width><height>348</height><texture colordiffuse="surface" border="14">bobi/r14.png</texture></control>
  </include>

  <!-- read-only chip: outline pill for season / episode, accent fill for progress -->
  <include name="StageChip">
    <param name="id" />
    <param name="label" />
    <definition>
      <control type="button" id="$PARAM[id]">
        <width>auto</width><height>44</height>
        <label>$PARAM[label]</label>
        <font>Button24</font><textcolor>text</textcolor><disabledcolor>text</disabledcolor>
        <textoffsetx>18</textoffsetx><align>center</align><aligny>center</aligny>
        <texturenofocus colordiffuse="59FFFFFF" border="12">bobi/ring-thin-r10.png</texturenofocus>
        <texturefocus colordiffuse="59FFFFFF" border="12">bobi/ring-thin-r10.png</texturefocus>
        <enable>false</enable>
        <visible>!String.IsEmpty(Control.GetLabel($PARAM[id]))</visible>
      </control>
    </definition>
  </include>

  <include name="HomeStage">
    <control type="group" id="9600">
      <control type="image">
        <left>560</left><top>0</top><width>1360</width><height>765</height>
        <aspectratio>scale</aspectratio>
        <texture background="true">$VAR[StageArt]</texture>
        <include>ArtFade</include>
      </control>
      <control type="image">
        <left>560</left><top>0</top><width>960</width><height>765</height>
        <texture colordiffuse="bg">bobi/scrim-left.png</texture>
      </control>
      <control type="image">
        <left>0</left><top>0</top><width>580</width><height>765</height>
        <texture colordiffuse="bg">bobi/white.png</texture>
      </control>
      <control type="image">
        <left>0</left><top>400</top><width>1920</width><height>380</height>
        <texture colordiffuse="bg">bobi/scrim-bottom.png</texture>
      </control>
      <control type="image">
        <left>0</left><top>0</top><width>1920</width><height>200</height>
        <texture colordiffuse="bg">bobi/scrim-top.png</texture>
      </control>
      <!-- text column: rows collapse when empty -->
      <control type="grouplist">
        <left>96</left><top>150</top><width>1500</width><height>268</height>
        <orientation>vertical</orientation>
        <itemgap>4</itemgap>
        <usecontrolcoords>true</usecontrolcoords>
        <!-- Chinese title -->
        <control type="label">
          <width>1500</width><height>96</height>
          <label>$VAR[StageTitlePrimary]</label>
          <font>Display72</font><textcolor>text</textcolor><shadowcolor>80000000</shadowcolor>
          <aligny>center</aligny>
        </control>
        <!-- English / original title -->
        <control type="label" id="9611">
          <left>2</left><width>1200</width><height>38</height>
          <label>$VAR[StageTitleSecondary]</label>
          <font>Label28</font><textcolor>text2</textcolor><aligny>center</aligny>
          <visible>!String.IsEmpty(Control.GetLabel(9611))</visible>
        </control>
        <control type="image">
          <width>10</width><height>10</height><texture />
        </control>
        <!-- season · episode chips, then meta -->
        <control type="grouplist" id="9612">
          <left>2</left><width>1400</width><height>44</height>
          <orientation>horizontal</orientation><itemgap>10</itemgap>
          <usecontrolcoords>true</usecontrolcoords>
          <include content="StageChip"><param name="id">9621</param><param name="label">$VAR[StageSeasonLabel]</param></include>
          <include content="StageChip"><param name="id">9622</param><param name="label">$VAR[StageEpisodeLabel]</param></include>
          <control type="button" id="9623">
            <width>auto</width><height>44</height>
            <label>$VAR[StageProgress]</label>
            <font>Button24</font><textcolor>on_focus</textcolor><disabledcolor>on_focus</disabledcolor>
            <textoffsetx>18</textoffsetx><align>center</align><aligny>center</aligny>
            <texturenofocus colordiffuse="accent" border="12">bobi/r10.png</texturenofocus>
            <texturefocus colordiffuse="accent" border="12">bobi/r10.png</texturefocus>
            <enable>false</enable>
            <visible>!String.IsEmpty(Control.GetLabel(9623))</visible>
          </control>
          <control type="image"><width>6</width><height>44</height><texture /></control>
          <control type="label" id="9624">
            <width>auto</width><height>44</height>
            <label>$VAR[StageMeta]</label>
            <font>Label28</font><textcolor>text</textcolor><aligny>center</aligny>
          </control>
        </control>
        <!-- episode title, when it is an episode -->
        <control type="label" id="9613">
          <left>2</left><width>1200</width><height>40</height>
          <label>$VAR[StageEpisodeTitle]</label>
          <font>Label28</font><textcolor>text</textcolor><aligny>center</aligny>
          <visible>!String.IsEmpty(Control.GetLabel(9613))</visible>
        </control>
      </control>
      <control type="textbox">
        <left>98</left><top>426</top><width>860</width><height>92</height>
        <label>$VAR[StagePlot]</label>
        <font>Body26</font><textcolor>text2</textcolor>
        <autoscroll>false</autoscroll>
      </control>
    </control>
  </include>
</includes>
