<?xml version='1.0' encoding='utf-8'?>
<timers>
  <!-- auto-hide the OSD after 5 s without input when the skin setting is on -->
  <timer>
    <name>osd_autoclose</name>
    <start reset="true">Window.IsActive(videoosd) + Window.IsTopMost(videoosd) + Skin.HasSetting(OSDAutoClose)</start>
    <reset>Window.IsActive(videoosd) + [!Window.IsTopMost(videoosd) | !System.IdleTime(1)]</reset>
    <stop>!Window.IsActive(videoosd) | !Skin.HasSetting(OSDAutoClose) | Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(osd_autoclose),5)</stop>
    <onstop condition="Window.IsActive(videoosd) + Window.IsTopMost(videoosd) + Skin.HasSetting(OSDAutoClose) + System.IdleTime(5)">Dialog.Close(videoosd)</onstop>
  </timer>
  <!-- Kodi can restore a movie-only pill while entering the TV directory.
       Recover only when the settled topmost directory actually has no focus. -->
  <timer>
    <name>bobbi_directory_focus</name>
    <start>Window.IsTopMost(videos) + !System.HasModalDialog + !Container.IsUpdating + String.IsEmpty(System.CurrentControlID) + Control.IsVisible(9701)</start>
    <stop>!Window.IsTopMost(videos) | !String.IsEmpty(System.CurrentControlID)</stop>
    <onstart condition="Control.IsVisible(50) + Integer.IsGreater(Container(50).NumItems,0)">SetFocus(50)</onstart>
    <onstart condition="!Control.IsVisible(50) | !Integer.IsGreater(Container(50).NumItems,0)">SetFocus(9701)</onstart>
  </timer>
  <!-- original auto-SDR behaviour; the inverted setting name is kept so saved values still apply -->
  <timer>
    <name>autovideosdr</name>
    <start>Player.Playing + !Skin.HasSetting(autovideotosdr) + String.IsEmpty(System.SupportedHDRTypes) + !String.Contains(Player.Process(video.source.hdr.type),SDR) + [!String.IsEmpty(Player.Process(amlogic.vs10.mode)) | String.IsEqual(Window(Home).Property(Bobbi.Host.SupportsVS10),true)]</start>
    <stop>!String.Contains(Player.Process(video.source.hdr.type),SDR) + Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(autovideosdr), 1)</stop>
    <onstop>Action(vs10.sdr)</onstop>
  </timer>
</timers>
