<?xml version='1.0' encoding='utf-8'?>
<window>
  <zorder>4</zorder>
  <coordinates><left>660</left><top>48</top></coordinates>
  <animation effect="fade" start="0" end="100" time="120">WindowOpen</animation>
  <animation effect="fade" start="100" end="0" time="200" delay="200">WindowClose</animation>
  <controls>
    <control type="image">
      <left>0</left><top>0</top><width>600</width><height>80</height>
      <texture colordiffuse="F21E2128" border="40">bobi/pill.png</texture>
    </control>
    <control type="image">
      <left>28</left><top>22</top><width>36</width><height>36</height>
      <texture colordiffuse="text">bobi/icons/audio.png</texture>
      <visible>!Player.Muted</visible>
    </control>
    <control type="image">
      <left>28</left><top>22</top><width>36</width><height>36</height>
      <texture colordiffuse="error">bobi/icons/close.png</texture>
      <visible>Player.Muted</visible>
    </control>
    <control type="progress">
      <left>88</left><top>36</top><width>400</width><height>8</height>
      <info>Player.Volume</info>
      <texturebg colordiffuse="33FFFFFF" border="4,0,4,0">bobi/bar8.png</texturebg>
      <midtexture colordiffuse="accent" border="4,0,4,0">bobi/bar8.png</midtexture>
      <visible>!Player.Muted</visible>
    </control>
    <control type="label">
      <left>88</left><top>0</top><width>400</width><height>80</height>
      <label>已静音</label>
      <font>Label28</font><textcolor>text</textcolor><aligny>center</aligny>
      <visible>Player.Muted</visible>
    </control>
    <control type="label">
      <left>500</left><top>0</top><width>76</width><height>80</height>
      <label>$INFO[Player.Volume]</label>
      <font>Label24</font><textcolor>text2</textcolor><align>right</align><aligny>center</aligny>
      <visible>!Player.Muted</visible>
    </control>
  </controls>
</window>