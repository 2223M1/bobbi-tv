      </control>
      <control type="grouplist" id="9000">
        <left>48</left><top>308</top><width>664</width><height>66</height>
        <orientation>horizontal</orientation>
        <align>center</align>
        <itemgap>14</itemgap>
        <onup>noop</onup><ondown>noop</ondown>
        <include content="DialogButton"><param name="id">11</param><param name="width">208</param></include>
        <include content="DialogButton"><param name="id">10</param><param name="width">208</param></include>
        <include content="DialogButton"><param name="id">12</param><param name="width">208</param></include>
