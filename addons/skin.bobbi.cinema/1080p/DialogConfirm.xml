      <control type="image">
        <left>-48</left><top>-48</top><width>856</width><height>516</height>
        <texture border="64">bobbi/glass/modal-shadow.png</texture>
      </control>
      <control type="image">
        <left>0</left><top>0</top><width>760</width><height>420</height>
        <texture colordiffuse="$VAR[BobbiMattePanelColor]" border="46">bobbi/glass/modal-glass.png</texture>
      </control>
      <control type="image">
        <left>0</left><top>0</top><width>760</width><height>420</height>
        <texture colordiffuse="glass_rim" border="46">bobbi/glass/modal-glass-rim.png</texture>
      </control>
      <control type="label" id="1">
        <left>48</left><top>40</top><width>664</width><height>48</height>
