<?xml version='1.0' encoding='utf-8'?>
<window id="1197">
  <defaultcontrol always="false">9100</defaultcontrol>
  <onload>SetProperty(BobiSection,mine,Home)</onload>
  <include>PageOpen</include>
  <controls>
    <include>Canvas</include>
    <control type="group">
      <left>96</left><top>136</top>
      <control type="label">
        <left>0</left><top>0</top><width>1200</width><height>64</height>
        <label>我的</label>
        <font>Display56</font><textcolor>text</textcolor><aligny>center</aligny>
      </control>
      <control type="label">
        <left>2</left><top>70</top><width>1600</width><height>36</height>
        <label>自己的片库、播放记录与影院设置</label>
        <font>Meta24</font><textcolor>text3</textcolor><aligny>center</aligny>
      </control>
    </control>

    <!-- left: one list of destinations. Rows: icon, name, one-line description, chevron. -->
    <control type="list" id="9100">
      <left>96</left><top>270</top><width>880</width><height>600</height>
      <orientation>vertical</orientation>
      <scrolltime tween="cubic" easing="out">180</scrolltime>
      <onup>9701</onup>
      <onleft>noop</onleft>
      <onright condition="Integer.IsGreater(Container(9130).NumItems,0)">9110</onright>
      <onright condition="!Integer.IsGreater(Container(9130).NumItems,0)">9101</onright>
      <itemlayout width="880" height="96">
        <control type="group"><left>0</left><top>4</top><include content="HubRow" /></control>
      </itemlayout>
      <focusedlayout width="880" height="96">
        <control type="group"><left>0</left><top>4</top><include content="HubRow"><param name="focused">Control.HasFocus(9100)</param></include></control>
      </focusedlayout>
      <content>
        <item>
          <label>网盘与 NAS</label>
          <label2>浏览自己的 SMB、NFS、WebDAV 与本机目录</label2>
          <icon>bobi/icons/server.png</icon>
          <onclick>ActivateWindow(Videos,"plugin://plugin.video.bobbi.library/",return)</onclick>
        </item>
        <item>
          <label>添加或管理来源</label>
          <label2>新增、修改、移除连接；不会删除网盘与 NAS 上的文件</label2>
          <icon>bobi/icons/plus.png</icon>
          <onclick>RunScript(script.bobbi.setup,libraries)</onclick>
        </item>
        <item>
          <label>片库索引</label>
          <label2>已扫描的作品与本地文件，选中后再挑片源播放</label2>
          <icon>bobi/icons/grid.png</icon>
          <onclick>ActivateWindow(Videos,"plugin://plugin.video.bobbi/?action=bobi_library&amp;section=all",return)</onclick>
        </item>
        <item>
          <label>继续观看</label>
          <label2>有进度但还没看完的影片与剧集</label2>
          <icon>bobi/icons/history.png</icon>
          <onclick>ActivateWindow(Videos,"plugin://plugin.video.bobbi/?action=continue_watching_menu",return)</onclick>
        </item>
        <item>
          <label>观看历史</label>
          <label2>最近播放过的片名，可直接重新选源</label2>
          <icon>bobi/icons/clock.png</icon>
          <onclick>ActivateWindow(Videos,"plugin://plugin.video.bobbi/?action=files_history",return)</onclick>
        </item>
        <item>
          <label>我的收藏</label>
          <label2>收藏夹里的影片、剧集与插件</label2>
          <icon>bobi/icons/heart.png</icon>
          <onclick>ActivateWindow(favouritesbrowser)</onclick>
        </item>
      </content>
    </control>

    <!-- right: what you were watching (from the 继续观看 list in the hidden container), then
         the housekeeping destinations below it -->
    <control type="list" id="9130">
      <left>-4000</left><top>-4000</top><width>1</width><height>1</height>
      <orientation>vertical</orientation>
      <itemlayout width="1" height="1" />
      <focusedlayout width="1" height="1" />
      <content target="videos" limit="1" browse="never">plugin://plugin.video.bobbi/?action=continue_watching_menu</content>
    </control>
    <control type="group">
      <left>1010</left><top>270</top>
      <control type="image">
        <left>0</left><top>0</top><width>814</width><height>352</height>
        <texture colordiffuse="surface" border="20">bobi/r20.png</texture>
      </control>
      <control type="label">
        <left>32</left><top>26</top><width>750</width><height>36</height>
        <label>[COLOR accent_text]接着看[/COLOR]</label>
        <font>Label24</font><textcolor>text</textcolor><aligny>center</aligny>
      </control>
      <visible>Integer.IsGreater(Container(9130).NumItems,0)</visible>
      <!-- thumbnail -->
      <control type="image">
        <left>32</left><top>78</top><width>400</width><height>225</height>
        <texture colordiffuse="surface_hi" border="14">bobi/r14.png</texture>
      </control>
      <control type="image">
        <left>32</left><top>78</top><width>400</width><height>225</height>
        <aspectratio scalediffuse="false">scale</aspectratio>
        <texture background="true" diffuse="bobi/mask-400x225.png">$VAR[HubResumeArt]</texture>
        <include>ArtFade</include>
      </control>
      <!-- title + episode + progress on the right of the thumbnail -->
      <control type="label">
        <left>456</left><top>78</top><width>326</width><height>80</height>
        <label>$VAR[HubResumeTitle]</label>
        <font>Head30</font><textcolor>text</textcolor>
        <wrapmultiline>true</wrapmultiline>
      </control>
      <control type="label">
        <left>456</left><top>164</top><width>326</width><height>36</height>
        <label>$VAR[HubResumeSubline]</label>
        <font>Meta22</font><textcolor>text3</textcolor><aligny>center</aligny>
      </control>
      <control type="progress">
        <left>456</left><top>208</top><width>326</width><height>8</height>
        <info>Container(9130).ListItem.Property(PercentPlayed)</info>
        <texturebg colordiffuse="40FFFFFF" border="4,0,4,0">bobi/bar8.png</texturebg>
        <midtexture colordiffuse="accent" border="4,0,4,0">bobi/bar8.png</midtexture>
        <visible>Integer.IsGreater(Container(9130).ListItem.Property(PercentPlayed),0)</visible>
      </control>
      <control type="label">
        <left>456</left><top>226</top><width>326</width><height>32</height>
        <label>已看 $INFO[Container(9130).ListItem.Property(PercentPlayed)]%   ·   按 确认 继续</label>
        <font>Meta22</font><textcolor>accent_text</textcolor><aligny>center</aligny>
        <visible>Integer.IsGreater(Container(9130).ListItem.Property(PercentPlayed),0)</visible>
      </control>
      <!-- whole card is the resume button -->
      <control type="button" id="9110">
        <left>0</left><top>0</top><width>814</width><height>352</height>
        <label />
        <texturefocus colordiffuse="14FFFFFF" border="20">bobi/r20.png</texturefocus>
        <texturenofocus />
        <onup>9701</onup>
        <ondown>9101</ondown>
        <onleft>9100</onleft>
        <onright>noop</onright>
        <onclick>ActivateWindow(Videos,"plugin://plugin.video.bobbi/?action=continue_watching_menu",return)</onclick>
      </control>
    </control>
    <control type="group">
      <left>1010</left><top>270</top>
      <control type="image">
        <left>0</left><top>0</top><width>814</width><height>352</height>
        <texture colordiffuse="surface" border="20">bobi/r20.png</texture>
      </control>
      <control type="label">
        <left>32</left><top>120</top><width>750</width><height>48</height>
        <label>还没有在看的影片</label>
        <font>Head34</font><textcolor>text</textcolor><aligny>center</aligny>
      </control>
      <control type="label">
        <left>32</left><top>176</top><width>750</width><height>64</height>
        <label>从「网盘与 NAS」或首页片单选一部开始；进度会留在这里。</label>
        <font>Body26</font><textcolor>text3</textcolor><aligny>center</aligny>
        <wrapmultiline>true</wrapmultiline>
      </control>
      <visible>!Integer.IsGreater(Container(9130).NumItems,0)</visible>
    </control>

    <control type="list" id="9101">
      <left>1010</left><top>642</top><width>814</width><height>360</height>
      <orientation>vertical</orientation>
      <scrolltime tween="cubic" easing="out">180</scrolltime>
      <onup condition="Integer.IsGreater(Container(9130).NumItems,0)">9110</onup>
      <onup condition="!Integer.IsGreater(Container(9130).NumItems,0)">9701</onup>
      <onleft>9100</onleft>
      <onright>noop</onright>
      <itemlayout width="814" height="72">
        <include content="HubRow"><param name="compact">true</param><param name="w">814</param><param name="h">68</param></include>
      </itemlayout>
      <focusedlayout width="814" height="72">
        <include content="HubRow"><param name="compact">true</param><param name="focused">Control.HasFocus(9101)</param><param name="w">814</param><param name="h">68</param></include>
      </focusedlayout>
      <content>
        <item>
          <label>影院设置</label><label2>登录、后台、原声字幕与更新</label2>
          <icon>bobi/icons/film.png</icon>
          <onclick>RunPlugin(plugin://plugin.video.bobbi/?action=bobbi_setup)</onclick>
        </item>
        <item>
          <label>波比TV 外观</label><label2>动效、控制栏、HDR 转换</label2>
          <icon>bobi/icons/sparkle.png</icon>
          <onclick>ActivateWindow(SkinSettings)</onclick>
        </item>
        <item>
          <label>系统信息</label><label2>版本、存储、网络与硬件</label2>
          <icon>bobi/icons/info.png</icon>
          <onclick>ActivateWindow(SystemInfo)</onclick>
        </item>
        <item>
          <label>文件管理</label><label2>查看本机与网络路径</label2>
          <icon>bobi/icons/folder.png</icon>
          <onclick>ActivateWindow(FileManager)</onclick>
        </item>
        <item>
          <label>关机 / 重启</label><label2>关闭电源、重新启动或切换用户</label2>
          <icon>bobi/icons/power.png</icon>
          <onclick>ActivateWindow(shutdownmenu)</onclick>
        </item>
      </content>
    </control>

    <include content="KeyHint">
      <param name="label">确认 进入   ·   返回 首页</param>
      <param name="y">1012</param>
    </include>
    <include content="TopBar">
      <param name="down" value="9100" />
      <param name="current" value="mine" />
    </include>
  </controls>
</window>
