<?xml version='1.0' encoding='utf-8'?>
<window>
  <defaultcontrol always="true">60</defaultcontrol>
  <depth>DepthDialog</depth>
  <controls>
    <include>DialogScrim</include>
    <control type="group">
      <centerleft>50%</centerleft><centertop>50%</centertop>
      <width>1440</width><height>880</height>
      <include content="PanelOpen"><param name="slide">0,16</param></include>
      <control type="image">
        <left>-48</left><top>-48</top><width>1536</width><height>976</height>
        <texture border="64">bobbi/glass/modal-shadow.png</texture>
      </control>
      <control type="image">
        <left>0</left><top>0</top><width>1440</width><height>880</height>
        <texture colordiffuse="$VAR[BobbiMattePanelColor]" border="46">bobbi/glass/modal-glass.png</texture>
      </control>
      <control type="image">
        <left>0</left><top>0</top><width>1440</width><height>880</height>
        <texture colordiffuse="FFFFFFFF" border="46">bobbi/glass/modal-glass-rim.png</texture>
      </control>
      <control type="label" id="1">
        <left>64</left><top>44</top><width>1312</width><height>52</height>
        <font>Head34</font><textcolor>FFF5F5F7</textcolor><aligny>center</aligny>
      </control>
      <control type="textbox" id="5">
        <left>64</left><top>124</top><width>1280</width><height>652</height>
        <font>Plot26</font><textcolor>D9EBEBF5</textcolor>
        <pagecontrol>60</pagecontrol>
      </control>
      <control type="scrollbar" id="60">
        <left>1368</left><top>128</top><width>4</width><height>644</height>
        <orientation>vertical</orientation><showonepage>true</showonepage>
        <texturesliderbackground colordiffuse="1AFFFFFF">bobbi/white.png</texturesliderbackground>
        <texturesliderbar colordiffuse="66FFFFFF">bobbi/white.png</texturesliderbar>
        <texturesliderbarfocus colordiffuse="FFFFFFFF">bobbi/white.png</texturesliderbarfocus>
        <onleft>9001</onleft><onright>9001</onright>
      </control>
      <control type="button" id="9001">
        <left>64</left><top>794</top><width>196</width><height>60</height>
        <label>关闭</label><font>Button24</font>
        <textcolor>FFF5F5F7</textcolor><focusedcolor>FF1D1D1F</focusedcolor>
        <align>center</align><aligny>center</aligny>
        <texturefocus colordiffuse="FFFFFFFF" border="30,0,30,0">bobbi/glass/capsule-60.png</texturefocus>
        <texturenofocus colordiffuse="24FFFFFF" border="30,0,30,0">bobbi/glass/capsule-60.png</texturenofocus>
        <onclick>Close</onclick>
        <onup>60</onup><onleft>60</onleft><onright>60</onright><ondown>60</ondown>
      </control>
      <control type="image">
        <left>64</left><top>794</top><width>196</width><height>60</height>
        <texture border="30,0,30,0">bobbi/glass/capsule-60-rim.png</texture>
        <visible>!Control.HasFocus(9001)</visible>
      </control>
      <control type="label">
        <left>276</left><top>804</top><width>1100</width><height>40</height>
        <label>↑↓ 翻页   ·   返回 关闭</label>
        <font>CardSub22</font><textcolor>$VAR[BobbiPanelCaption]</textcolor><align>right</align><aligny>center</aligny>
      </control>
    </control>
  </controls>
</window>
