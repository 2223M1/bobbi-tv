<?xml version='1.0' encoding='utf-8'?>
<window>
  <defaultcontrol always="true">9000</defaultcontrol>
  <include>PageOpen</include>
  <controls>
    <include>Canvas</include>
    <control type="image">
      <left>0</left><top>0</top><width>1920</width><height>1080</height>
      <texture>bobbi/glass/settings-bg.png</texture>
    </control>

    <!-- Top-Centered on-device Settings Title (matching sref_5_0.jpg) -->
    <control type="label">
      <left>360</left><top>48</top><width>1200</width><height>64</height>
      <label>$LOCALIZE[13200]</label>
      <font>SettingsTitle50</font><textcolor>FF7C8088</textcolor>
      <align>center</align><aligny>center</aligny>
    </control>

    <!-- Left Category Column (id=9000) + Active Profile Emblem -->
    <control type="list" id="9000">
      <left>120</left><top>172</top><width>420</width><height>180</height>
      <onleft>9010</onleft><onright>9010</onright>
      <onup>9000</onup><ondown>9000</ondown>
      <include>ListMotion</include>
      <itemlayout height="78" width="420">
        <control type="image">
          <top>4</top><width>420</width><height>66</height>
          <texture colordiffuse="1CFFFFFF" border="33,0,33,0">bobbi/glass/capsule-66.png</texture>
        </control>
        <control type="label">
          <left>32</left><top>4</top><width>356</width><height>66</height>
          <font>Label28</font><textcolor>D9EBEBF5</textcolor><aligny>center</aligny>
          <label>$INFO[ListItem.Label]</label>
        </control>
      </itemlayout>
      <focusedlayout height="78" width="420">
        <control type="image">
          <top>4</top><width>420</width><height>66</height>
          <visible>!Control.HasFocus(9000)</visible>
          <texture colordiffuse="2CFFFFFF" border="33,0,33,0">bobbi/glass/capsule-66.png</texture>
        </control>
        <control type="image">
          <top>4</top><width>420</width><height>66</height>
          <visible>Control.HasFocus(9000)</visible>
          <texture colordiffuse="FFFFFFFF" border="33,0,33,0">bobbi/glass/capsule-66.png</texture>
        </control>
        <control type="label">
          <left>32</left><top>4</top><width>356</width><height>66</height>
          <visible>!Control.HasFocus(9000)</visible>
          <font>Label28</font><textcolor>FFFFFFFF</textcolor><aligny>center</aligny>
          <label>$INFO[ListItem.Label]</label>
        </control>
        <control type="label">
          <left>32</left><top>4</top><width>356</width><height>66</height>
          <visible>Control.HasFocus(9000)</visible>
          <font>Label28</font><textcolor>FF1D1D1F</textcolor><aligny>center</aligny>
          <label>$INFO[ListItem.Label]</label>
        </control>
      </focusedlayout>
      <content>
        <item id="1">
          <label>31420</label>
          <icon />
        </item>
        <item id="2">
          <label>13200</label>
          <icon />
        </item>
      </content>
    </control>

    <control type="group">
      <visible>Container(9000).HasFocus(2)</visible>
      <left>120</left><top>388</top><width>420</width><height>480</height>
      <control type="image">
        <width>420</width><height>460</height>
        <texture colordiffuse="18FFFFFF" border="36">bobbi/glass/squircle-r14.png</texture>
      </control>
      <control type="image">
        <width>420</width><height>460</height>
        <texture border="36">bobbi/glass/squircle-r14-rim.png</texture>
      </control>
      <control type="image">
        <left>134</left><top>48</top><width>152</width><height>152</height>
        <aspectratio scalediffuse="false">scale</aspectratio>
        <texture fallback="bobbi/glass/avatar-disc.png" diffuse="bobbi/glass/cast-mask-152.png">$INFO[Container(2).ListItem.Icon]</texture>
      </control>
      <control type="image">
        <left>134</left><top>48</top><width>152</width><height>152</height>
        <texture>bobbi/glass/cast-rim-152.png</texture>
      </control>
      <control type="label">
        <left>28</left><top>228</top><width>364</width><height>30</height>
        <font>SettingsSubhead25</font><textcolor>FF80848D</textcolor>
        <align>center</align><aligny>center</aligny>
        <label>$LOCALIZE[31319]</label>
      </control>
      <control type="label">
        <left>28</left><top>264</top><width>364</width><height>40</height>
        <font>Head30</font><textcolor>FFFFFFFF</textcolor>
        <align>center</align><aligny>center</aligny>
        <label>$INFO[Container(2).ListItem.Label]</label>
      </control>
      <control type="label">
        <left>28</left><top>328</top><width>364</width><height>30</height>
        <font>SettingsSubhead25</font><textcolor>FF80848D</textcolor>
        <align>center</align><aligny>center</aligny>
        <label>$LOCALIZE[31320]</label>
      </control>
      <control type="label">
        <left>28</left><top>364</top><width>364</width><height>36</height>
        <font>Card26</font><textcolor>9CEBEBF5</textcolor>
        <align>center</align><aligny>center</aligny>
        <label fallback="13170">$INFO[Container(2).ListItem.Label2]</label>
      </control>
    </control>

    <!-- Right Settings Pane (id=9010: 9001 -> 4, 5; 2 -> 60) -->
    <control type="group" id="9010">
      <control type="grouplist" id="9001">
        <visible>Container(9000).HasFocus(1)</visible>
        <left>640</left><top>176</top><width>1120</width><height>320</height>
        <itemgap>14</itemgap>
        <onleft>9000</onleft><onright>9000</onright>
        <onup>9001</onup><ondown>9001</ondown>
        <control type="radiobutton" id="4">
          <width>1120</width><height>66</height>
          <font>Label28</font><label>20096</label>
          <textcolor>FFF5F5F7</textcolor><focusedcolor>FF1D1D1F</focusedcolor>
          <textoffsetx>32</textoffsetx><aligny>center</aligny>
          <texturefocus colordiffuse="FFFFFFFF" border="33,0,33,0">bobbi/glass/capsule-66.png</texturefocus>
          <texturenofocus colordiffuse="22FFFFFF" border="33,0,33,0">bobbi/glass/capsule-66.png</texturenofocus>
          <radioposx>1024</radioposx><radiowidth>64</radiowidth><radioheight>36</radioheight>
          <textureradioonfocus>bobbi/glass/switch-on-focus.png</textureradioonfocus>
          <textureradioonnofocus>bobbi/glass/switch-on.png</textureradioonnofocus>
          <textureradioofffocus>bobbi/glass/switch-off-focus.png</textureradioofffocus>
          <textureradiooffnofocus>bobbi/glass/switch-off.png</textureradiooffnofocus>
        </control>
        <control type="button" id="5">
          <width>1120</width><height>66</height>
          <font>Label28</font><label>33084</label>
          <label2>$INFO[System.ProfileAutoLogin]</label2>
          <textcolor>FFF5F5F7</textcolor><focusedcolor>FF1D1D1F</focusedcolor><disabledcolor>text_disabled</disabledcolor>
          <textoffsetx>32</textoffsetx><aligny>center</aligny>
          <texturefocus colordiffuse="FFFFFFFF" border="33,0,33,0">bobbi/glass/capsule-66.png</texturefocus>
          <texturenofocus colordiffuse="22FFFFFF" border="33,0,33,0">bobbi/glass/capsule-66.png</texturenofocus>
          <enable>!System.HasLoginScreen</enable>
        </control>
      </control>

      <control type="group">
        <visible>Container(9000).HasFocus(1)</visible>
        <left>656</left><top>360</top><width>1088</width><height>160</height>
        <control type="textbox">
          <width>1088</width><height>140</height>
          <font>Plot26</font><textcolor>9CEBEBF5</textcolor>
          <label>$LOCALIZE[31422]</label>
          <visible>Control.HasFocus(4)</visible>
        </control>
        <control type="textbox">
          <width>1088</width><height>140</height>
          <font>Plot26</font><textcolor>9CEBEBF5</textcolor>
          <label>$LOCALIZE[31423]</label>
          <visible>Control.HasFocus(5)</visible>
        </control>
      </control>

      <control type="panel" id="2">
        <visible>Container(9000).HasFocus(2)</visible>
        <left>624</left><top>168</top><width>1152</width><height>816</height>
        <onleft>9000</onleft><onright>60</onright>
        <onup>2</onup><ondown>2</ondown>
        <viewtype label="21371">list</viewtype>
        <pagecontrol>60</pagecontrol>
        <include>ListMotion</include>
        <itemlayout height="272" width="288">
          <control type="group">
            <left>14</left><top>12</top>
            <control type="image">
              <width>260</width><height>248</height>
              <texture colordiffuse="1CFFFFFF" border="36">bobbi/glass/squircle-r14.png</texture>
            </control>
            <control type="image">
              <width>260</width><height>248</height>
              <texture border="36">bobbi/glass/squircle-r14-rim.png</texture>
            </control>
            <control type="image">
              <left>66</left><top>28</top><width>128</width><height>128</height>
              <aspectratio scalediffuse="false">scale</aspectratio>
              <texture fallback="bobbi/glass/avatar-disc.png" diffuse="bobbi/glass/cast-mask-152.png">$INFO[ListItem.Icon]</texture>
            </control>
            <control type="label">
              <left>16</left><top>180</top><width>228</width><height>40</height>
              <font>Card26</font><textcolor>FFF5F5F7</textcolor><selectedcolor>ok</selectedcolor>
              <align>center</align><aligny>center</aligny>
              <info>ListItem.Label</info>
            </control>
          </control>
        </itemlayout>
        <focusedlayout height="272" width="288">
          <control type="group">
            <left>14</left><top>12</top>
            <include content="Lift"><param name="center">130,124</param><param name="zoom">104</param></include>
            <control type="image">
              <width>260</width><height>248</height>
              <visible>!Control.HasFocus(2)</visible>
              <texture colordiffuse="1CFFFFFF" border="36">bobbi/glass/squircle-r14.png</texture>
            </control>
            <control type="image">
              <width>260</width><height>248</height>
              <visible>Control.HasFocus(2)</visible>
              <texture colordiffuse="FFFFFFFF" border="36">bobbi/glass/squircle-r14.png</texture>
            </control>
            <control type="image">
              <left>66</left><top>28</top><width>128</width><height>128</height>
              <aspectratio scalediffuse="false">scale</aspectratio>
              <texture fallback="bobbi/glass/avatar-disc.png" diffuse="bobbi/glass/cast-mask-152.png">$INFO[ListItem.Icon]</texture>
            </control>
            <control type="label">
              <left>16</left><top>180</top><width>228</width><height>40</height>
              <visible>!Control.HasFocus(2)</visible>
              <font>Card26</font><textcolor>FFF5F5F7</textcolor><selectedcolor>ok</selectedcolor>
              <align>center</align><aligny>center</aligny>
              <info>ListItem.Label</info>
            </control>
            <control type="label">
              <left>16</left><top>180</top><width>228</width><height>40</height>
              <visible>Control.HasFocus(2)</visible>
              <font>Card26</font><textcolor>FF1D1D1F</textcolor><selectedcolor>ok</selectedcolor>
              <align>center</align><aligny>center</aligny>
              <info>ListItem.Label</info>
            </control>
          </control>
        </focusedlayout>
      </control>

      <control type="scrollbar" id="60">
        <left>1792</left><top>180</top><width>6</width><height>792</height>
        <texturesliderbackground colordiffuse="1AFFFFFF">bobbi/white.png</texturesliderbackground>
        <texturesliderbar colordiffuse="66FFFFFF">bobbi/white.png</texturesliderbar>
        <texturesliderbarfocus colordiffuse="FFFFFFFF">bobbi/white.png</texturesliderbarfocus>
        <onleft>2</onleft><onright>9000</onright>
        <visible>Container(9000).HasFocus(2)</visible>
        <showonepage>false</showonepage><orientation>vertical</orientation>
      </control>
    </control>
  </controls>
</window>
