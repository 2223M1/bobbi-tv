<?xml version='1.0' encoding='utf-8'?>
<window>
  <defaultcontrol always="false">9000</defaultcontrol>
  <onload>SetProperty(BobbiSection,settings,Home)</onload>
  <include>PageOpen</include>
  <controls>
    <!-- on-device Settings warm-cool charcoal radial backdrop -->
    <control type="image">
      <left>0</left><top>0</top><width>1920</width><height>1080</height>
      <texture>bobbi/glass/settings-bg.png</texture>
    </control>

    <!-- Top-centered muted slate title (cx=960, y=62..124, matching on-device Settings) -->
    <control type="label">
      <left>0</left><top>62</top><width>1920</width><height>62</height>
      <label>设置</label>
      <font>SettingsTitle50</font><textcolor>FF7C8088</textcolor>
      <align>center</align><aligny>center</aligny>
    </control>

    <!-- Left 540x540 continuous-corner (r=120) flat matte emblem @ (255,238) + centered description @ cx=525 -->
    <control type="group">
      <control type="image">
        <left>255</left><top>238</top><width>540</width><height>540</height>
        <texture>bobbi/glass/settings-emblem-540.png</texture>
      </control>
      <control type="image">
        <left>441</left><top>424</top><width>168</width><height>168</height>
        <texture colordiffuse="FF1C1F26" fallback="bobbi/glass/icons/gear.png">$INFO[Container(9000).ListItem.Icon]</texture>
      </control>
      <control type="label">
        <left>125</left><top>832</top><width>800</width><height>36</height>
        <label>$INFO[Container(9000).ListItem.Label2]</label>
        <font>HeroPlot24</font><textcolor>FF989A9F</textcolor>
        <align>center</align><aligny>center</aligny>
      </control>
      <control type="label">
        <left>125</left><top>872</top><width>800</width><height>30</height>
        <label>波比TV $INFO[System.AddonVersion(skin.bobbi.cinema)]   ·   Kodi $INFO[System.BuildVersionShort]</label>
        <font>CardSub22</font><textcolor>FF767880</textcolor>
        <align>center</align><aligny>center</aligny>
      </control>
    </control>

    <!-- Right-column on-device stadium capsule stack @ x=1060..1840 (780x66 pills, 14px gap, 80px pitch) -->
    <control type="list" id="9000">
      <left>1036</left><top>182</top><width>828</width><height>720</height>
      <orientation>vertical</orientation>
      <include>ListMotion</include>
      <onup>9701</onup>
      <ondown>9000</ondown>
      <onleft>9701</onleft>
      <onright>noop</onright>
      <itemlayout width="828" height="80">
        <include content="SettingsStadiumRow" />
      </itemlayout>
      <focusedlayout width="828" height="80">
        <include content="SettingsStadiumRow"><param name="focused" value="true" /></include>
      </focusedlayout>
      <content>
        <item>
          <label>影院</label><label2>片源、字幕、续播与后台准备</label2><icon>bobbi/glass/icons/film.png</icon>
          <onclick>Addon.OpenSettings(plugin.video.bobbi)</onclick>
        </item>
        <item>
          <label>账号与向导</label><label2>网盘账号登录、默认偏好与向导</label2><icon>bobbi/glass/icons/person.png</icon>
          <onclick>RunScript(script.bobbi.setup)</onclick>
        </item>
        <item>
          <label>片库来源</label><label2>添加或修改网盘、NAS 与媒体库连接</label2><icon>bobbi/glass/icons/drive.png</icon>
          <onclick>RunScript(script.bobbi.setup,libraries)</onclick>
        </item>
        <item>
          <label>外观与交互</label><label2>动效、导航栏、液态玻璃与 HDR 转换</label2><icon>bobbi/glass/icons/sliders.png</icon>
          <onclick>ActivateWindow(SkinSettings)</onclick>
        </item>
        <item>
          <label>播放器</label><label2>视频、音频、字幕的默认行为与语言</label2><icon>bobbi/glass/icons/play.png</icon>
          <onclick>ActivateWindow(PlayerSettings)</onclick>
        </item>
        <item>
          <label>找中文字幕</label><label2>播放中手动查找 · OpenSubtitles · 下载后确认加载</label2><icon>bobbi/glass/icons/subtitles.png</icon>
          <onclick>RunScript(script.bobbi.opensubtitles)</onclick>
          <visible>System.HasAddon(script.bobbi.opensubtitles)</visible>
        </item>
        <item>
          <label>媒体</label><label2>媒体库、视频源与刮削</label2><icon>bobbi/glass/icons/stack.png</icon>
          <onclick>ActivateWindow(MediaSettings)</onclick>
        </item>
        <item>
          <label>插件</label><label2>已安装插件、更新与仓库管理</label2><icon>bobbi/glass/icons/sparkles.png</icon>
          <onclick>ActivateWindow(AddonBrowser)</onclick>
        </item>
        <item>
          <label>服务</label><label2>网页遥控、Yatse 连接与局域网共享</label2><icon>bobbi/glass/icons/cloud.png</icon>
          <onclick>ActivateWindow(ServiceSettings)</onclick>
        </item>
        <item>
          <label>界面</label><label2>语言、区域、屏保与皮肤</label2><icon>bobbi/glass/icons/photo.png</icon>
          <onclick>ActivateWindow(InterfaceSettings)</onclick>
        </item>
        <item>
          <label>系统</label><label2>显示分辨率、音频输出、输入设备与电源</label2><icon>bobbi/glass/icons/cpu.png</icon>
          <onclick>ActivateWindow(SystemSettings)</onclick>
        </item>
        <item>
          <label>直播电视</label><label2>频道、节目单与录像</label2><icon>bobbi/glass/icons/tv.png</icon>
          <onclick>ActivateWindow(PVRSettings)</onclick>
        </item>
        <item>
          <label>系统信息</label><label2>版本、存储、网络与硬件诊断</label2><icon>bobbi/glass/icons/info.png</icon>
          <property name="Bobbi.Value">$INFO[System.BuildVersionShort]</property>
          <onclick>ActivateWindow(SystemInfo)</onclick>
        </item>
        <item>
          <label>文件管理</label><label2>浏览与复制本地和网络文件</label2><icon>bobbi/glass/icons/folder.png</icon>
          <onclick>ActivateWindow(FileManager)</onclick>
        </item>
        <item>
          <label>电源</label><label2>重载皮肤、关闭电源或重启到安卓</label2><icon>bobbi/glass/icons/power.png</icon>
          <onclick>ActivateWindow(ShutdownMenu)</onclick>
        </item>
      </content>
    </control>

    <include content="TopBar">
      <param name="down" value="9000" />
      <param name="hide_pill" value="true" />
    </include>
  </controls>
</window>
