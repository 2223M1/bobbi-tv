<?xml version='1.0' encoding='utf-8'?>
<includes>
  <variable name="BobbiMattePanelColor">
    <value condition="!Skin.HasSetting(BobbiLiquidGlassEnabled)">classic_panel</value>
    <value>FF25252C</value>
  </variable>
  <variable name="BobbiSidebarClockColor">
    <value condition="!Skin.HasSetting(BobbiLiquidGlassEnabled)">D4EBEBF5</value>
    <value>8AEBEBF5</value>
  </variable>
  <variable name="BobbiControlSurface">
    <value condition="!Skin.HasSetting(BobbiLiquidGlassEnabled)">classic_control</value>
    <value>surface_hi</value>
  </variable>
  <variable name="BobbiSearchFieldSurface">
    <value condition="!Skin.HasSetting(BobbiLiquidGlassEnabled)">classic_control</value>
    <value>22FFFFFF</value>
  </variable>
  <variable name="BobbiSearchFilterSurface">
    <value condition="!Skin.HasSetting(BobbiLiquidGlassEnabled)">classic_control</value>
    <value>20FFFFFF</value>
  </variable>
  <variable name="BobbiTopIconSurface">
    <value condition="!Skin.HasSetting(BobbiLiquidGlassEnabled)">classic_control</value>
    <value>glass</value>
  </variable>
  <variable name="BobbiSheetScrim">
    <value condition="!Skin.HasSetting(BobbiLiquidGlassEnabled)">classic_scrim</value>
    <value>66000000</value>
  </variable>
  <variable name="BobbiPanelCaption">
    <value condition="!Skin.HasSetting(BobbiLiquidGlassEnabled)">E6EBEBF5</value>
    <value>9CEBEBF5</value>
  </variable>
  <variable name="BobbiPanelHint">
    <value condition="!Skin.HasSetting(BobbiLiquidGlassEnabled)">DCEBEBF5</value>
    <value>73EBEBF5</value>
  </variable>
  <!-- ===== native glass navigation state ===== -->
  <variable name="BobbiSectionLabel">
    <value condition="String.IsEqual(Window(Home).Property(BobbiSection),tv)">电视剧</value>
    <value condition="String.IsEqual(Window(Home).Property(BobbiSection),movie)">电影</value>
    <value condition="String.IsEqual(Window(Home).Property(BobbiSection),anime)">动漫</value>
    <value condition="String.IsEqual(Window(Home).Property(BobbiSection),library)">片库</value>
    <value condition="String.IsEqual(Window(Home).Property(BobbiSection),mine)">我的</value>
    <value condition="String.IsEqual(Window(Home).Property(BobbiSection),settings)">设置</value>
    <value>首页</value>
  </variable>
  <variable name="BobbiSectionIcon">
    <value condition="String.IsEqual(Window(Home).Property(BobbiSection),tv)">bobbi/glass/icons/tv.png</value>
    <value condition="String.IsEqual(Window(Home).Property(BobbiSection),movie)">bobbi/glass/icons/film.png</value>
    <value condition="String.IsEqual(Window(Home).Property(BobbiSection),anime)">bobbi/glass/icons/sparkles.png</value>
    <value condition="String.IsEqual(Window(Home).Property(BobbiSection),library)">bobbi/glass/icons/stack.png</value>
    <value condition="String.IsEqual(Window(Home).Property(BobbiSection),mine)">bobbi/glass/icons/person.png</value>
    <value condition="String.IsEqual(Window(Home).Property(BobbiSection),settings)">bobbi/glass/icons/gear.png</value>
    <value>bobbi/glass/icons/house.png</value>
  </variable>
  <expression name="BobbiSectionWide">String.IsEqual(Window(Home).Property(BobbiSection),tv)</expression>
  <variable name="BobbiTimeAMPM">
    <value condition="String.Contains(System.Time(xx),上) | String.Contains(System.Time(xx),AM) | String.Contains(System.Time(xx),am)">$INFO[System.Time(hh:mm)] AM</value>
    <value>$INFO[System.Time(hh:mm)] PM</value>
  </variable>
  <variable name="PlayStateRing">
    <value condition="Player.Paused">bobbi/glass/pause-ring-28.png</value>
    <value>bobbi/glass/play-ring-28.png</value>
  </variable>
  <variable name="BobbiFileBrowserFocusText">
    <value condition="Control.HasFocus(450) | Control.HasFocus(451)">black</value>
    <value>text</value>
  </variable>
  <expression name="BobbiIMECurrent">!String.IsEmpty(Window(10103).Property(BobbiIME.Ready)) + String.IsEqual(Control.GetLabel(313),Window(10103).Property(BobbiIME.Code)) + String.IsEqual(Control.GetLabel(314),Window(10103).Property(BobbiIME.Page))</expression>
  <!-- Legacy recommendations must distinguish explicit person metadata from movie titles. -->
  <expression name="Exp_IsPersonInfo">String.IsEqual(ListItem.DBType,actor) | String.IsEqual(ListItem.DBType,person) | String.IsEqual(ListItem.Property(item.type),person) | String.IsEqual(ListItem.Property(tmdb_type),person)</expression>
  <!-- A "next page" row from any of our plugins: the explicit flag, the Chinese label, or the
       shared nextpage icon. Such a row gets an arrow tile instead of a blank poster. -->
  <expression name="BobbiIsMore">String.IsEqual(ListItem.Property(Bobbi.NextPage),true) | String.IsEqual(ListItem.Label,下一页) | String.StartsWith(ListItem.Label,Next Page) | String.EndsWith(ListItem.Art(icon),nextpage.png)</expression>
  <!-- user library (网盘 / NAS / 片库) browser -->
  <expression name="BobbiInLibrary">String.StartsWith(Container.FolderPath,plugin://plugin.video.bobbi.library)</expression>
  <expression name="BobbiLibraryRoot">String.IsEqual(Container.FolderPath,plugin://plugin.video.bobbi.library/) | String.Contains(Container.FolderPath,action=root)</expression>
  <expression name="BobbiIsManage">String.Contains(ListItem.FolderPath,action=manage) | String.IsEqual(ListItem.Property(Bobbi.Library.Manage),true)</expression>
  <!-- Library source location. Kodi's file window re-applies its %D label2 mask and clears
       Label2, so the plugin also publishes Bobbi.Library.Location (checked on device, CE2027). -->
  <variable name="BobbiLibraryLocation">
    <value condition="!String.IsEmpty(ListItem.Property(Bobbi.Library.Location))">$INFO[ListItem.Property(Bobbi.Library.Location)]</value>
    <value>$INFO[ListItem.Label2]</value>
  </variable>
  <!-- Plugin action progress does not register native playback context actions. -->
  <variable name="BobbiPercentPlayed">
    <value condition="!String.IsEmpty(ListItem.Property(PercentPlayed))">$INFO[ListItem.Property(PercentPlayed)]</value>
    <value>$INFO[ListItem.PercentPlayed]</value>
  </variable>
  <!-- Kodi legacy Default*.png icon / fallback art guards & retry detection -->
  <expression name="IsKodiDefaultIcon">String.IsEmpty(ListItem.Icon) | String.StartsWith(ListItem.Icon,Default) | String.Contains(ListItem.Icon,DefaultFolder) | String.Contains(ListItem.Icon,DefaultFile) | String.Contains(ListItem.Icon,DefaultHardDisk) | String.Contains(ListItem.Icon,DefaultAddSource) | String.Contains(ListItem.Icon,DefaultAddon) | String.Contains(ListItem.Icon,DefaultVideo) | String.Contains(ListItem.Icon,DefaultPlaylist) | String.Contains(ListItem.Icon,DefaultMusic) | String.Contains(ListItem.Icon,DefaultPicture) | String.Contains(ListItem.Icon,DefaultProgram) | String.Contains(ListItem.Icon,DefaultNetwork) | String.Contains(ListItem.Icon,DefaultIcon)</expression>
  <expression name="BobbiIsRetry">String.Contains(ListItem.Label,加载失败) | String.Contains(ListItem.Label,选择重试)</expression>
  <expression name="BobbiIsCategoryGrid">Container.Content(genres) | Container.Content(years) | Container.Content(studios) | Container.Content(countries) | String.Contains(Container.FolderPath,tmdb_genres) | String.Contains(Container.FolderPath,tmdb_years) | String.Contains(Container.FolderPath,tmdb_networks) | String.Contains(Container.FolderPath,tmdb_lang) | String.Contains(Container.FolderPath,Anime_Genres) | String.Contains(Container.FolderPath,Anime_Years)</expression>

  <!-- native glass native glyph icon mappers replacing Kodi 2009 Default*.png icons -->
  <variable name="ATVMenuRowIcon">
    <value condition="String.Contains(ListItem.Label,播放列表) | String.Contains(ListItem.Icon,Playlist)">bobbi/glass/icons/list-bullet.png</value>
    <value condition="String.Contains(ListItem.Label,插件) | String.Contains(ListItem.Icon,Addon)">bobbi/glass/icons/puzzle.png</value>
    <value condition="String.Contains(ListItem.Label,搜索)">bobbi/glass/icons/search.png</value>
    <value condition="String.Contains(ListItem.Label,设置)">bobbi/glass/icons/gear.png</value>
    <value condition="ListItem.IsFolder">bobbi/glass/icons/folder-outline.png</value>
    <value>bobbi/glass/icons/film-outline.png</value>
  </variable>
  <variable name="ATVAddonIcon">
    <value condition="String.Contains(ListItem.Label,更新) | String.Contains(ListItem.Label,从库安装)">bobbi/glass/icons/download.png</value>
    <value condition="String.Contains(ListItem.Label,zip) | String.Contains(ListItem.Label,ZIP)">bobbi/glass/icons/archive.png</value>
    <value condition="String.Contains(ListItem.Label,搜索)">bobbi/glass/icons/search.png</value>
    <value condition="String.Contains(ListItem.Label,游戏)">bobbi/glass/icons/sparkles.png</value>
    <value>bobbi/glass/icons/puzzle.png</value>
  </variable>
  <variable name="ATVFileIcon">
    <value condition="String.Contains(ListItem.Label,添加源) | String.Contains(ListItem.Icon,AddSource)">bobbi/glass/icons/plus.png</value>
    <value condition="String.Contains(ListItem.Icon,HardDisk) | String.Contains(ListItem.Icon,Network) | String.IsEqual(ListItem.Label,C) | String.IsEqual(ListItem.Label,D) | String.IsEqual(ListItem.Label,E) | String.IsEqual(ListItem.Label,F)">bobbi/glass/icons/drive-outline.png</value>
    <value condition="ListItem.IsFolder | String.Contains(ListItem.Icon,Folder)">bobbi/glass/icons/folder-outline.png</value>
    <value>bobbi/glass/icons/film-outline.png</value>
  </variable>
  <variable name="ATVEventIcon">
    <value condition="String.Contains(ListItem.Property(Event.Description),未能) | String.Contains(ListItem.Property(Event.Description),失败) | String.Contains(ListItem.Property(Event.Description),无法) | String.Contains(ListItem.Property(Event.Description),Error) | String.Contains(ListItem.Property(Event.Description),Failed)">bobbi/glass/icons/exclamation.png</value>
    <value condition="String.Contains(ListItem.Label,Add-on) | String.Contains(ListItem.Label,插件) | String.Contains(ListItem.Label,Client)">bobbi/glass/icons/puzzle.png</value>
    <value>bobbi/glass/icons/info.png</value>
  </variable>

  <!-- art: poster for 2:3 cards, falling back to thumb, never Kodi Default*.png -->
  <variable name="PosterImage">
    <value condition="!String.IsEmpty(ListItem.Art(poster)) + !String.StartsWith(ListItem.Art(poster),Default)">$INFO[ListItem.Art(poster)]</value>
    <value condition="!String.IsEmpty(ListItem.Art(tvshow.poster)) + !String.StartsWith(ListItem.Art(tvshow.poster),Default)">$INFO[ListItem.Art(tvshow.poster)]</value>
    <value condition="!String.IsEmpty(ListItem.Art(season.poster)) + !String.StartsWith(ListItem.Art(season.poster),Default)">$INFO[ListItem.Art(season.poster)]</value>
    <value condition="!String.IsEmpty(ListItem.Art(thumb)) + !String.StartsWith(ListItem.Art(thumb),Default) + !String.Contains(ListItem.Art(thumb),DefaultFolder) + !String.Contains(ListItem.Art(thumb),DefaultAddon) + !String.Contains(ListItem.Art(thumb),DefaultVideo)">$INFO[ListItem.Art(thumb)]</value>
  </variable>
  <variable name="LandscapeImage">
    <value condition="!String.IsEmpty(ListItem.Art(thumb)) + String.IsEqual(ListItem.DBType,episode) + !String.StartsWith(ListItem.Art(thumb),Default)">$INFO[ListItem.Art(thumb)]</value>
    <value condition="!String.IsEmpty(ListItem.Art(landscape)) + !String.StartsWith(ListItem.Art(landscape),Default)">$INFO[ListItem.Art(landscape)]</value>
    <value condition="!String.IsEmpty(ListItem.Art(fanart)) + !String.StartsWith(ListItem.Art(fanart),Default)">$INFO[ListItem.Art(fanart)]</value>
    <value condition="!String.IsEmpty(ListItem.Art(thumb)) + !String.StartsWith(ListItem.Art(thumb),Default) + !String.Contains(ListItem.Art(thumb),DefaultFolder) + !String.Contains(ListItem.Art(thumb),DefaultAddon) + !String.Contains(ListItem.Art(thumb),DefaultVideo)">$INFO[ListItem.Art(thumb)]</value>
  </variable>
  <variable name="FanartImage">
    <value condition="!String.IsEmpty(ListItem.Art(fanart)) + !String.StartsWith(ListItem.Art(fanart),Default)">$INFO[ListItem.Art(fanart)]</value>
    <value condition="!String.IsEmpty(ListItem.Art(tvshow.fanart)) + !String.StartsWith(ListItem.Art(tvshow.fanart),Default)">$INFO[ListItem.Art(tvshow.fanart)]</value>
    <value condition="!String.IsEmpty(ListItem.Art(landscape)) + !String.StartsWith(ListItem.Art(landscape),Default)">$INFO[ListItem.Art(landscape)]</value>
    <value condition="!String.IsEmpty(ListItem.Art(thumb)) + !String.StartsWith(ListItem.Art(thumb),Default) + !String.Contains(ListItem.Art(thumb),DefaultFolder) + !String.Contains(ListItem.Art(thumb),DefaultAddon) + !String.Contains(ListItem.Art(thumb),DefaultVideo) + !String.Contains(ListItem.Art(thumb),nextpage.png)">$INFO[ListItem.Art(thumb)]</value>
  </variable>

  <!-- Chinese title preferred; the cinema publishes AM6B.Title.zh/en/original -->
  <variable name="TitleZH">
    <value condition="!String.IsEmpty(ListItem.Property(AM6B.Title.zh))">$INFO[ListItem.Property(AM6B.Title.zh)]</value>
    <value condition="!String.IsEmpty(ListItem.Title)">$INFO[ListItem.Title]</value>
    <value>$INFO[ListItem.Label]</value>
  </variable>
  <variable name="TitleOriginal">
    <value condition="!String.IsEmpty(ListItem.Property(AM6B.Title.original)) + !String.IsEqual(ListItem.Property(AM6B.Title.original),ListItem.Label)">$INFO[ListItem.Property(AM6B.Title.original)]</value>
    <value condition="!String.IsEmpty(ListItem.Property(AM6B.Title.en)) + !String.IsEqual(ListItem.Property(AM6B.Title.en),ListItem.Label)">$INFO[ListItem.Property(AM6B.Title.en)]</value>
    <value condition="!String.IsEmpty(ListItem.OriginalTitle) + !String.IsEqual(ListItem.OriginalTitle,ListItem.Title)">$INFO[ListItem.OriginalTitle]</value>
  </variable>

  <!-- source picker quality badge (read from the cinema's source list) -->
  <variable name="BobbiQualityBadge">
    <value condition="String.IsEqual(ListItem.Property(quality_plain),未知) | String.IsEqual(ListItem.Property(quality_plain),n/a) | String.IsEqual(ListItem.Property(quality_plain),N/A) | String.IsEmpty(ListItem.Property(quality_plain))" />
    <value condition="String.Contains(ListItem.Property(quality_plain),2160) | String.IsEqual(ListItem.Property(quality_plain),4k)">4K</value>
    <value>[UPPERCASE]$INFO[ListItem.Property(quality_plain)][/UPPERCASE]</value>
  </variable>

  <variable name="StreamLang">
    <value condition="String.IsEqual(ListItem.Label,chi)">中文</value>
    <value condition="String.IsEqual(ListItem.Label,zho)">中文</value>
    <value condition="String.IsEqual(ListItem.Label,chs)">简体中文</value>
    <value condition="String.IsEqual(ListItem.Label,cht)">繁体中文</value>
    <value condition="String.IsEqual(ListItem.Label,eng)">英语</value>
    <value condition="String.IsEqual(ListItem.Label,jpn)">日语</value>
    <value condition="String.IsEqual(ListItem.Label,kor)">韩语</value>
    <value condition="String.IsEqual(ListItem.Label,fre)">法语</value>
    <value condition="String.IsEqual(ListItem.Label,fra)">法语</value>
    <value condition="String.IsEqual(ListItem.Label,ger)">德语</value>
    <value condition="String.IsEqual(ListItem.Label,deu)">德语</value>
    <value condition="String.IsEqual(ListItem.Label,spa)">西班牙语</value>
    <value condition="String.IsEqual(ListItem.Label,ita)">意大利语</value>
    <value condition="String.IsEqual(ListItem.Label,rus)">俄语</value>
    <value condition="String.IsEqual(ListItem.Label,tha)">泰语</value>
    <value condition="String.IsEqual(ListItem.Label,por)">葡萄牙语</value>
    <value condition="String.IsEqual(ListItem.Label,und)">未标注</value>
    <value condition="String.IsEqual(ListItem.Label,UND)">未标注</value>
    <value>$INFO[ListItem.Label]</value>
  </variable>
  <variable name="SkinSettingHint">
    <value condition="Control.HasFocus(9105)">默认为左侧可收起液态玻璃侧栏，浏览内容时收起为左上角胶囊。开启后改为顶部居中的玻璃胶囊导航；切换后界面会重新载入。</value>
    <value condition="Control.HasFocus(9106)">默认使用经典外观。开启时会说明本机支持实时折射，还是仅支持玻璃材质。关闭后立即恢复经典外观。</value>
    <value condition="Control.HasFocus(9101)">关闭焦点放大、面板滑入和页面淡入。焦点胶囊、已选状态标记和正在播放标记保持不变。</value>
    <value condition="Control.HasFocus(9102)">播放时控制栏5秒无操作后自动收起；字幕、音轨面板和设置打开时不会收起。</value>
    <value condition="Control.HasFocus(9103)">电视不支持 HDR 时，自动对 HDR、HLG 和杜比视界片源执行 VS10 → SDR 转换。</value>
    <value condition="Control.HasFocus(9104)">仅对配置了“返回确认”键位的遥控器生效。Yatse 与默认键位下，返回键只收起控制栏，停止请用控制栏上的停止键。</value>
  </variable>
  <variable name="SettingsSectionTitle">
    <value condition="Window.IsActive(playersettings)">播放器</value>
    <value condition="Window.IsActive(mediasettings)">媒体</value>
    <value condition="Window.IsActive(pvrsettings)">直播电视</value>
    <value condition="Window.IsActive(servicesettings)">服务</value>
    <value condition="Window.IsActive(interfacesettings)">界面</value>
    <value condition="Window.IsActive(systemsettings)">系统</value>
    <value>设置</value>
  </variable>
  <variable name="SettingsSheetContext">
    <value condition="Player.HasVideo + [Window.IsActive(osdaudiosettings) | Window.IsActive(osdsubtitlesettings) | Window.IsActive(osdvideosettings)]">$VAR[PlayerTitle]   ·   调整立即生效，返回 收起</value>
    <value>↑↓ 选择   ·   ← → 调整   ·   返回 关闭</value>
  </variable>

  <!-- detail page -->
  <variable name="DetailPrimaryLabel">
    <value condition="!String.IsEmpty(ListItem.Property(Bobbi.Catalog.ActionLabel))">$INFO[ListItem.Property(Bobbi.Catalog.ActionLabel)]</value>
    <value condition="ListItem.IsFolder + String.IsEqual(ListItem.DBType,season)">选集</value>
    <value condition="ListItem.IsFolder">选择季集</value>
    <value condition="String.StartsWith(ListItem.FilenameAndPath,plugin://plugin.video.bobbi/) + [Integer.IsGreater(ListItem.Property(PercentPlayed),0) | Integer.IsGreater(ListItem.PercentPlayed,0)]">继续 · 选片源</value>
    <value condition="String.StartsWith(ListItem.FilenameAndPath,plugin://plugin.video.bobbi/)">选择片源</value>
    <value condition="Integer.IsGreater(ListItem.PercentPlayed,0)">继续播放</value>
    <value>播放</value>
  </variable>
  <variable name="DetailPrimaryIcon">
    <value condition="ListItem.IsFolder">bobbi/glass/icons/stack.png</value>
    <value condition="String.StartsWith(ListItem.FilenameAndPath,plugin://plugin.video.bobbi/)">bobbi/glass/icons/play.png</value>
    <value>bobbi/glass/icons/play.png</value>
  </variable>
  <variable name="DetailKicker">
    <value condition="String.IsEqual(ListItem.Property(Bobbi.Catalog.MediaKind),unknown)">原文件</value>
    <value condition="String.IsEqual(ListItem.DBType,movie)">电影</value>
    <value condition="String.IsEqual(ListItem.DBType,tvshow)">剧集</value>
    <value condition="String.IsEqual(ListItem.DBType,season)">剧集 · 季</value>
    <value condition="String.IsEqual(ListItem.DBType,episode)">剧集 · 单集</value>
  </variable>

  <!-- wide-card captions -->
  <variable name="CardTitle">
    <value>$VAR[TitlePrimary]</value>
  </variable>
  <variable name="CardSubline">
    <value condition="!String.IsEmpty(ListItem.Episode)">$VAR[SeasonLabel] · $VAR[EpisodeLabel]</value>
    <value condition="!String.IsEmpty(ListItem.Season)">$VAR[SeasonLabel]$INFO[ListItem.Year,  ·  ]</value>
    <value>$VAR[TitleSecondary]</value>
  </variable>
  <!-- meta line: year · genre · duration · rating -->
  <variable name="MetaLine">
    <value>$INFO[ListItem.Year]$INFO[ListItem.Genre,  ·  ]$INFO[ListItem.Duration(h'小时'mm'分'),  ·  ]$INFO[ListItem.Property(TotalSeasons),  ·  共,季]$INFO[ListItem.Rating,  ·  ★ ]</value>
  </variable>

  <!-- episode identity -->
  <variable name="EpisodeCode">
    <value condition="!String.IsEmpty(ListItem.Season) + !String.IsEmpty(ListItem.Episode)">第$INFO[ListItem.Season]季 · 第$INFO[ListItem.Episode]集</value>
    <value condition="!String.IsEmpty(ListItem.Episode)">第$INFO[ListItem.Episode]集</value>
  </variable>

  <!-- OSD -->
  <variable name="PlayerTitle">
    <value condition="!String.IsEmpty(VideoPlayer.TVShowTitle)">$INFO[VideoPlayer.TVShowTitle]</value>
    <value condition="!String.IsEmpty(VideoPlayer.Title)">$INFO[VideoPlayer.Title]</value>
    <value>$INFO[Player.Filename]</value>
  </variable>
  <variable name="PlayerSubtitle">
    <value condition="!String.IsEmpty(VideoPlayer.TVShowTitle) + !String.IsEmpty(VideoPlayer.Episode)">第$INFO[VideoPlayer.Season]季 第$INFO[VideoPlayer.Episode]集$INFO[VideoPlayer.Title,  ·  ]</value>
    <value condition="!String.IsEmpty(VideoPlayer.OriginalTitle) + !String.IsEqual(VideoPlayer.OriginalTitle,VideoPlayer.Title)">$INFO[VideoPlayer.OriginalTitle]$INFO[VideoPlayer.Year,  ·  ]</value>
    <value>$INFO[VideoPlayer.Year]</value>
  </variable>
  <variable name="HDRLabel">
    <value condition="String.IsEqual(Player.Process(video.source.hdr.type),dolbyvision)">杜比视界</value>
    <value condition="String.IsEqual(Player.Process(video.source.hdr.type),hdr10)">HDR10</value>
    <value condition="String.StartsWith(Player.Process(video.source.hdr.type),hdr10)">HDR10+</value>
    <value condition="String.IsEqual(Player.Process(video.source.hdr.type),hlg)">HLG</value>
    <value condition="!String.IsEmpty(Player.Process(video.source.hdr.type))">$INFO[Player.Process(video.source.hdr.type)]</value>
    <value>SDR</value>
  </variable>
  <variable name="ResolutionLabel">
    <value condition="String.IsEqual(VideoPlayer.VideoResolution,4K)">4K</value>
    <value condition="!String.IsEmpty(VideoPlayer.VideoResolution)">$INFO[VideoPlayer.VideoResolution]P</value>
  </variable>
  <variable name="AudioLabel">
    <value condition="!String.IsEmpty(VideoPlayer.AudioLanguage)">$INFO[VideoPlayer.AudioLanguage]$INFO[VideoPlayer.AudioCodec, · ]$INFO[VideoPlayer.AudioChannels, · ,ch]</value>
    <value>$INFO[VideoPlayer.AudioCodec]$INFO[VideoPlayer.AudioChannels, · ,ch]</value>
  </variable>
  <variable name="TempoLabel">
    <value condition="Player.Paused">已暂停</value>
    <value condition="String.IsEmpty(Player.PlaySpeed) | String.IsEqual(Player.PlaySpeed,1.00) | String.IsEqual(Player.PlaySpeed,1)">1.0×</value>
    <value>$INFO[Player.PlaySpeed]×</value>
  </variable>
  <variable name="TempoModeLabel">
    <value condition="Player.TempoEnabled">播放倍速</value>
    <value>快进 / 快退</value>
  </variable>
  <variable name="TempoNavigationHint">
    <value condition="Player.Paused">已暂停   ·   按确认继续播放后再调速</value>
    <value condition="Player.TempoEnabled">← 减速   ·   → 加速   ·   确认 恢复正常播放</value>
    <value>← 快退   ·   → 快进   ·   确认 恢复正常播放</value>
  </variable>
  <variable name="TempoStatusHint">
    <value condition="Player.TempoEnabled">返回关闭菜单，保留当前速度</value>
    <value>当前播放器不支持有声倍速[CR]快进 / 快退用于定位；返回 完成</value>
  </variable>
  <variable name="VS10Label">
    <value condition="String.IsEqual(Player.Process(video.source.hdr.type.raw),2)">不可用</value>
    <value>片源 $INFO[Player.Process(video.source.hdr.type)]</value>
  </variable>
  <variable name="SeekStateIcon">
    <value condition="Player.Forwarding">bobbi/glass/icons/fastforward.png</value>
