<?xml version='1.0' encoding='utf-8'?>
<window>
  <defaultcontrol always="true">9000</defaultcontrol>
  <depth>DepthDialog</depth>
  <controls>
    <include>DialogScrim</include>
    <control type="group">
      <centerleft>50%</centerleft><centertop>50%</centertop>
      <width>720</width><height>520</height>
      <include content="PanelOpen"><param name="slide">0,16</param></include>
      <control type="image">
        <left>0</left><top>0</top><width>720</width><height>520</height>
        <texture colordiffuse="FF15171C" border="20">bobi/r20.png</texture>
      </control>
      <control type="label">
        <left>48</left><top>36</top><width>624</width><height>56</height>
        <label>电源与系统</label>
        <font>Head40</font><textcolor>text</textcolor><aligny>center</aligny>
      </control>
      <control type="list" id="9000">
        <left>48</left><top>116</top><width>624</width><height>380</height>
        <orientation>vertical</orientation>
        <scrolltime tween="cubic" easing="out">160</scrolltime>
        <onleft>noop</onleft><onright>noop</onright>
        <itemlayout width="624" height="92"><include content="SheetItem"><param name="list">9000</param></include></itemlayout>
        <focusedlayout width="624" height="92"><include content="SheetItem"><param name="list">9000</param><param name="focused">true</param></include></focusedlayout>
        <content>
          <item>
            <label>返回观看界面</label><label2 /><icon>bobi/icons/back.png</icon>
            <onclick>Dialog.Close(shutdownmenu)</onclick>
          </item>
          <item>
            <label>重新载入皮肤</label><label2 /><icon>bobi/icons/refresh.png</icon>
            <onclick>ReloadSkin()</onclick>
          </item>
          <item>
            <label>退出播放器</label><label2 /><icon>bobi/icons/close.png</icon>
            <onclick>Quit()</onclick>
          </item>
          <item>
            <label>重启到安卓系统</label><label2 /><icon>bobi/icons/power.png</icon>
            <onclick>Reset()</onclick>
          </item>
        </content>
      </control>
    </control>
  </controls>
</window>
