<?xml version='1.0' encoding='utf-8'?>
<window type="dialog" id="1145">
  <defaultcontrol always="true">2024</defaultcontrol>
  <depth>DepthOSD</depth>
  <onload>SetProperty(Bobbi.OSD.StreamPanel,$VAR[BobbiNextStreamPanel],Home)</onload>
  <onload condition="String.IsEmpty(Window(Home).Property(Bobbi.OSD.NextStreamPanel)) | String.IsEqual(Window(Home).Property(Bobbi.OSD.StreamPanel),opening)">RunScript(plugin.video.bobbi,bobbi_osd=open_audio_panel)</onload>
  <onload>ClearProperty(Bobbi.OSD.NextStreamPanel,Home)</onload>
  <onunload>ClearProperty(Bobbi.OSD.StreamPanel,Home)</onunload>
  <controls>
    <control type="image">
      <left>0</left><top>0</top><width>1920</width><height>320</height>
      <texture>bobbi/glass/scrim-top.png</texture>
    </control>
    <include content="OSDScrim"><param name="top">520</param></include>
    <include content="StreamPicker">
      <param name="type">audio</param>
      <param name="issub">false</param>
      <param name="title">音轨</param>
      <param name="full">OSDAudioSettings</param>
      <param name="fulllabel">音频设置</param>
      <param name="offlabel" />
      <param name="window">1145</param>
      <param name="apply">set_player_audiostream</param>
    </include>
  </controls>
</window>
