<?xml version='1.0' encoding='utf-8'?>
<window>
  <defaultcontrol always="true">50</defaultcontrol>
  <menucontrol>9999</menucontrol>
  <views>50</views>
  <include>PageOpen</include>
  <controls>
    <!-- Hidden state labels used by script.globalsearch -->
    <control type="label" id="991">
      <left>-2000</left><top>-2000</top><width>10</width><height>1</height>
      <label />
    </control>
    <control type="label" id="999">
      <left>-2000</left><top>-2000</top><width>10</width><height>1</height>
      <label />
    </control>

    <include>Canvas</include>
    <control type="image">
      <left>0</left><top>0</top><width>1920</width><height>1080</height>
      <texture>bobbi/glass/stage-ambient.png</texture>
    </control>

    <!-- Top-left on-device 波比TV glass capsule & top-right AM/PM clock -->
    <control type="group">
      <control type="image">
        <left>29</left><top>68</top><width>20</width><height>24</height>
        <texture colordiffuse="F2F5F5F7">bobbi/glass/icons/chevron-left.png</texture>
      </control>
      <control type="image">
        <left>50</left><top>50</top><width>180</width><height>60</height>
        <texture>bobbi/glass/back-pill-180x60.png</texture>
      </control>
      <control type="image">
        <left>55</left><top>55</top><width>50</width><height>50</height>
        <texture>bobbi/glass/avatar-disc.png</texture>
      </control>
      <control type="label">
        <left>117</left><top>50</top><width>100</width><height>60</height>
        <label>波比TV</label>
        <font>Capsule28</font><textcolor>FFFFFFFF</textcolor><aligny>center</aligny>
      </control>
    </control>
    <include content="GlassCapsule">
      <param name="x">1684</param><param name="y">54</param><param name="w">156</param><param name="h">52</param>
    </include>
    <control type="label">
      <left>1684</left><top>54</top><width>156</width><height>52</height>
      <label>$VAR[BobbiTimeAMPM]</label>
      <font>NavClock20</font><textcolor>D9EBEBF5</textcolor><align>center</align><aligny>center</aligny>
    </control>

    <!-- Header -->
    <control type="group">
      <left>80</left><top>128</top>
      <control type="label">
        <left>0</left><top>0</top><width>1400</width><height>68</height>
        <label>$LOCALIZE[283]</label>
        <font>Hero60</font><textcolor>FFFFFFFF</textcolor><aligny>center</aligny>
      </control>
      <control type="label">
        <left>2</left><top>68</top><width>1400</width><height>32</height>
        <label>$INFO[Window.Property(GlobalSearch.SearchString),搜索关键词：,]</label>
        <font>HeroPlot24</font><textcolor>9CEBEBF5</textcolor><aligny>center</aligny>
      </control>
    </control>

    <!-- Left Category Glass Pane (id=9999 -> 990, 9000) -->
    <control type="group">
      <visible>!Control.IsVisible(999)</visible>
      <control type="image">
        <left>80</left><top>244</top><width>380</width><height>764</height>
        <texture colordiffuse="1EFFFFFF" border="46">bobbi/glass/modal-glass.png</texture>
      </control>
      <control type="image">
        <left>80</left><top>244</top><width>380</width><height>764</height>
        <texture colordiffuse="glass_rim" border="46">bobbi/glass/modal-glass-rim.png</texture>
      </control>
      <control type="grouplist" id="9999">
        <left>98</left><top>266</top><width>344</width><height>720</height>
        <orientation>vertical</orientation>
        <itemgap>12</itemgap>
        <onleft>9999</onleft>
        <onright>50</onright>
        <onup>9999</onup>
        <ondown>9999</ondown>
        <onback>50</onback>
        <control type="radiobutton" id="990">
          <width>344</width><height>66</height>
          <label>新搜索</label>
          <font>Label28</font><textcolor>FFF5F5F7</textcolor><focusedcolor>FF1D1D1F</focusedcolor>
          <textoffsetx>28</textoffsetx><aligny>center</aligny>
          <texturefocus colordiffuse="FFFFFFFF" border="33,0,33,0">bobbi/glass/capsule-66.png</texturefocus>
          <texturenofocus colordiffuse="22FFFFFF" border="33,0,33,0">bobbi/glass/capsule-66.png</texturenofocus>
          <radioposx>288</radioposx><radiowidth>28</radiowidth><radioheight>28</radioheight>
          <textureradioonfocus colordiffuse="FF1D1D1F">bobbi/glass/icons/search.png</textureradioonfocus>
          <textureradioonnofocus colordiffuse="FFF5F5F7">bobbi/glass/icons/search.png</textureradioonnofocus>
          <textureradioofffocus colordiffuse="FF1D1D1F">bobbi/glass/icons/search.png</textureradioofffocus>
          <textureradiooffnofocus colordiffuse="FFF5F5F7">bobbi/glass/icons/search.png</textureradiooffnofocus>
        </control>
        <control type="list" id="9000">
          <width>344</width><height>636</height>
          <onup>990</onup>
          <ondown>990</ondown>
          <onleft>9000</onleft>
          <onright>50</onright>
          <itemlayout width="344" height="72">
            <control type="image">
              <top>4</top><width>344</width><height>64</height>
              <texture colordiffuse="16FFFFFF" border="26">bobbi/glass/row-glass.png</texture>
            </control>
            <control type="label">
              <left>24</left><top>4</top><width>236</width><height>64</height>
              <label>$INFO[ListItem.Label]</label>
              <font>Card26</font><textcolor>FFF5F5F7</textcolor><aligny>center</aligny>
            </control>
            <control type="label">
              <left>256</left><top>4</top><width>68</width><height>64</height>
              <label>$INFO[ListItem.Label2]</label>
              <font>CardSub22</font><textcolor>9CEBEBF5</textcolor><align>right</align><aligny>center</aligny>
            </control>
          </itemlayout>
          <focusedlayout width="344" height="72">
            <control type="image">
              <top>4</top><width>344</width><height>64</height>
              <texture colordiffuse="24FFFFFF" border="26">bobbi/glass/row-glass.png</texture>
              <visible>!Control.HasFocus(9000)</visible>
            </control>
            <control type="image">
              <top>4</top><width>344</width><height>64</height>
              <texture colordiffuse="FFFFFFFF" border="26">bobbi/glass/row-glass.png</texture>
              <visible>Control.HasFocus(9000)</visible>
            </control>
            <control type="label">
              <left>24</left><top>4</top><width>236</width><height>64</height>
              <label>$INFO[ListItem.Label]</label>
              <font>Card26</font><textcolor>FFF5F5F7</textcolor><aligny>center</aligny>
              <visible>!Control.HasFocus(9000)</visible>
            </control>
            <control type="label">
              <left>24</left><top>4</top><width>236</width><height>64</height>
              <label>$INFO[ListItem.Label]</label>
              <font>Card26</font><textcolor>FF1D1D1F</textcolor><aligny>center</aligny>
              <visible>Control.HasFocus(9000)</visible>
            </control>
            <control type="label">
              <left>256</left><top>4</top><width>68</width><height>64</height>
              <label>$INFO[ListItem.Label2]</label>
              <font>CardSub22</font><textcolor>9CEBEBF5</textcolor><align>right</align><aligny>center</aligny>
              <visible>!Control.HasFocus(9000)</visible>
            </control>
            <control type="label">
              <left>256</left><top>4</top><width>68</width><height>64</height>
              <label>$INFO[ListItem.Label2]</label>
              <font>CardSub22</font><textcolor>B31D1D1F</textcolor><align>right</align><aligny>center</aligny>
              <visible>Control.HasFocus(9000)</visible>
            </control>
          </focusedlayout>
        </control>
      </control>
    </control>

    <!-- Right Poster Results Grid (id=50, 5-up 224x336 @ x=496..1840) -->
    <control type="panel" id="50">
      <visible>!Control.IsVisible(999)</visible>
      <left>480</left><top>244</top><width>1375</width><height>780</height>
      <orientation>vertical</orientation>
      <include>ListMotion</include>
      <preloaditems>2</preloaditems>
      <onleft>9999</onleft>
      <onright>noop</onright>
      <onup>990</onup>
      <ondown>noop</ondown>
      <viewtype label="海报">wall</viewtype>
      <itemlayout width="275" height="404">
        <control type="group">
          <left>25</left><top>14</top>
          <control type="image">
            <width>224</width><height>336</height>
            <texture>bobbi/glass/tile-224x336.png</texture>
          </control>
          <control type="image">
            <width>224</width><height>336</height>
            <aspectratio scalediffuse="false">scale</aspectratio>
            <texture background="true" diffuse="bobbi/glass/mask-224x336.png">$INFO[ListItem.Art(poster)]</texture>
            <visible>!String.IsEmpty(ListItem.Art(poster))</visible>
          </control>
          <control type="image">
            <width>224</width><height>336</height>
            <aspectratio scalediffuse="false">scale</aspectratio>
            <texture background="true" diffuse="bobbi/glass/mask-224x336.png">$INFO[ListItem.Icon]</texture>
            <visible>String.IsEmpty(ListItem.Art(poster))</visible>
          </control>
          <control type="image">
            <width>224</width><height>336</height>
            <texture>bobbi/glass/rim-224x336.png</texture>
          </control>
          <control type="label">
            <left>2</left><top>346</top><width>220</width><height>26</height>
            <label>$INFO[ListItem.Label]</label>
            <font>Card26</font><textcolor>D9EBEBF5</textcolor><aligny>center</aligny>
          </control>
        </control>
      </itemlayout>
      <focusedlayout width="275" height="404">
        <control type="group">
          <left>25</left><top>14</top>
          <control type="group">
            <include content="Lift"><param name="center">112,168</param><param name="zoom">106</param></include>
            <control type="image">
              <left>-48</left><top>-48</top><width>320</width><height>432</height>
              <texture>bobbi/glass/shadow-224x336.png</texture>
              <visible>Control.HasFocus(50)</visible>
            </control>
            <control type="image">
              <width>224</width><height>336</height>
              <texture>bobbi/glass/tile-224x336.png</texture>
            </control>
            <control type="image">
              <width>224</width><height>336</height>
              <aspectratio scalediffuse="false">scale</aspectratio>
              <texture background="true" diffuse="bobbi/glass/mask-224x336.png">$INFO[ListItem.Art(poster)]</texture>
              <visible>!String.IsEmpty(ListItem.Art(poster))</visible>
            </control>
            <control type="image">
              <width>224</width><height>336</height>
              <aspectratio scalediffuse="false">scale</aspectratio>
              <texture background="true" diffuse="bobbi/glass/mask-224x336.png">$INFO[ListItem.Icon]</texture>
              <visible>String.IsEmpty(ListItem.Art(poster))</visible>
            </control>
            <control type="image">
              <width>224</width><height>336</height>
              <texture>bobbi/glass/spec-224x336.png</texture>
              <visible>Control.HasFocus(50)</visible>
            </control>
          </control>
          <control type="label">
            <left>2</left><top>350</top><width>220</width><height>26</height>
            <label>$INFO[ListItem.Label]</label>
            <font>Card26</font><textcolor>FFFFFFFF</textcolor><aligny>center</aligny><scroll>true</scroll>
          </control>
        </control>
      </focusedlayout>
    </control>
  </controls>
</window>
