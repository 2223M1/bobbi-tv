<?xml version='1.0' encoding='utf-8'?>
<window>
  <defaultcontrol always="true">5</defaultcontrol>
  <depth>DepthOSD</depth>
  <controls>
    <control type="group">
      <visible>!Window.IsVisible(sliderdialog)</visible>
      <include content="SheetShell"><param name="width">840</param></include>
      <control type="group">
        <right>0</right><top>0</top><width>840</width><height>1080</height>
        <include content="PanelOpen"><param name="slide">48,0</param></include>
        <control type="label">
          <left>48</left><top>120</top><width>744</width><height>34</height>
          <label>$VAR[SettingsSheetContext]</label>
          <font>Meta24</font><textcolor>text3</textcolor>
        </control>
        <control type="grouplist" id="5">
          <left>48</left><top>176</top><width>744</width><height>704</height>
          <orientation>vertical</orientation>
          <itemgap>4</itemgap>
          <pagecontrol>60</pagecontrol>
          <scrolltime tween="cubic" easing="out">160</scrolltime>
          <onup>5</onup><ondown>5</ondown>
          <onleft>noop</onleft>
          <onright>9000</onright>
        </control>
        <control type="scrollbar" id="60">
          <left>808</left><top>176</top><width>4</width><height>704</height>
          <orientation>vertical</orientation>
          <showonepage>false</showonepage>
          <texturesliderbackground colordiffuse="1AFFFFFF">bobi/white.png</texturesliderbackground>
          <texturesliderbar colordiffuse="66FFFFFF">bobi/white.png</texturesliderbar>
          <texturesliderbarfocus colordiffuse="FFFFFFFF">bobi/white.png</texturesliderbarfocus>
          <onleft>5</onleft>
        </control>
        <control type="textbox" id="6">
          <left>76</left><top>892</top><width>716</width><height>64</height>
          <font>Meta22</font><textcolor>text3</textcolor>
        </control>
        <control type="grouplist" id="9000">
          <left>48</left><top>972</top><width>744</width><height>68</height>
          <orientation>horizontal</orientation><itemgap>12</itemgap>
          <onup>5</onup><onleft>5</onleft><onright>noop</onright>
          <include content="DialogButton"><param name="id">28</param><param name="width">220</param></include>
          <include content="DialogButton"><param name="id">29</param><param name="width">220</param></include>
          <include content="DialogButton"><param name="id">30</param><param name="width">260</param></include>
        </control>
      </control>
      <!-- templates live off-screen; Kodi clones them into list 5 -->
      <control type="group">
        <left>-2000</left>
        <include content="SettingTemplates"><param name="w">744</param></include>
      </control>
    </control>
  </controls>
</window>