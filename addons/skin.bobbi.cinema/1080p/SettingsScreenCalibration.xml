<?xml version='1.0' encoding='utf-8'?>
<window>
  <defaultcontrol>8</defaultcontrol>
  <controls>
    <control type="videowindow" id="20">
      <left>0</left><top>0</top><width>1920</width><height>1080</height>
      <visible>Player.HasVideo</visible>
    </control>
    <control type="group">
      <visible>!Player.HasVideo</visible>
      <include>Canvas</include>
      <control type="image">
        <left>0</left><top>0</top><width>1920</width><height>1080</height>
        <texture>bobbi/glass/settings-bg.png</texture>
      </control>
    </control>
    <control type="image">
      <left>0</left><top>0</top><width>1920</width><height>1080</height>
      <texture colordiffuse="66000000">bobbi/white.png</texture>
    </control>

    <control type="mover" id="8">
      <left>0</left><top>0</top><width>192</width><height>192</height>
      <texturefocus>CalibrateTopLeft.png</texturefocus>
      <texturenofocus />
      <movingspeed acceleration="180" maxvelocity="300" resettimeout="200" delta="1">
        <eventconfig type="up" />
        <eventconfig type="down" />
        <eventconfig type="left" />
        <eventconfig type="right" />
      </movingspeed>
    </control>
    <control type="mover" id="9">
      <left>1050</left><top>750</top><width>192</width><height>192</height>
      <texturefocus>CalibrateBottomRight.png</texturefocus>
      <texturenofocus />
      <movingspeed acceleration="180" maxvelocity="300" resettimeout="200" delta="1">
        <eventconfig type="up" />
        <eventconfig type="down" />
        <eventconfig type="left" />
        <eventconfig type="right" />
      </movingspeed>
    </control>
    <control type="mover" id="10">
      <left>300</left><top>750</top><width>768</width><height>192</height>
      <texturefocus>CalibrateSubtitles.png</texturefocus>
      <texturenofocus />
      <movingspeed acceleration="180" maxvelocity="300" resettimeout="200" delta="1">
        <eventconfig type="up" />
        <eventconfig type="down" />
        <eventconfig type="left" />
        <eventconfig type="right" />
      </movingspeed>
    </control>
    <control type="resize" id="11">
      <left>0</left><top>348</top><width>384</width><height>384</height>
      <texturefocus>CalibratePixelRatio.png</texturefocus>
      <texturenofocus />
      <movingspeed acceleration="140" maxvelocity="300" resettimeout="180" delta="1">
        <eventconfig type="left" />
        <eventconfig type="right" />
      </movingspeed>
    </control>
    <control type="mover" id="12">
      <left>0</left><top>1350</top><width>96</width><height>96</height>
      <texturefocus colordiffuse="FFFFFFFF">bobbi/glass/icons/refresh.png</texturefocus>
      <texturenofocus colordiffuse="9CEBEBF5">bobbi/glass/icons/refresh.png</texturenofocus>
    </control>

    <!-- on-device Centered Liquid Glass Calibration HUD -->
    <control type="group">
      <centerleft>50%</centerleft><top>64</top>
      <width>1120</width><height>184</height>
      <control type="image">
        <width>1120</width><height>184</height>
        <texture colordiffuse="$VAR[BobbiMattePanelColor]" border="46">bobbi/glass/modal-glass.png</texture>
      </control>
      <control type="image">
        <width>1120</width><height>184</height>
        <texture colordiffuse="glass_rim" border="46">bobbi/glass/modal-glass-rim.png</texture>
      </control>
      <control type="label" id="2">
        <left>40</left><top>24</top><width>1040</width><height>42</height>
        <label />
        <align>center</align><aligny>center</aligny>
        <font>Head30</font><textcolor>FFFFFFFF</textcolor>
      </control>
      <control type="label" id="3">
        <left>40</left><top>74</top><width>1040</width><height>38</height>
        <label />
        <align>center</align><aligny>center</aligny>
        <font>Body26</font><textcolor>D9EBEBF5</textcolor>
      </control>
      <control type="label" id="4">
        <left>40</left><top>120</top><width>1040</width><height>36</height>
        <label />
        <align>center</align><aligny>center</aligny>
        <font>Card24</font><textcolor>$VAR[BobbiPanelCaption]</textcolor>
      </control>
    </control>
  </controls>
</window>
