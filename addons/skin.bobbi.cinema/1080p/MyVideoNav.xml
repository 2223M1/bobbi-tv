<?xml version='1.0' encoding='utf-8'?>
<window>
  <defaultcontrol always="false">50</defaultcontrol>
  <menucontrol>9701</menucontrol>
  <views>50</views>
  <include>PageOpen</include>
  <controls>
    <include>Canvas</include>
    <include>DirectoryHeader</include>
    <include>DirectoryPanel</include>
    <!-- loading / empty -->
    <control type="group">
      <visible>Container.IsUpdating + Integer.IsEqual(Container.NumItems,0)</visible>
      <include content="StateBlock"><param name="y">420</param><param name="loading">true</param></include>
    </control>
    <control type="group">
      <visible>!Container.IsUpdating + !Window.IsVisible(busydialog) + !Window.IsVisible(busydialognocancel) + Integer.IsEqual(Container.NumItems,0)</visible>
      <include content="StateBlock">
        <param name="y">420</param>
        <param name="empty">true</param>
        <param name="emptytitle">$LOCALIZE[32061]</param>
        <param name="emptyhint">$LOCALIZE[32063]</param>
      </include>
      <control type="button" id="9080">
        <left>80</left><top>520</top><width>280</width><height>66</height>
        <label>$LOCALIZE[32064]</label>
        <font>Button24</font><textcolor>text</textcolor><focusedcolor>on_focus</focusedcolor>
        <align>center</align><aligny>center</aligny>
        <texturefocus colordiffuse="focus" border="33,0,33,0">bobbi/glass/capsule-66.png</texturefocus>
        <texturenofocus colordiffuse="24FFFFFF" border="33,0,33,0">bobbi/glass/capsule-66.png</texturenofocus>
        <onup condition="Control.IsVisible(9040)">9040</onup>
        <onup condition="!Control.IsVisible(9040) + Control.IsVisible(9050)">9050</onup>
        <onup condition="!Control.IsVisible(9040) + !Control.IsVisible(9050)">9701</onup>
        <onleft>9701</onleft>
        <onright>noop</onright>
        <ondown>noop</ondown>
        <onclick>SetFocus(9701)</onclick>
      </control>
    </control>
    <include>DirectoryChrome</include>
    <include content="TopBar">
      <param name="down" value="SetFocus($VAR[VideoContentFocus])" />
      <param name="skip_nav_barrier" value="true" />
    </include>
  </controls>
</window>
