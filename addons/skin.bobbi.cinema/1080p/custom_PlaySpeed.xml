<?xml version='1.0' encoding='utf-8'?>
<window type="dialog" id="1115">
  <defaultcontrol always="true">9200</defaultcontrol>
  <depth>DepthOSD</depth>
  <onunload condition="Player.HasVideo + !Window.IsActive(videoosd)">ActivateWindow(1114)</onunload>
  <controls>
    <include>DialogScrim</include>
    <include content="SideSheet">
      <param name="title">$VAR[TempoModeLabel]</param>
      <param name="subtitle">$VAR[TempoNavigationHint]</param>
    </include>
    <control type="group">
      <right>48</right><top>220</top><width>624</width><height>300</height>
      <control type="label">
        <left>0</left><top>0</top><width>624</width><height>140</height>
        <label>$VAR[TempoLabel]</label>
        <font>Display72</font><textcolor>text</textcolor><align>center</align><aligny>center</aligny>
      </control>
      <!-- Like Fuse3: directional adjustment, with an explicit native trick-play fallback.
           TempoEnabled is Kodi's capability label; SupportsTempo is not a skin label. -->
      <control type="button" id="9200">
        <left>32</left><top>170</top><width>560</width><height>88</height>
        <label>←     $VAR[TempoModeLabel]     →</label>
        <font>Button24</font><align>center</align><aligny>center</aligny>
        <textcolor>text</textcolor><focusedcolor>on_focus</focusedcolor>
        <texturenofocus colordiffuse="40FFFFFF" border="20">bobi/r20.png</texturenofocus>
        <texturefocus colordiffuse="focus" border="20">bobi/r20.png</texturefocus>
        <enable>Player.TempoEnabled | Player.SeekEnabled</enable>
        <onup>noop</onup><ondown>noop</ondown>
        <onleft condition="Player.Paused">PlayerControl(Play)</onleft>
        <onright condition="Player.Paused">PlayerControl(Play)</onright>
        <onleft condition="Player.TempoEnabled">PlayerControl(TempoDown)</onleft>
        <onright condition="Player.TempoEnabled">PlayerControl(TempoUp)</onright>
        <onleft condition="!Player.TempoEnabled + !Player.Rewinding32x">PlayerControl(Rewind)</onleft>
        <onright condition="!Player.TempoEnabled + !Player.Forwarding32x">PlayerControl(Forward)</onright>
        <onclick condition="Player.TempoEnabled + !Player.Paused">PlayerControl(Tempo(1.0))</onclick>
        <onclick condition="Player.Paused | Player.Forwarding | Player.Rewinding">PlayerControl(Play)</onclick>
      </control>
      <control type="label">
        <left>0</left><top>276</top><width>624</width><height>64</height>
        <label>$VAR[TempoStatusHint]</label>
        <font>Meta22</font><textcolor>text3</textcolor><align>center</align>
      </control>
    </control>
  </controls>
</window>
