<?xml version='1.0' encoding='utf-8'?>
<window type="dialog" id="1115">
  <defaultcontrol always="true">9200</defaultcontrol>
  <depth>DepthOSD</depth>
  <controls>
    <include content="OSDScrim"><param name="top">520</param></include>
    <control type="group">
      <left>580</left><top>656</top><width>760</width><height>328</height>
      <include content="PanelOpen"><param name="slide">0,24</param></include>
      <control type="image">
        <left>-48</left><top>-48</top><width>856</width><height>424</height>
        <texture border="64">bobbi/glass/modal-shadow.png</texture>
      </control>
      <control type="image">
        <left>0</left><top>0</top><width>760</width><height>328</height>
        <texture colordiffuse="$VAR[BobbiMattePanelColor]" border="46">bobbi/glass/modal-glass.png</texture>
      </control>
      <control type="image">
        <left>0</left><top>0</top><width>760</width><height>328</height>
        <texture colordiffuse="glass_rim" border="46">bobbi/glass/modal-glass-rim.png</texture>
      </control>
      <control type="label">
        <left>40</left><top>24</top><width>680</width><height>36</height>
        <label>$VAR[TempoModeLabel]</label>
        <font>Head30</font><textcolor>text</textcolor><align>center</align><aligny>center</aligny>
      </control>
      <control type="label">
        <left>40</left><top>60</top><width>680</width><height>28</height>
        <label>$VAR[TempoNavigationHint]</label>
        <font>CardSub22</font><textcolor>$VAR[BobbiPanelCaption]</textcolor><align>center</align><aligny>center</aligny>
      </control>
      <control type="label">
        <left>40</left><top>94</top><width>680</width><height>96</height>
        <label>$VAR[TempoLabel]</label>
        <font>Hero76</font><textcolor>FFFFFFFF</textcolor><align>center</align><aligny>center</aligny>
      </control>
      <control type="button" id="9200">
        <left>100</left><top>200</top><width>560</width><height>68</height>
        <label>‹      $VAR[TempoModeLabel]      ›</label>
        <font>Button24</font><align>center</align><aligny>center</aligny>
        <textcolor>text</textcolor><focusedcolor>on_focus</focusedcolor>
        <texturenofocus colordiffuse="24FFFFFF" border="34,0,34,0">bobbi/glass/capsule-68.png</texturenofocus>
        <texturefocus colordiffuse="FFFFFFFF" border="34,0,34,0">bobbi/glass/capsule-68.png</texturefocus>
        <enable>Player.TempoEnabled | Player.SeekEnabled</enable>
        <onup>noop</onup><ondown>noop</ondown>
        <onleft condition="Player.Paused">noop</onleft>
        <onright condition="Player.Paused">noop</onright>
        <onleft condition="!Player.Paused + Player.TempoEnabled">PlayerControl(TempoDown)</onleft>
        <onright condition="!Player.Paused + Player.TempoEnabled">PlayerControl(TempoUp)</onright>
        <onleft condition="!Player.Paused + !Player.TempoEnabled + !Player.Rewinding32x">PlayerControl(Rewind)</onleft>
        <onright condition="!Player.Paused + !Player.TempoEnabled + !Player.Forwarding32x">PlayerControl(Forward)</onright>
        <onclick condition="Player.TempoEnabled + !Player.Paused + !Player.Forwarding + !Player.Rewinding">PlayerControl(Tempo(1.0))</onclick>
        <onclick condition="Player.Paused | Player.Forwarding | Player.Rewinding">RunScript(plugin.video.bobbi,bobbi_osd=resume)</onclick>
      </control>
      <control type="label">
        <left>40</left><top>278</top><width>680</width><height>32</height>
        <label>$VAR[TempoStatusHint]</label>
        <font>CardSub22</font><textcolor>$VAR[BobbiPanelCaption]</textcolor><align>center</align><aligny>center</aligny>
      </control>
    </control>
  </controls>
</window>
