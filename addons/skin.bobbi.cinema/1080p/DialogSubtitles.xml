            <left>22</left><top>26</top><width>22</width><height>22</height>
            <texture colordiffuse="FF1D1D1F">bobbi/glass/icons/checkmark.png</texture>
            <visible>ListItem.IsSelected + Control.HasFocus(150)</visible>
          </control>
          <control type="label">
            <left>56</left><top>4</top><width>272</width><height>66</height>
            <font>Card26</font><textcolor>text</textcolor><selectedcolor>text</selectedcolor>
            <aligny>center</aligny><info>ListItem.Label</info>
            <visible>!Control.HasFocus(150)</visible>
          </control>
          <control type="label">
            <left>56</left><top>4</top><width>272</width><height>66</height>
            <font>Card26</font><textcolor>on_focus</textcolor><selectedcolor>on_focus</selectedcolor>
            <aligny>center</aligny><info>ListItem.Label</info>
            <visible>Control.HasFocus(150)</visible>
          </control>
        </focusedlayout>
      </control>

      <!-- Right Subtitle Results List (120) -->
