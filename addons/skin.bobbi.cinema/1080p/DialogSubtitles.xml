        <left>412</left><top>168</top><width>1072</width><height>546</height>
        <onleft>150</onleft>
        <onright>121</onright>
        <onup>120</onup>
        <ondown>160</ondown>
        <viewtype label="535">list</viewtype>
        <pagecontrol>121</pagecontrol>
        <include>ListMotion</include>
        <itemlayout width="1072" height="74">
          <control type="image">
            <left>0</left><top>4</top><width>1072</width><height>66</height>
            <texture colordiffuse="14FFFFFF" border="33,0,33,0">bobbi/glass/capsule-66.png</texture>
          </control>
          <control type="image">
            <left>0</left><top>4</top><width>1072</width><height>66</height>
            <texture colordiffuse="55FFFFFF" border="33,0,33,0">bobbi/glass/capsule-66-rim.png</texture>
          </control>
          <control type="label">
            <left>28</left><top>4</top><width>148</width><height>66</height>
            <font>Card24</font><textcolor>text</textcolor><selectedcolor>text</selectedcolor>
            <aligny>center</aligny><info>ListItem.Label</info>
          </control>
          <control type="label">
            <left>184</left><top>4</top><width>760</width><height>66</height>
            <font>CardSub22</font><textcolor>$VAR[BobbiPanelCaption]</textcolor><selectedcolor>text</selectedcolor>
            <aligny>center</aligny><info>ListItem.Label2</info>
            <scroll>false</scroll>
          </control>
          <control type="image">
            <left>968</left><top>27</top><width>20</width><height>20</height>
            <texture colordiffuse="9CEBEBF5">bobbi/glass/icons/star.png</texture>
            <visible>!String.IsEmpty(ListItem.ActualIcon)</visible>
          </control>
          <control type="label">
            <left>994</left><top>4</top><width>52</width><height>66</height>
            <label>$INFO[ListItem.ActualIcon]</label>
            <font>CardSub22</font><textcolor>$VAR[BobbiPanelCaption]</textcolor><align>right</align><aligny>center</aligny>
          </control>
        </itemlayout>
        <focusedlayout width="1072" height="74">
          <control type="image">
            <left>0</left><top>4</top><width>1072</width><height>66</height>
            <texture colordiffuse="14FFFFFF" border="33,0,33,0">bobbi/glass/capsule-66.png</texture>
            <visible>!Control.HasFocus(120)</visible>
          </control>
          <control type="image">
            <left>0</left><top>4</top><width>1072</width><height>66</height>
            <texture colordiffuse="55FFFFFF" border="33,0,33,0">bobbi/glass/capsule-66-rim.png</texture>
            <visible>!Control.HasFocus(120)</visible>
          </control>
          <control type="image">
            <left>0</left><top>4</top><width>1072</width><height>66</height>
            <texture colordiffuse="FFFFFFFF" border="33,0,33,0">bobbi/glass/capsule-66.png</texture>
            <visible>Control.HasFocus(120)</visible>
          </control>
          <control type="label">
            <left>28</left><top>4</top><width>148</width><height>66</height>
            <font>Card24</font><textcolor>text</textcolor><selectedcolor>text</selectedcolor>
            <aligny>center</aligny><info>ListItem.Label</info>
            <visible>!Control.HasFocus(120)</visible>
