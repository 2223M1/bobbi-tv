            <visible>!String.IsEmpty(ListItem.ActualIcon) + Control.HasFocus(120)</visible>
          </control>
          <control type="label">
            <left>994</left><top>4</top><width>52</width><height>66</height>
            <label>$INFO[ListItem.ActualIcon]</label>
            <font>CardSub22</font><textcolor>$VAR[BobbiPanelCaption]</textcolor><align>right</align><aligny>center</aligny>
            <visible>!Control.HasFocus(120)</visible>
          </control>
          <control type="label">
            <left>994</left><top>4</top><width>52</width><height>66</height>
            <label>$INFO[ListItem.ActualIcon]</label>
            <font>CardSub22</font><textcolor>B31D1D1F</textcolor><align>right</align><aligny>center</aligny>
            <visible>Control.HasFocus(120)</visible>
          </control>
        </focusedlayout>
