      <!-- Bottom Row: Local Subtitle Status (130), Page Control (121), Manual Search (160) -->
      <control type="group" id="130">
        <left>44</left><top>742</top><width>880</width><height>66</height>
        <control type="image">
          <left>0</left><top>21</top><width>24</width><height>24</height>
          <texture colordiffuse="9CEBEBF5">bobbi/glass/icons/info.png</texture>
        </control>
        <control type="label">
          <left>36</left><top>0</top><width>844</width><height>66</height>
          <font>CardSub22</font><textcolor>$VAR[BobbiPanelCaption]</textcolor>
          <label>$LOCALIZE[31413]</label><aligny>center</aligny>
        </control>
      </control>

      <control type="spincontrol" id="121">
        <left>1124</left><top>757</top><width>36</width><height>36</height>
        <font>CardSub22</font>
        <align>right</align><aligny>center</aligny>
        <subtype>page</subtype>
        <textcolor>$VAR[BobbiPanelCaption]</textcolor>
        <onleft>120</onleft><onright>160</onright>
        <onup>120</onup><ondown>160</ondown>
        <textoffsetx>14</textoffsetx>
        <textureup colordiffuse="9CEBEBF5">bobbi/icons/chevron-up.png</textureup>
        <texturedown colordiffuse="9CEBEBF5">bobbi/icons/chevron-down.png</texturedown>
        <textureupfocus colordiffuse="FFFFFFFF">bobbi/icons/chevron-up.png</textureupfocus>
        <texturedownfocus colordiffuse="FFFFFFFF">bobbi/icons/chevron-down.png</texturedownfocus>
        <showonepage>false</showonepage>
        <visible>Control.IsVisible(120)</visible>
      </control>

      <control type="button" id="160">
        <left>1216</left><top>742</top><width>268</width><height>66</height>
        <onleft>121</onleft><onright>150</onright>
        <onup>120</onup><ondown>150</ondown>
        <label>手动输入搜索</label>
        <font>Button24</font>
        <textcolor>text</textcolor><focusedcolor>on_focus</focusedcolor>
        <align>center</align><aligny>center</aligny>
        <texturenofocus colordiffuse="24FFFFFF" border="33,0,33,0">bobbi/glass/capsule-66.png</texturenofocus>
        <texturefocus colordiffuse="FFFFFFFF" border="33,0,33,0">bobbi/glass/capsule-66.png</texturefocus>
