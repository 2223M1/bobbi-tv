          <onleft>noop</onleft><onright>noop</onright><onclick>noop</onclick>
          <visible>!$EXP[BobbiCurrentStreamPanel]</visible>
        </control>
        <control type="list" id="2021">
          <left>24</left><top>140</top><width>652</width><height>432</height>
          <orientation>vertical</orientation>
