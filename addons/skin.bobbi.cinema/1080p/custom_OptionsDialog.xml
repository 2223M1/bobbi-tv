<?xml version='1.0' encoding='utf-8'?>
<window type="dialog" id="1114">
  <defaultcontrol always="true">9100</defaultcontrol>
  <depth>DepthOSD</depth>
  <controls>
    <include>DialogScrim</include>
    <include content="SideSheet">
      <param name="title">更多</param>
      <param name="subtitle">$VAR[PlayerTitle]</param>
    </include>
    <control type="list" id="9100">
      <right>48</right><top>184</top><width>624</width><height>820</height>
      <orientation>vertical</orientation>
      <include>ListMotion</include>
      <onleft>noop</onleft><onright>noop</onright>
      <itemlayout width="624" height="76">
        <include content="OSDCapsuleRow"><param name="list">9100</param></include>
      </itemlayout>
      <focusedlayout width="624" height="76">
        <include content="OSDCapsuleRow"><param name="list">9100</param><param name="focused">true</param></include>
      </focusedlayout>
      <content>
        <item>
          <label>杜比视界 VS10</label><label2>$VAR[VS10Label]</label2><icon>bobbi/glass/icons/sparkles.png</icon>
          <onclick>ActivateWindow(1116)</onclick>
          <visible>System.Platform.Linux</visible>
        </item>
        <item>
          <label>播放速度</label><label2>$VAR[TempoLabel]</label2><icon>bobbi/glass/icons/clock.png</icon>
          <onclick>ActivateWindow(1115)</onclick>
          <visible>Player.TempoEnabled | Player.SeekEnabled</visible>
        </item>
        <item>
          <label>章节 / 书签</label><label2>章节选择与播放书签</label2><icon>bobbi/glass/icons/bookmark.png</icon>
          <onclick>RunScript(plugin.video.bobbi,bobbi_osd=chapters)</onclick>
          <visible>Player.SeekEnabled</visible>
        </item>
        <item>
          <label>信号信息</label><label2>$VAR[ResolutionLabel]$INFO[VideoPlayer.VideoCodec,  ·  ]  ·  $VAR[HDRLabel]</label2><icon>bobbi/glass/icons/info.png</icon>
          <onclick>ActivateWindow(playerprocessinfo)</onclick>
        </item>
        <item>
          <label>色彩管理</label><label2>3D LUT / ICC</label2><icon>bobbi/glass/icons/photo.png</icon>
          <onclick>ActivateWindow(osdcmssettings)</onclick>
          <visible>System.HasCMS</visible>
        </item>
        <item>
          <label>光盘菜单</label><label2>蓝光 / DVD 原盘</label2><icon>bobbi/glass/icons/film.png</icon>
          <onclick>PlayerControl(ShowVideoMenu)</onclick>
          <visible>VideoPlayer.HasMenu</visible>
        </item>
        <item>
          <label>3D 模式</label><label2>$INFO[VideoPlayer.StereoscopicMode]</label2><icon>bobbi/glass/icons/tv.png</icon>
          <onclick>StereoMode</onclick>
          <visible>VideoPlayer.IsStereoscopic</visible>
        </item>
        <item>
          <label>调试叠加层</label><label2>实时解码、丢帧与音视频同步</label2><icon>bobbi/glass/icons/cpu.png</icon>
          <onclick>PlayerDebug</onclick>
          <onclick>Dialog.Close(1114)</onclick>
        </item>
      </content>
    </control>
  </controls>
</window>
