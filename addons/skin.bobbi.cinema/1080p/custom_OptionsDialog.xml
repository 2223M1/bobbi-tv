<?xml version='1.0' encoding='utf-8'?>
<window type="dialog" id="1114">
  <defaultcontrol always="true">9100</defaultcontrol>
  <depth>DepthOSD</depth>
  <controls>
    <include>DialogScrim</include>
    <control type="group">
      <visible>!Window.IsVisible(shutdownmenu)</visible>
      <include content="SideSheet">
        <param name="title">$LOCALIZE[32213]</param>
        <param name="subtitle">$VAR[PlayerTitle]</param>
      </include>
      <control type="list" id="9100">
        <right>48</right><top>184</top><width>624</width><height>820</height>
        <orientation>vertical</orientation>
        <include>ListMotion</include>
        <onleft>noop</onleft><onright>noop</onright>
        <itemlayout width="624" height="76">
          <include content="OSDCapsuleRow"><param name="list">9100</param></include>
        </itemlayout>
        <focusedlayout width="624" height="76">
          <include content="OSDCapsuleRow"><param name="list">9100</param><param name="focused">true</param></include>
        </focusedlayout>
        <content>
          <item>
            <label>$LOCALIZE[32014]</label><label2>$LOCALIZE[32236]</label2><icon>bobbi/glass/icons/control-center.png</icon>
            <onclick>ActivateWindow(ShutdownMenu)</onclick>
          </item>
          <item>
            <label>$LOCALIZE[32225]</label><label2>$VAR[VS10Label]</label2><icon>bobbi/glass/icons/sparkles.png</icon>
            <onclick>ActivateWindow(1116)</onclick>
            <visible>System.Platform.Linux + !String.IsEmpty(Player.Process(video.source.hdr.type)) + !String.IsEqual(Player.Process(video.source.hdr.type.raw),2)</visible>
          </item>
          <item>
            <label>$LOCALIZE[32226]</label><label2>$VAR[TempoLabel]</label2><icon>bobbi/glass/icons/clock.png</icon>
            <onclick>ActivateWindow(1115)</onclick>
            <visible>Player.TempoEnabled | Player.SeekEnabled</visible>
          </item>
          <item>
            <label>$LOCALIZE[32224]</label><label2>$LOCALIZE[32228]</label2><icon>bobbi/glass/icons/bookmark.png</icon>
            <onclick>RunScript(plugin.video.bobbi,bobbi_osd=chapters)</onclick>
            <visible>Player.SeekEnabled</visible>
          </item>
          <item>
            <label>$LOCALIZE[32229]</label><label2>$VAR[ResolutionLabel]$INFO[VideoPlayer.VideoCodec,  ·  ]  ·  $VAR[HDRLabel]</label2><icon>bobbi/glass/icons/info.png</icon>
            <onclick>ActivateWindow(playerprocessinfo)</onclick>
          </item>
          <item>
            <label>$LOCALIZE[32230]</label><label2>3D LUT / ICC</label2><icon>bobbi/glass/icons/photo.png</icon>
            <onclick>ActivateWindow(osdcmssettings)</onclick>
            <visible>System.HasCMS</visible>
          </item>
          <item>
            <label>$LOCALIZE[32231]</label><label2>$LOCALIZE[32232]</label2><icon>bobbi/glass/icons/film.png</icon>
            <onclick>PlayerControl(ShowVideoMenu)</onclick>
            <visible>VideoPlayer.HasMenu</visible>
          </item>
          <item>
            <label>$LOCALIZE[32233]</label><label2>$INFO[VideoPlayer.StereoscopicMode]</label2><icon>bobbi/glass/icons/tv.png</icon>
            <onclick>StereoMode</onclick>
            <visible>VideoPlayer.IsStereoscopic</visible>
          </item>
          <item>
            <label>$LOCALIZE[32234]</label><label2>$LOCALIZE[32235]</label2><icon>bobbi/glass/icons/cpu.png</icon>
            <onclick>PlayerDebug</onclick>
            <onclick>Dialog.Close(1114)</onclick>
          </item>
        </content>
      </control>
    </control>
  </controls>
</window>
