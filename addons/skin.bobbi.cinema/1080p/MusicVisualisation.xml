<?xml version='1.0' encoding='utf-8'?>
<window>
  <defaultcontrol />
  <controls>
    <control type="visualisation" id="2">
      <left>0</left>
      <top>0</top>
      <width>1920</width>
      <height>1080</height>
    </control>

    <control type="image">
      <left>0</left>
      <top>0</top>
      <width>1920</width>
      <height>1080</height>
      <aspectratio>scale</aspectratio>
      <texture background="true">$INFO[Player.Art(fanart)]</texture>
      <colordiffuse>88FFFFFF</colordiffuse>
      <visible>!String.IsEmpty(Player.Art(fanart)) + !Skin.HasSetting(HideVisualizationFanart)</visible>
      <include>ArtFade</include>
    </control>

    <control type="image">
      <left>0</left>
      <top>0</top>
      <width>1920</width>
      <height>1080</height>
      <texture colordiffuse="66000000">bobbi/glass/stage-ambient.png</texture>
    </control>

    <!-- Now Playing / Audio Now Playing Overlay -->
    <control type="group">
      <depth>DepthOSD</depth>
      <animation effect="fade" time="160" condition="!Skin.HasSetting(BobbiReduceMotion)">VisibleChange</animation>
      <visible>[Player.ShowInfo | Window.IsActive(MusicOSD)] + ![Window.IsVisible(AddonSettings) | Window.IsVisible(SelectDialog) | Window.IsVisible(VisualisationPresetList) | Window.IsVisible(PVROSDChannels) | Window.IsVisible(PVRChannelGuide) | Window.IsVisible(PVRRadioRDSInfo) | Window.IsVisible(Addon)]</visible>

      <!-- Top Scrim + Queue Position + AM/PM Glass Clock Pill -->
      <control type="image">
        <left>0</left><top>0</top><width>1920</width><height>180</height>
        <texture>bobbi/glass/scrim-top.png</texture>
      </control>
      <control type="label">
        <left>80</left><top>46</top><width>960</width><height>52</height>
        <label>$LOCALIZE[589]</label>
        <font>CardSub22</font><textcolor>9CEBEBF5</textcolor><aligny>center</aligny>
        <visible>MusicPartyMode.Enabled</visible>
      </control>
      <control type="label">
        <left>80</left><top>46</top><width>960</width><height>52</height>
        <label>$INFO[musicplayer.Playlistposition,$LOCALIZE[554] ]$INFO[musicplayer.Playlistlength, / ]</label>
        <font>CardSub22</font><textcolor>9CEBEBF5</textcolor><aligny>center</aligny>
        <visible>!MusicPartyMode.Enabled</visible>
      </control>
      <include content="GlassCapsule">
        <param name="x">1684</param><param name="y">46</param><param name="w">156</param><param name="h">52</param>
      </include>
      <control type="label">
        <left>1684</left><top>46</top><width>156</width><height>52</height>
        <label>$VAR[BobbiTimeAMPM]</label>
        <font>NavClock20</font><textcolor>FFFFFFFF</textcolor><align>center</align><aligny>center</aligny>
      </control>

      <!-- Bottom Scrim -->
      <include content="OSDScrim"><param name="top">420</param></include>

      <!-- Album Artwork Squircle (x=80, y=596, 220x220) -->
      <control type="group">
        <left>80</left><top>596</top>
        <visible>!Window.IsVisible(script-cu-lrclyrics-main.xml)</visible>
        <control type="image">
          <left>-32</left><top>-32</top><width>284</width><height>284</height>
          <texture border="64">bobbi/glass/modal-shadow.png</texture>
        </control>
        <control type="image">
          <left>0</left><top>0</top><width>220</width><height>220</height>
          <texture colordiffuse="22FFFFFF" border="14">bobbi/glass/squircle-r14.png</texture>
        </control>
        <control type="image">
          <left>0</left><top>0</top><width>220</width><height>220</height>
          <aspectratio scalediffuse="false">scale</aspectratio>
          <texture background="true" diffuse="bobbi/glass/squircle-r14.png">$INFO[Player.Art(thumb)]</texture>
        </control>
        <control type="image">
          <left>0</left><top>0</top><width>220</width><height>220</height>
          <texture colordiffuse="66FFFFFF" border="14">bobbi/glass/squircle-r14-rim.png</texture>
        </control>
      </control>

      <!-- Track Kicker + Tech Badges + Hero60 Title -->
      <control type="group">
        <left>336</left><top>648</top>
        <control type="grouplist">
          <left>0</left><top>0</top><width>1504</width><height>32</height>
          <orientation>horizontal</orientation><align>left</align><itemgap>10</itemgap>
          <usecontrolcoords>true</usecontrolcoords>
          <control type="label">
            <top>0</top><width>auto</width><height>32</height>
            <label>$INFO[MusicPlayer.Artist]$INFO[MusicPlayer.Album,  ·  ]</label>
            <font>HeroMeta24</font><textcolor>D9EBEBF5</textcolor><shadowcolor>66000000</shadowcolor>
            <aligny>center</aligny>
          </control>
          <include content="TechChip">
            <param name="label">$INFO[MusicPlayer.Codec]</param>
            <param name="visible">!String.IsEmpty(MusicPlayer.Codec) + !Player.ChannelPreviewActive</param>
          </include>
          <include content="TechChip">
            <param name="label">$INFO[MusicPlayer.SampleRate,, kHz]$INFO[MusicPlayer.BitsPerSample, · , bit]</param>
            <param name="visible">!String.IsEmpty(MusicPlayer.SampleRate)</param>
          </include>
        </control>
        <control type="label">
          <left>0</left><top>38</top><width>1504</width><height>64</height>
          <label>$INFO[Player.Title]</label>
          <font>Hero60</font><textcolor>FFFFFFFF</textcolor><shadowcolor>66000000</shadowcolor>
          <aligny>center</aligny><scroll>false</scroll>
        </control>
        <control type="label">
          <left>0</left><top>110</top><width>1504</width><height>30</height>
          <label>$LOCALIZE[19031]：$INFO[MusicPlayer.offset(1).Artist,, - ]$INFO[MusicPlayer.offset(1).Title]</label>
          <font>CardSub22</font><textcolor>9CEBEBF5</textcolor><aligny>center</aligny>
          <scroll>false</scroll>
          <visible>MusicPlayer.HasNext + !Window.IsVisible(MusicOSD)</visible>
        </control>
      </control>

      <!-- Full-Width on-device 14px Liquid Glass Scrubber (x=80..1840, top=842) -->
      <include content="OSDProgress"><param name="top">842</param></include>
    </control>
  </controls>
</window>
