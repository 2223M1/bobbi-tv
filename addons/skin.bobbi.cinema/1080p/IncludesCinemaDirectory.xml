<?xml version='1.0' encoding='utf-8'?>
<includes>
  <variable name="BobiStreamLanguage">
    <value condition="String.IsEqual(ListItem.Property(language),chi) | String.IsEqual(ListItem.Property(language),zho) | String.IsEqual(ListItem.Property(language),zh) | String.IsEqual(ListItem.Property(language),cmn)">中文</value>
    <value condition="String.IsEqual(ListItem.Property(language),jpn) | String.IsEqual(ListItem.Property(language),ja)">日语</value>
    <value condition="String.IsEqual(ListItem.Property(language),eng) | String.IsEqual(ListItem.Property(language),en)">英语</value>
    <value condition="String.IsEqual(ListItem.Property(language),kor) | String.IsEqual(ListItem.Property(language),ko)">韩语</value>
    <value condition="String.IsEqual(ListItem.Property(language),yue)">粤语</value>
    <value condition="String.IsEqual(ListItem.Property(language),fra) | String.IsEqual(ListItem.Property(language),fre) | String.IsEqual(ListItem.Property(language),fr)">法语</value>
    <value condition="String.IsEqual(ListItem.Property(language),deu) | String.IsEqual(ListItem.Property(language),ger) | String.IsEqual(ListItem.Property(language),de)">德语</value>
    <value>$VAR[Label_StreamLanguage]</value>
  </variable>
  <variable name="BobiStreamCaption">
    <value condition="String.Contains(ListItem.Label2,zh-hans)">简体中文</value>
    <value condition="String.Contains(ListItem.Label2,zh-hant)">繁体中文</value>
    <value>$VAR[BobiStreamLanguage]$INFO[ListItem.Label2, · ]</value>
  </variable>
  <variable name="CinemaDirectoryTitle">
    <value condition="!String.IsEmpty(ListItem.Property(AM6B.Episode.Title.zh))">$INFO[ListItem.Property(AM6B.Episode.Title.zh)]</value>
    <value condition="!String.IsEmpty(ListItem.Property(AM6B.Title.zh))">$INFO[ListItem.Property(AM6B.Title.zh)]</value>
    <value condition="!String.IsEmpty(ListItem.Title)">$INFO[ListItem.Title]</value>
    <value>$INFO[ListItem.Label]</value>
  </variable>
  <variable name="BobiDetailAction">
    <value condition="ListItem.IsFolder">选择剧集</value>
    <value>选择片源</value>
  </variable>
  <variable name="BobiDirectoryHeading">
    <value condition="Container.Content(episodes)">选择剧集</value>
    <value condition="Container.Content(seasons)">选择季数</value>
    <value condition="!String.IsEmpty(Container.PluginCategory)">$INFO[Container.PluginCategory]</value>
    <value>影片与目录</value>
  </variable>
