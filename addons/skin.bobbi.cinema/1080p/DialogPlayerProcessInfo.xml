<?xml version='1.0' encoding='utf-8'?>
<window>
  <depth>DepthOSD</depth>
  <include content="PanelOpen"><param name="slide">0,18</param></include>
  <controls>
    <control type="image">
      <left>0</left><top>0</top><width>1920</width><height>1080</height>
      <texture colordiffuse="8C000000">bobbi/white.png</texture>
    </control>

    <!-- on-device 2x2 Liquid Glass Bento Telemetry Modal (1760x952 @ x=80, y=64) -->
    <control type="group">
      <left>80</left><top>64</top><width>1760</width><height>952</height>
      <control type="image">
        <left>-48</left><top>-48</top><width>1856</width><height>1048</height>
        <texture border="64">bobbi/glass/modal-shadow.png</texture>
      </control>
      <control type="image">
        <left>0</left><top>0</top><width>1760</width><height>952</height>
        <texture colordiffuse="$VAR[BobbiMattePanelColor]" border="46">bobbi/glass/modal-glass.png</texture>
      </control>
      <control type="image">
        <left>0</left><top>0</top><width>1760</width><height>952</height>
        <texture colordiffuse="glass_rim" border="46">bobbi/glass/modal-glass-rim.png</texture>
      </control>

      <!-- Header -->
      <control type="label">
        <left>44</left><top>28</top><width>920</width><height>48</height>
        <label>信号与编码</label>
        <font>Head40</font><textcolor>FFFFFFFF</textcolor><aligny>center</aligny>
      </control>
      <control type="label">
        <left>44</left><top>76</top><width>1120</width><height>32</height>
        <label>$VAR[PlayerTitle]   ·   返回 关闭</label>
        <font>Meta24</font><textcolor>$VAR[BobbiPanelCaption]</textcolor><aligny>center</aligny>
      </control>
      <control type="grouplist">
        <left>1160</left><top>36</top><width>556</width><height>34</height>
        <orientation>horizontal</orientation><align>right</align><itemgap>10</itemgap>
        <usecontrolcoords>true</usecontrolcoords>
        <include content="TechChip">
          <param name="label">$VAR[ResolutionLabel]</param>
          <param name="visible">!String.IsEmpty(VideoPlayer.VideoResolution)</param>
        </include>
        <include content="TechChip">
          <param name="label">$VAR[HDRLabel]</param>
          <param name="visible">Player.HasVideo</param>
        </include>
        <include content="TechChip">
          <param name="label">$VAR[AudioCodecLabel]$INFO[VideoPlayer.AudioChannels, ,ch]</param>
          <param name="visible">!String.IsEmpty(VideoPlayer.AudioCodec)</param>
        </include>
      </control>

      <!-- Bento Card 1 (Top-Left): 视频解码 -->
      <control type="group">
        <left>36</left><top>124</top><width>832</width><height>392</height>
        <control type="image">
          <left>0</left><top>0</top><width>832</width><height>392</height>
          <texture colordiffuse="14FFFFFF" border="26">bobbi/glass/row-glass.png</texture>
        </control>
        <control type="image">
          <left>0</left><top>0</top><width>832</width><height>392</height>
          <texture colordiffuse="55FFFFFF" border="26">bobbi/glass/row-glass-rim.png</texture>
        </control>
        <control type="image">
          <left>28</left><top>22</top><width>26</width><height>26</height>
          <texture colordiffuse="FFFFFFFF">bobbi/glass/icons/film.png</texture>
        </control>
        <control type="label">
          <left>66</left><top>18</top><width>730</width><height>34</height>
          <label>视频解码</label>
          <font>Head30</font><textcolor>FFFFFFFF</textcolor><aligny>center</aligny>
        </control>
        <control type="grouplist">
          <left>28</left><top>64</top><width>776</width><height>312</height>
          <orientation>vertical</orientation><itemgap>2</itemgap><usecontrolcoords>true</usecontrolcoords>
          <include content="OSDTelemetryRow">
            <param name="label">分辨率</param>
            <param name="value">$INFO[Player.Process(videowidth)]$INFO[Player.Process(videoheight),×,]$INFO[Player.Process(videoscantype), ,]</param>
            <param name="visible">!String.IsEmpty(Player.Process(videowidth))</param>
          </include>
          <include content="OSDTelemetryRow">
            <param name="label">帧率</param>
            <param name="value">$INFO[Player.Process(videofps),, fps]</param>
            <param name="visible">!String.IsEmpty(Player.Process(videofps))</param>
          </include>
          <include content="OSDTelemetryRow">
            <param name="label">编码</param>
            <param name="value">$INFO[VideoPlayer.VideoCodec]$INFO[Player.Process(video.bit.depth),  ·  , bit]</param>
            <param name="visible">!String.IsEmpty(VideoPlayer.VideoCodec)</param>
          </include>
          <include content="OSDTelemetryRow">
            <param name="label">解码器</param>
            <param name="value">$INFO[Player.Process(videodecoder)]</param>
            <param name="visible">!String.IsEmpty(Player.Process(videodecoder))</param>
          </include>
          <include content="OSDTelemetryRow">
            <param name="label">像素格式</param>
            <param name="value">$INFO[Player.Process(amlogic.pixformat)]</param>
            <param name="visible">!String.IsEmpty(Player.Process(amlogic.pixformat))</param>
          </include>
          <include content="OSDTelemetryRow">
            <param name="label">画面比例</param>
            <param name="value">$INFO[Player.Process(videodar)]</param>
            <param name="visible">!String.IsEmpty(Player.Process(videodar))</param>
          </include>
          <include content="OSDTelemetryRow">
            <param name="label">实时码率</param>
            <param name="value">$INFO[Player.Process(video.live.mibit.rate),, Mbps]</param>
            <param name="visible">!String.IsEmpty(Player.Process(video.live.mibit.rate))</param>
          </include>
          <include content="OSDTelemetryRow">
            <param name="label">解码队列</param>
            <param name="value">$INFO[Player.Process(video.queue.level),,%]$INFO[Player.Process(video.queue.data.level),  ·  数据 ,%]</param>
            <param name="visible">!String.IsEmpty(Player.Process(video.queue.level))</param>
          </include>
        </control>
      </control>

      <!-- Bento Card 2 (Bottom-Left): HDR 与杜比视界 -->
      <control type="group">
        <left>36</left><top>532</top><width>832</width><height>388</height>
        <control type="image">
          <left>0</left><top>0</top><width>832</width><height>388</height>
          <texture colordiffuse="14FFFFFF" border="26">bobbi/glass/row-glass.png</texture>
        </control>
        <control type="image">
          <left>0</left><top>0</top><width>832</width><height>388</height>
          <texture colordiffuse="55FFFFFF" border="26">bobbi/glass/row-glass-rim.png</texture>
        </control>
        <control type="image">
          <left>28</left><top>22</top><width>26</width><height>26</height>
          <texture colordiffuse="FFFFFFFF">bobbi/glass/icons/sparkles.png</texture>
        </control>
        <control type="label">
          <left>66</left><top>18</top><width>730</width><height>34</height>
          <label>HDR 与杜比视界</label>
          <font>Head30</font><textcolor>FFFFFFFF</textcolor><aligny>center</aligny>
        </control>
        <control type="grouplist">
          <left>28</left><top>60</top><width>776</width><height>316</height>
          <orientation>vertical</orientation><itemgap>1</itemgap><usecontrolcoords>true</usecontrolcoords>
          <include content="OSDTelemetryRow">
            <param name="h">34</param>
            <param name="label">片源类型</param>
            <param name="value">$VAR[BobbiSourceHDR]</param>
            <param name="visible">!String.IsEmpty(Player.Process(video.source.hdr.type))</param>
          </include>
          <include content="OSDTelemetryRow">
            <param name="h">34</param>
            <param name="label">输出类型</param>
            <param name="value">$INFO[Player.Process(video.hdr.type)]</param>
            <param name="visible">!String.IsEmpty(Player.Process(video.hdr.type))</param>
          </include>
          <include content="OSDTelemetryRow">
            <param name="h">34</param>
            <param name="label">杜比视界</param>
            <param name="value">Profile $INFO[Player.Process(video.dovi.profile)]$INFO[Player.Process(video.dovi.meta.version),  ·  CM ,]</param>
            <param name="visible">Integer.IsGreater(Player.Process(video.dovi.profile),0)</param>
          </include>
          <include content="OSDTelemetryRow">
            <param name="h">34</param>
            <param name="label">L1 亮度</param>
            <param name="value">$INFO[Player.Process(video.dovi.l1.min.nits),最小 , nits]$INFO[Player.Process(video.dovi.l1.avg.nits),  ·  平均 , nits]$INFO[Player.Process(video.dovi.l1.max.nits),  ·  最大 , nits]</param>
            <param name="visible">Integer.IsGreater(Player.Process(video.dovi.profile),0)</param>
          </include>
          <include content="OSDTelemetryRow">
            <param name="h">34</param>
            <param name="label">L5 黑边</param>
            <param name="value">$INFO[Player.Process(video.dovi.l5.top.offset),上 ,]$INFO[Player.Process(video.dovi.l5.bottom.offset),  下 ,]$INFO[Player.Process(video.dovi.l5.left.offset),  左 ,]$INFO[Player.Process(video.dovi.l5.right.offset),  右 ,]</param>
            <param name="visible">String.IsEqual(Player.Process(video.dovi.has.l5),1)</param>
          </include>
          <include content="OSDTelemetryRow">
            <param name="h">34</param>
            <param name="label">L6 / MaxCLL</param>
            <param name="value">$INFO[Player.Process(video.dovi.l6.max.cll),MaxCLL , nits]$INFO[Player.Process(video.dovi.l6.max.fall),  ·  MaxFALL , nits]</param>
            <param name="visible">Integer.IsGreater(Player.Process(video.dovi.profile),0)</param>
          </include>
          <include content="OSDTelemetryRow">
            <param name="h">34</param>
            <param name="label">母版亮度</param>
            <param name="value">$INFO[Player.Process(video.hdr.min.lum),, ]$INFO[Player.Process(video.hdr.max.lum),– , nits]$INFO[Player.Process(video.hdr.colour.primaries),  ·  ,]</param>
            <param name="visible">!String.IsEqual(Player.Process(video.hdr.type),SDR) + !String.IsEmpty(Player.Process(video.hdr.max.lum))</param>
          </include>
          <include content="OSDTelemetryRow">
            <param name="h">34</param>
            <param name="label">MaxCLL / FALL</param>
            <param name="value">$INFO[Player.Process(video.hdr.max.cll),,]$INFO[Player.Process(video.hdr.max.fall), / , nits]</param>
            <param name="visible">!String.IsEqual(Player.Process(video.hdr.type),SDR) + !String.IsEmpty(Player.Process(video.hdr.max.cll))</param>
          </include>
          <include content="OSDTelemetryRow">
            <param name="h">34</param>
            <param name="label">EOTF / 色域</param>
            <param name="value">$INFO[Player.Process(amlogic.eoft_gamut)]</param>
            <param name="visible">!String.IsEmpty(Player.Process(amlogic.eoft_gamut))</param>
          </include>
        </control>
      </control>

      <!-- Bento Card 3 (Top-Right): 音频与字幕 -->
      <control type="group">
        <left>892</left><top>124</top><width>832</width><height>392</height>
        <control type="image">
          <left>0</left><top>0</top><width>832</width><height>392</height>
          <texture colordiffuse="14FFFFFF" border="26">bobbi/glass/row-glass.png</texture>
        </control>
        <control type="image">
          <left>0</left><top>0</top><width>832</width><height>392</height>
          <texture colordiffuse="55FFFFFF" border="26">bobbi/glass/row-glass-rim.png</texture>
        </control>
        <control type="image">
          <left>28</left><top>22</top><width>26</width><height>26</height>
          <texture colordiffuse="FFFFFFFF">bobbi/glass/icons/waveform.png</texture>
        </control>
        <control type="label">
          <left>66</left><top>18</top><width>730</width><height>34</height>
          <label>音频与字幕</label>
          <font>Head30</font><textcolor>FFFFFFFF</textcolor><aligny>center</aligny>
        </control>
        <control type="grouplist">
          <left>28</left><top>68</top><width>776</width><height>304</height>
          <orientation>vertical</orientation><itemgap>8</itemgap><usecontrolcoords>true</usecontrolcoords>
          <include content="OSDTelemetryRow">
            <param name="h">42</param>
            <param name="label">音频编码</param>
            <param name="value">$VAR[AudioCodecLabel]$INFO[Player.Process(audiochannels),  ·  ,]</param>
            <param name="visible">!String.IsEmpty(VideoPlayer.AudioCodec)</param>
          </include>
          <include content="OSDTelemetryRow">
            <param name="h">42</param>
            <param name="label">采样规格</param>
            <param name="value">$INFO[Player.Process(audiosamplerate),, Hz]$INFO[Player.Process(audiobitspersample),  ·  , bit]</param>
            <param name="visible">!String.IsEmpty(Player.Process(audiosamplerate))</param>
          </include>
          <include content="OSDTelemetryRow">
            <param name="h">42</param>
            <param name="label">音频解码器</param>
            <param name="value">$INFO[Player.Process(audiodecoder)]</param>
            <param name="visible">!String.IsEmpty(Player.Process(audiodecoder))</param>
          </include>
          <include content="OSDTelemetryRow">
            <param name="h">42</param>
            <param name="label">实时码率</param>
            <param name="value">$INFO[Player.Process(audio.live.kibit.rate),, kbps]</param>
            <param name="visible">!String.IsEmpty(Player.Process(audio.live.kibit.rate))</param>
          </include>
          <include content="OSDTelemetryRow">
            <param name="h">42</param>
            <param name="label">当前字幕</param>
            <param name="value">$VAR[SubtitleLabel]</param>
            <param name="visible">Player.HasVideo</param>
          </include>
        </control>
      </control>

      <!-- Bento Card 4 (Bottom-Right): 输出与系统 -->
      <control type="group">
        <left>892</left><top>532</top><width>832</width><height>388</height>
        <control type="image">
          <left>0</left><top>0</top><width>832</width><height>388</height>
          <texture colordiffuse="14FFFFFF" border="26">bobbi/glass/row-glass.png</texture>
        </control>
        <control type="image">
          <left>0</left><top>0</top><width>832</width><height>388</height>
          <texture colordiffuse="55FFFFFF" border="26">bobbi/glass/row-glass-rim.png</texture>
        </control>
        <control type="image">
          <left>28</left><top>22</top><width>26</width><height>26</height>
          <texture colordiffuse="FFFFFFFF">bobbi/glass/icons/cpu.png</texture>
        </control>
        <control type="label">
          <left>66</left><top>18</top><width>730</width><height>34</height>
          <label>输出与系统</label>
          <font>Head30</font><textcolor>FFFFFFFF</textcolor><aligny>center</aligny>
        </control>
        <control type="grouplist">
          <left>28</left><top>68</top><width>776</width><height>300</height>
          <orientation>vertical</orientation><itemgap>8</itemgap><usecontrolcoords>true</usecontrolcoords>
          <include content="OSDTelemetryRow">
            <param name="h">42</param>
            <param name="label">显示模式</param>
            <param name="value">$INFO[Player.Process(amlogic.displaymode)]</param>
            <param name="visible">!String.IsEmpty(Player.Process(amlogic.displaymode))</param>
          </include>
          <include content="OSDTelemetryRow">
            <param name="h">42</param>
            <param name="label">渲染帧率</param>
            <param name="value">$INFO[System.FPS,, fps]</param>
            <param name="visible">Player.HasVideo</param>
          </include>
          <include content="OSDTelemetryRow">
            <param name="h">42</param>
            <param name="label">缓冲水位</param>
            <param name="value">$INFO[Player.CacheLevel,,%]</param>
            <param name="visible">Player.HasVideo</param>
          </include>
          <include content="OSDTelemetryRow">
            <param name="h">42</param>
            <param name="label">处理器</param>
            <param name="value">$INFO[System.CPUUsage]$INFO[System.CPUTemperature,  ·  ,]</param>
            <param name="visible">Player.HasVideo</param>
          </include>
          <include content="OSDTelemetryRow">
            <param name="h">42</param>
            <param name="label">网络吞吐</param>
            <param name="value">$INFO[Skin.String(netspeed)]</param>
            <param name="visible">!String.IsEmpty(Skin.String(netspeed))</param>
          </include>
        </control>
      </control>
    </control>
  </controls>
</window>
