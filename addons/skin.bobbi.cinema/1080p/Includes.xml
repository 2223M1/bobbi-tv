          <onleft>noop</onleft>
          <include content="TabButton"><param name="id" value="9711" /><param name="label" value="首页" /><param name="active" value="String.IsEqual(Window(Home).Property(BobiSection),home)" /><param name="action" value="ActivateWindow(Home)" /><param name="section" value="home" /></include>
