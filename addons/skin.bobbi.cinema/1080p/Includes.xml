        <control type="grouplist" id="9701">
          <left>352</left><top>32</top><width>1080</width><height>60</height>
          <orientation>horizontal</orientation>
          <itemgap>8</itemgap>
          <scrolltime>0</scrolltime>
          <onup>noop</onup>
          <ondown>$PARAM[down]</ondown>
