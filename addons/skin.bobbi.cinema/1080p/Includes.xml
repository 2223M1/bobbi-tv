      </control>
    </definition>
  </include>

  <!-- text-only pill, a direct grouplist child (keeps Kodi core ids clickable) -->
  <include name="TextPill">
    <param name="id" />
    <param name="label" />
    <param name="width">220</param>
    <param name="visible">true</param>
    <param name="onclick">noop</param>
    <param name="onclick2">noop</param>
    <definition>
      <control type="button" id="$PARAM[id]">
        <width>$PARAM[width]</width><height>72</height>
        <onclick>$PARAM[onclick]</onclick>
        <onclick>$PARAM[onclick2]</onclick>
        <label>$PARAM[label]</label>
        <font>Button28</font><textcolor>text</textcolor><focusedcolor>on_focus</focusedcolor><disabledcolor>text_disabled</disabledcolor>
        <align>center</align><aligny>center</aligny>
        <texturefocus colordiffuse="focus" border="32">bobi/pill.png</texturefocus>
        <texturenofocus colordiffuse="surface_hi" border="32">bobi/pill.png</texturenofocus>
        <visible>$PARAM[visible]</visible>
      </control>
    </definition>
  </include>

  <!-- ===== poster card (2:3) used in rails, walls, related rows ===== -->
  <include name="PosterArt">
    <param name="w">232</param>
    <param name="h">348</param>
    <param name="art">$VAR[PosterImage]</param>
    <definition>
      <!-- missing-art card: surface + icon + title, so a hole never looks broken -->
      <control type="image">
        <left>0</left><top>0</top><width>$PARAM[w]</width><height>$PARAM[h]</height>
        <texture colordiffuse="surface_hi" border="14">bobi/r14.png</texture>
      </control>
      <control type="image">
        <left>20</left><top>20</top><width>40</width><height>40</height>
        <texture colordiffuse="text3">bobi/icons/film.png</texture>
      </control>
      <control type="textbox">
        <left>20</left><top>76</top><width>$PARAM[w]</width><height>180</height>
        <label>$VAR[TitlePrimary]</label>
        <font>Label28</font><textcolor>text2</textcolor>
        <animation effect="zoom" end="83,100" time="0" condition="true">Conditional</animation>
      </control>
      <control type="image">
        <left>0</left><top>0</top><width>$PARAM[w]</width><height>$PARAM[h]</height>
        <aspectratio scalediffuse="false">scale</aspectratio>
        <texture background="true" diffuse="bobi/mask-$PARAM[w]x$PARAM[h].png">$PARAM[art]</texture>
        <include>ArtFade</include>
      </control>
    </definition>
  </include>
  <!-- art badges: in-progress bar (bottom), playing (accent), watched (tick) -->
  <include name="ArtBadges">
    <param name="w">232</param>
    <param name="h">348</param>
    <param name="barw">200</param>
    <param name="bary">330</param>
    <definition>
      <control type="progress">
        <left>16</left><top>$PARAM[bary]</top><width>$PARAM[barw]</width><height>6</height>
        <info>ListItem.Property(PercentPlayed)</info>
        <texturebg colordiffuse="99000000">bobi/white.png</texturebg>
        <midtexture colordiffuse="accent">bobi/white.png</midtexture>
        <visible>Integer.IsGreater(ListItem.Property(PercentPlayed),0) + !ListItem.IsPlaying</visible>
      </control>
      <control type="progress">
        <left>16</left><top>$PARAM[bary]</top><width>$PARAM[barw]</width><height>6</height>
        <info>ListItem.PercentPlayed</info>
        <texturebg colordiffuse="99000000">bobi/white.png</texturebg>
        <midtexture colordiffuse="accent">bobi/white.png</midtexture>
        <visible>String.IsEmpty(ListItem.Property(PercentPlayed)) + Integer.IsGreater(ListItem.PercentPlayed,0) + !ListItem.IsPlaying</visible>
      </control>
      <control type="group">
        <visible>ListItem.IsPlaying</visible>
        <control type="image">
          <left>12</left><top>12</top><width>48</width><height>48</height>
          <texture colordiffuse="accent">bobi/pill.png</texture>
        </control>
        <control type="image">
          <left>22</left><top>22</top><width>28</width><height>28</height>
          <texture colordiffuse="on_focus">bobi/icons/playing.png</texture>
        </control>
      </control>
      <control type="group">
        <visible>Integer.IsGreater(ListItem.PlayCount,0) + !ListItem.IsPlaying + !Integer.IsGreater(ListItem.PercentPlayed,0) + !Integer.IsGreater(ListItem.Property(PercentPlayed),0)</visible>
        <control type="image">
          <left>12</left><top>12</top><width>40</width><height>40</height>
          <texture colordiffuse="CC0A0B0E">bobi/pill.png</texture>
        </control>
        <control type="image">
          <left>20</left><top>20</top><width>24</width><height>24</height>
          <texture colordiffuse="ok">bobi/icons/check.png</texture>
        </control>
      </control>
    </definition>
  </include>
  <include name="FocusRing">
    <param name="x">-8</param>
    <param name="y">-8</param>
    <param name="w">248</param>
    <param name="h">364</param>
    <definition>
      <control type="image">
        <left>$PARAM[x]</left><top>$PARAM[y]</top><width>$PARAM[w]</width><height>$PARAM[h]</height>
        <texture colordiffuse="focus" border="20">bobi/ring-r14.png</texture>
      </control>
    </definition>
  </include>
  <include name="CardShadow">
    <param name="w">232</param>
    <param name="h">348</param>
    <definition>
      <control type="image">
        <left>-28</left><top>-20</top><width>$PARAM[w]</width><height>$PARAM[h]</height>
        <texture colordiffuse="99000000" border="40">bobi/shadow-r14.png</texture>
      </control>
    </definition>
  </include>

  <!-- ===== text atoms ===== -->
  <include name="SectionTitle">
    <param name="label" />
    <param name="x">96</param>
    <param name="y">0</param>
    <definition>
      <control type="label">
        <left>$PARAM[x]</left><top>$PARAM[y]</top><width>1200</width><height>44</height>
        <label>$PARAM[label]</label>
        <font>Head30</font><textcolor>text</textcolor><aligny>center</aligny>
      </control>
    </definition>
  </include>
  <include name="Chip">
    <param name="label" />
    <param name="visible">true</param>
    <definition>
      <control type="label">
        <width>auto</width><height>36</height>
        <label>$PARAM[label]</label>
        <font>Meta22</font><textcolor>text</textcolor>
        <aligny>center</aligny><textoffsetx>14</textoffsetx>
        <visible>$PARAM[visible]</visible>
      </control>
    </definition>
  </include>

  <!-- ===== state blocks: loading / empty / error ===== -->
  <include name="StateBlock">
    <param name="x">96</param>
    <param name="y">420</param>
    <param name="w">1728</param>
    <param name="loading">false</param>
    <param name="empty">false</param>
    <param name="emptytitle">这里还没有内容</param>
    <param name="emptyhint">按 返回 键回到上一页</param>
    <definition>
      <control type="group">
        <left>$PARAM[x]</left><top>$PARAM[y]</top><width>$PARAM[w]</width>
        <control type="group">
          <visible>$PARAM[loading]</visible>
          <include>FadeVisible</include>
          <control type="image">
            <left>0</left><top>0</top><width>56</width><height>56</height>
            <texture colordiffuse="accent">bobi/spinner.png</texture>
            <animation effect="rotate" end="-360" center="28,28" time="900" loop="true" condition="true">Conditional</animation>
          </control>
          <control type="label">
            <left>80</left><top>0</top><width>1200</width><height>56</height>
            <label>正在加载…</label><font>Label30</font><textcolor>text2</textcolor><aligny>center</aligny>
          </control>
        </control>
        <control type="group">
          <visible>$PARAM[empty]</visible>
          <include>FadeVisible</include>
          <control type="image">
            <left>0</left><top>0</top><width>56</width><height>56</height>
            <texture colordiffuse="text3">bobi/icons/empty.png</texture>
          </control>
          <control type="label">
            <left>80</left><top>-4</top><width>1600</width><height>40</height>
            <label>$PARAM[emptytitle]</label><font>Head30</font><textcolor>text</textcolor>
          </control>
          <control type="label">
            <left>80</left><top>38</top><width>1600</width><height>32</height>
            <label>$PARAM[emptyhint]</label><font>Meta24</font><textcolor>text3</textcolor>
          </control>
        </control>
      </control>
    </definition>
  </include>

  <!-- hint footer with key glyphs -->
  <include name="KeyHint">
    <param name="label" />
    <param name="x">96</param>
    <param name="y">1012</param>
    <param name="w">1728</param>
    <param name="align">left</param>
    <definition>
      <control type="label">
        <left>$PARAM[x]</left><top>$PARAM[y]</top><width>$PARAM[w]</width><height>32</height>
        <label>$PARAM[label]</label>
        <font>Meta22</font><textcolor>text3</textcolor><align>$PARAM[align]</align>
      </control>
    </definition>
  </include>

  <!-- hidden list that keeps a container from going to sleep -->
  <include name="BusyOverlay">
    <control type="group">
      <visible>Window.IsActive(busydialog) | Window.IsActive(busydialognocancel)</visible>
    </control>
  </include>
  <!-- Backend-maintained fallback for windows not yet redesigned. -->
  <include file="Includes_Compatibility.xml" />
</includes>
