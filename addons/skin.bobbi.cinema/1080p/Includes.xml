          <texture colordiffuse="text">bobi/icons/server.png</texture>
          <visible>!Control.HasFocus(9723)</visible>
        </control>
        <control type="image">
          <left>1456</left><top>42</top><width>40</width><height>40</height>
          <texture colordiffuse="on_focus">bobi/icons/server.png</texture>
          <visible>Control.HasFocus(9723)</visible>
          <animation effect="zoom" start="100" end="108" time="140" tween="cubic" easing="out" center="1476,62" reversible="true" condition="Control.HasFocus(9723) + !Skin.HasSetting(BobiReduceMotion)">Conditional</animation>
        </control>
        <control type="button" id="9721">
          <left>1528</left><top>26</top><width>72</width><height>72</height>
          <label />
          <texturefocus colordiffuse="focus">bobi/pill.png</texturefocus>
          <texturenofocus colordiffuse="1FFFFFFF">bobi/pill.png</texturenofocus>
          <onleft>9723</onleft><onright>9722</onright><onup>noop</onup><ondown>$PARAM[down]</ondown>
