        <control type="image">
          <left>1544</left><top>42</top><width>40</width><height>40</height>
          <texture colordiffuse="text">bobi/icons/search.png</texture>
          <visible>!Control.HasFocus(9721)</visible>
        </control>
        <control type="image">
          <left>1544</left><top>42</top><width>40</width><height>40</height>
          <texture colordiffuse="on_focus">bobi/icons/search.png</texture>
          <visible>Control.HasFocus(9721)</visible>
          <animation effect="zoom" start="100" end="108" time="140" tween="cubic" easing="out" center="1564,62" reversible="true" condition="Control.HasFocus(9721) + !Skin.HasSetting(BobiReduceMotion)">Conditional</animation>
        </control>
        <control type="button" id="9722">
          <left>1616</left><top>26</top><width>72</width><height>72</height>
          <label />
          <texturefocus colordiffuse="focus">bobi/pill.png</texturefocus>
          <texturenofocus colordiffuse="1FFFFFFF">bobi/pill.png</texturenofocus>
          <onleft>9721</onleft><onright>noop</onright><onup>noop</onup><ondown>$PARAM[down]</ondown>
          <onclick>ActivateWindow(Settings)</onclick>
          <include content="Lift"><param name="zoom">108</param></include>
        </control>
        <control type="image">
          <left>1632</left><top>42</top><width>40</width><height>40</height>
          <texture colordiffuse="text">bobi/icons/settings.png</texture>
          <visible>!Control.HasFocus(9722)</visible>
