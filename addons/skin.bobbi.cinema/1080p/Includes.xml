        </control>
      </control>
    </definition>
  </include>
  <!-- tab: text pill. focus = white fill; active section (not focused) = accent underline + bright text -->
  <include name="TabButton">
    <param name="id" />
    <param name="label" />
    <param name="active">false</param>
    <param name="action" />
    <param name="path" />
    <param name="directory">false</param>
    <param name="section" />
    <definition>
      <control type="togglebutton" id="$PARAM[id]">
        <width>auto</width><height>60</height>
        <label>$PARAM[label]</label>
        <altlabel>$PARAM[label]</altlabel>
        <font>Label30</font>
        <textcolor>text2</textcolor>
        <focusedcolor>on_focus</focusedcolor>
        <textoffsetx>28</textoffsetx>
        <align>center</align><aligny>center</aligny>
        <texturefocus colordiffuse="focus" border="32">bobi/pill.png</texturefocus>
        <texturenofocus />
        <alttexturefocus colordiffuse="focus" border="32">bobi/pill.png</alttexturefocus>
        <alttexturenofocus colordiffuse="accent" border="30,0,30,0">bobi/tab-underline.png</alttexturenofocus>
        <usealttexture>$PARAM[active]</usealttexture>
        <onclick>SetProperty(BobiSection,$PARAM[section],Home)</onclick>
        <!-- ActivateWindow on an already active Videos window keeps its old
             directory. Dispatch exactly one path update for in-window tabs. -->
        <onclick condition="!$PARAM[directory]">$PARAM[action]</onclick>
        <onclick condition="$PARAM[directory] + Window.IsActive(videos)">Container.Update("$PARAM[path]",replace)</onclick>
        <onclick condition="$PARAM[directory] + !Window.IsActive(videos)">ActivateWindow(Videos,"$PARAM[path]",return)</onclick>
      </control>
    </definition>
  </include>

  <!-- ===== buttons ===== -->
  <!-- pill button with leading icon. focus = white fill + dark icon/text -->
  <include name="PillButton">
    <param name="id" />
    <param name="label" />
    <param name="icon">bobi/icons/play.png</param>
    <param name="width">260</param>
    <param name="visible">true</param>
    <param name="enable">true</param>
    <param name="onclick">noop</param>
    <param name="onclick2">noop</param>
    <param name="onclick3">noop</param>
    <definition>
      <control type="group" id="$PARAM[id]9">
        <width>$PARAM[width]</width><height>72</height>
        <visible>$PARAM[visible]</visible>
        <control type="button" id="$PARAM[id]">
          <left>0</left><top>0</top><width>$PARAM[width]</width><height>72</height>
          <label />
          <texturefocus colordiffuse="focus" border="32">bobi/pill.png</texturefocus>
          <texturenofocus colordiffuse="surface_hi" border="32">bobi/pill.png</texturenofocus>
          <enable>$PARAM[enable]</enable>
          <onclick>$PARAM[onclick]</onclick>
          <onclick>$PARAM[onclick2]</onclick>
          <onclick>$PARAM[onclick3]</onclick>
        </control>
        <control type="image">
          <left>32</left><top>20</top><width>32</width><height>32</height>
          <texture colordiffuse="text">$PARAM[icon]</texture>
          <visible>!Control.HasFocus($PARAM[id])</visible>
        </control>
        <control type="image">
          <left>32</left><top>20</top><width>32</width><height>32</height>
          <texture colordiffuse="on_focus">$PARAM[icon]</texture>
          <visible>Control.HasFocus($PARAM[id])</visible>
        </control>
        <control type="label">
          <left>76</left><top>0</top><width>$PARAM[width]</width><height>72</height>
          <label>$PARAM[label]</label>
          <font>Button28</font><textcolor>text</textcolor><aligny>center</aligny>
          <visible>!Control.HasFocus($PARAM[id])</visible>
        </control>
        <control type="label">
          <left>76</left><top>0</top><width>$PARAM[width]</width><height>72</height>
          <label>$PARAM[label]</label>
          <font>Button28</font><textcolor>on_focus</textcolor><aligny>center</aligny>
          <visible>Control.HasFocus($PARAM[id])</visible>
        </control>
      </control>
    </definition>
  </include>
  <!-- round icon-only button (OSD transport, top bar) -->
  <include name="IconButton">
    <param name="id" />
    <param name="icon" />
    <param name="size">72</param>
    <param name="glyph">36</param>
    <param name="pad">18</param>
    <param name="visible">true</param>
    <param name="onclick">noop</param>
    <param name="onclick2">noop</param>
    <param name="label" />
    <definition>
      <control type="group" id="$PARAM[id]9">
        <width>$PARAM[size]</width><height>$PARAM[size]</height>
        <visible>$PARAM[visible]</visible>
        <control type="button" id="$PARAM[id]">
          <left>0</left><top>0</top><width>$PARAM[size]</width><height>$PARAM[size]</height>
          <label />
          <texturefocus colordiffuse="focus">bobi/pill.png</texturefocus>
          <texturenofocus colordiffuse="33FFFFFF">bobi/pill.png</texturenofocus>
          <onclick>$PARAM[onclick]</onclick>
          <onclick>$PARAM[onclick2]</onclick>
          <include>Lift</include>
        </control>
        <control type="image">
          <left>$PARAM[pad]</left><top>$PARAM[pad]</top>
          <width>$PARAM[glyph]</width><height>$PARAM[glyph]</height>
          <texture colordiffuse="text">$PARAM[icon]</texture>
          <visible>!Control.HasFocus($PARAM[id])</visible>
        </control>
        <control type="image">
          <left>$PARAM[pad]</left><top>$PARAM[pad]</top>
          <width>$PARAM[glyph]</width><height>$PARAM[glyph]</height>
          <texture colordiffuse="on_focus">$PARAM[icon]</texture>
          <visible>Control.HasFocus($PARAM[id])</visible>
          <include>Lift</include>
        </control>
      </control>
    </definition>
  </include>

  <!-- ===== static-list item layouts =====
       Button rows are lists with <content> items so Kodi owns focus movement (wrapped
       buttons inside grouplists do not navigate). Item fields: label, label2, icon,
       property(primary) for the accent pill. -->
  <include name="RoundItem">
    <param name="size">88</param>
    <param name="glyph">40</param>
    <param name="pad">24</param>
    <param name="list" />
    <param name="focused">false</param>
    <definition>
      <control type="image">
        <left>0</left><top>0</top><width>$PARAM[size]</width><height>$PARAM[size]</height>
        <texture colordiffuse="40FFFFFF">bobi/pill.png</texture>
        <visible>!$PARAM[focused] | !Control.HasFocus($PARAM[list])</visible>
      </control>
      <control type="group">
        <visible>$PARAM[focused] + Control.HasFocus($PARAM[list])</visible>
        <include content="Lift"><param name="zoom">108</param></include>
        <control type="image">
          <left>0</left><top>0</top><width>$PARAM[size]</width><height>$PARAM[size]</height>
          <texture colordiffuse="focus">bobi/pill.png</texture>
        </control>
        <control type="image">
          <left>$PARAM[pad]</left><top>$PARAM[pad]</top><width>$PARAM[glyph]</width><height>$PARAM[glyph]</height>
          <texture colordiffuse="on_focus">$INFO[ListItem.Icon]</texture>
        </control>
      </control>
      <control type="image">
        <left>$PARAM[pad]</left><top>$PARAM[pad]</top><width>$PARAM[glyph]</width><height>$PARAM[glyph]</height>
        <texture colordiffuse="text">$INFO[ListItem.Icon]</texture>
        <visible>!$PARAM[focused] | !Control.HasFocus($PARAM[list])</visible>
      </control>
    </definition>
  </include>

  <include name="ChipItem">
    <param name="w">260</param>
    <param name="h">64</param>
    <param name="list" />
    <param name="focused">false</param>
