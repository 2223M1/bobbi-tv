<?xml version='1.0' encoding='utf-8'?>
<includes>
  <include file="Defaults.xml" />
  <include file="Variables.xml" />
  <include file="Includes_Titles.xml" />
  <include file="Includes_Views.xml" />
  <include file="Includes_Home.xml" />
  <include file="Includes_OSD.xml" />
  <include file="Includes_Dialogs.xml" />

  <!-- ===== depth constants (Kodi stereo depth; keep 0 for 2D) ===== -->
  <constant name="DepthBackground">-0.2</constant>
  <constant name="DepthContent">0.0</constant>
  <constant name="DepthDialog">0.1</constant>
  <constant name="DepthOSD">0.15</constant>

  <!-- ===== layout constants ===== -->
  <constant name="SafeX">96</constant>
  <constant name="SafeR">1824</constant>
  <constant name="ContentW">1728</constant>

  <!-- ===== motion ===== -->
  <include name="Lift">
    <param name="center">auto</param>
    <param name="zoom">105</param>
    <definition>
      <animation effect="zoom" start="100" end="$PARAM[zoom]" time="140" tween="cubic" easing="out" center="$PARAM[center]" reversible="true" condition="!Skin.HasSetting(BobiReduceMotion)">Focus</animation>
    </definition>
  </include>
  <include name="PageOpen">
    <animation effect="fade" start="0" end="100" time="200" tween="cubic" easing="out" condition="!Skin.HasSetting(BobiReduceMotion)">WindowOpen</animation>
    <animation effect="fade" start="100" end="0" time="120" tween="cubic" easing="in" condition="!Skin.HasSetting(BobiReduceMotion)">WindowClose</animation>
  </include>
  <include name="PanelOpen">
    <param name="slide">0,24</param>
    <definition>
      <animation type="WindowOpen" reversible="false" condition="!Skin.HasSetting(BobiReduceMotion)">
        <effect type="fade" start="0" end="100" time="160" tween="cubic" easing="out" />
        <effect type="slide" start="$PARAM[slide]" end="0,0" time="200" tween="cubic" easing="out" />
      </animation>
      <animation type="WindowClose" reversible="false" condition="!Skin.HasSetting(BobiReduceMotion)">
        <effect type="fade" start="100" end="0" time="120" tween="cubic" easing="in" />
        <effect type="slide" start="0,0" end="$PARAM[slide]" time="120" tween="cubic" easing="in" />
      </animation>
    </definition>
  </include>
  <include name="FadeVisible">
    <param name="time">160</param>
    <definition>
      <animation effect="fade" time="$PARAM[time]" tween="cubic" easing="out">VisibleChange</animation>
    </definition>
  </include>
  <include name="ArtFade">
    <fadetime>220</fadetime>
  </include>

  <!-- ===== canvas & backdrop ===== -->
  <include name="Canvas">
    <control type="image">
      <left>0</left><top>0</top><width>1920</width><height>1080</height>
      <texture colordiffuse="bg">bobi/white.png</texture>
    </control>
  </include>
  <!-- full-bleed art on the right, readable scrim on the left/bottom -->
  <include name="Backdrop">
    <param name="art" />
    <param name="visible">true</param>
    <param name="dim">FF</param>
    <definition>
      <control type="group">
        <visible>$PARAM[visible]</visible>
        <control type="image">
          <left>480</left><top>0</top><width>1440</width><height>810</height>
          <aspectratio>scale</aspectratio>
          <texture background="true">$PARAM[art]</texture>
          <include>ArtFade</include>
        </control>
        <control type="image">
          <left>480</left><top>0</top><width>1100</width><height>810</height>
          <texture colordiffuse="bg">bobi/scrim-left.png</texture>
        </control>
        <control type="image">
          <left>0</left><top>0</top><width>560</width><height>810</height>
          <texture colordiffuse="bg">bobi/white.png</texture>
        </control>
        <control type="image">
          <left>0</left><top>420</top><width>1920</width><height>400</height>
          <texture colordiffuse="bg">bobi/scrim-bottom.png</texture>
        </control>
        <control type="image">
          <left>0</left><top>0</top><width>1920</width><height>180</height>
          <texture colordiffuse="bg">bobi/scrim-top.png</texture>
        </control>
      </control>
    </definition>
  </include>
  <include name="DialogScrim">
    <control type="image">
      <left>0</left><top>0</top><width>1920</width><height>1080</height>
      <texture colordiffuse="scrim">bobi/white.png</texture>
      <animation effect="fade" start="0" end="100" time="160">WindowOpen</animation>
      <animation effect="fade" start="100" end="0" time="120">WindowClose</animation>
    </control>
  </include>

