        <control type="button" id="9723">
          <left>1440</left><top>26</top><width>72</width><height>72</height>
          <label />
          <texturefocus colordiffuse="focus">bobi/pill.png</texturefocus>
          <texturenofocus colordiffuse="1FFFFFFF">bobi/pill.png</texturenofocus>
          <onleft>9701</onleft><onright>9721</onright><onup>noop</onup><ondown>$PARAM[down]</ondown>
          <onclick>ActivateWindow(Videos,"plugin://plugin.video.bobbi.library/",return)</onclick>
