<?xml version="1.0" encoding="utf-8"?>
<!-- Resume prompt (ResumeDialog). Python sets both button labels. -->
<window>
  <defaultcontrol always="true">1002</defaultcontrol>
  <coordinates><left>0</left><top>0</top></coordinates>
  <animation effect="fade" start="0" end="100" time="160">WindowOpen</animation>
  <animation effect="fade" start="100" end="0" time="120">WindowClose</animation>
  <controls>
    <control type="image">
      <left>0</left><top>0</top><width>1920</width><height>1080</height>
      <texture colordiffuse="B3000000">bobi/white.png</texture>
    </control>
    <control type="group">
      <left>640</left><top>372</top>
      <animation type="WindowOpen" reversible="false">
        <effect type="slide" start="0,16" end="0,0" time="200" tween="cubic" easing="out" />
      </animation>
      <control type="image">
        <left>0</left><top>0</top><width>640</width><height>336</height>
        <texture colordiffuse="FF15171C" border="20">bobi/r20.png</texture>
      </control>
      <control type="label">
        <left>48</left><top>36</top><width>544</width><height>56</height>
        <label>继续观看？</label>
        <font>Head40</font><textcolor>FFF5F3EF</textcolor><aligny>center</aligny>
      </control>
      <control type="grouplist">
        <left>48</left><top>120</top><width>544</width><height>176</height>
        <orientation>vertical</orientation><itemgap>16</itemgap>
        <control type="button" id="1002">
          <width>544</width><height>76</height>
          <font>Button28</font><textcolor>FFF5F3EF</textcolor><focusedcolor>FF0A0B0E</focusedcolor>
          <align>center</align><aligny>center</aligny>
          <texturefocus colordiffuse="FFFFFFFF" border="38">bobi/pill.png</texturefocus>
          <texturenofocus colordiffuse="FF2A2E37" border="38">bobi/pill.png</texturenofocus>
        </control>
        <control type="button" id="1003">
          <width>544</width><height>76</height>
          <font>Button28</font><textcolor>FFF5F3EF</textcolor><focusedcolor>FF0A0B0E</focusedcolor>
          <align>center</align><aligny>center</aligny>
          <texturefocus colordiffuse="FFFFFFFF" border="38">bobi/pill.png</texturefocus>
          <texturenofocus colordiffuse="FF2A2E37" border="38">bobi/pill.png</texturenofocus>
        </control>
      </control>
    </control>
  </controls>
</window>
