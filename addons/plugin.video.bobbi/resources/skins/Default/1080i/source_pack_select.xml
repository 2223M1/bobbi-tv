<?xml version='1.0' encoding='utf-8'?>
<window type="dialog">
  <defaultcontrol>1000</defaultcontrol>
  <animation effect="fade" start="0" end="100" time="180" tween="quadratic" easing="out" condition="!Skin.HasSetting(BobiReduceMotion)" reversible="true">WindowOpen</animation>
  <animation effect="fade" start="100" end="0" time="120" tween="quadratic" easing="out" condition="!Skin.HasSetting(BobiReduceMotion)" reversible="true">WindowClose</animation>
  <controls>
    <control type="image">
      <left>0</left>
      <top>0</top>
      <width>1920</width>
      <height>1080</height>
      <texture colordiffuse="FF080808">am6b/white.png</texture>
    </control>
    <control type="group">
      <left>1560</left>
      <top>45</top>
      <width>158</width>
      <height>48</height>
      <description>BobiCompactWordmark</description>
      <control type="image">
        <left>0</left>
        <top>10</top>
        <width>3</width>
        <height>27</height>
        <texture colordiffuse="FFE50924">am6b/white.png</texture>
      </control>
      <control type="label">
        <left>14</left>
        <top>0</top>
        <width>80</width>
        <height>48</height>
        <label>波比</label>
        <font>BobiLogo</font>
        <textcolor>FFF4F4F5</textcolor>
        <aligny>center</aligny>
      </control>
      <control type="label">
        <left>97</left>
        <top>1</top>
        <width>52</width>
        <height>48</height>
        <label>TV</label>
        <font>BobiLogoLatin</font>
        <textcolor>FFE50924</textcolor>
        <aligny>center</aligny>
      </control>
    </control>
    <control type="label">
      <left>96</left>
      <top>98</top>
      <width>1400</width>
      <height>74</height>
      <label>手动选择包内文件</label>
      <font>font30_title</font>
      <textcolor>FFF5F5F5</textcolor>
    </control>
    <control type="label">
      <left>98</left>
      <top>190</top>
      <width>1440</width>
      <height>46</height>
      <label>选择要播放的文件，按返回键取消</label>
      <font>font12</font>
      <textcolor>FFB3B3B3</textcolor>
    </control>
    <control type="label">
      <left>1510</left>
      <top>190</top>
      <width>300</width>
      <height>46</height>
      <label>$INFO[Container(1000).NumItems,, 个文件]</label>
      <font>font12</font>
      <textcolor>FFB3B3B3</textcolor>
      <align>right</align>
    </control>
    <control type="group">
      <left>0</left>
      <top>0</top>
      <width>1920</width>
      <height>1080</height>
      <visible>!String.IsEqual(Window().Property(resolving),true) + !String.IsEqual(Window().Property(instant_close),true)</visible>
      <control type="list" id="1000">
        <left>96</left>
        <top>282</top>
        <width>1700</width>
        <height>676</height>
        <pagecontrol>1111</pagecontrol>
        <onleft>1000</onleft>
        <onright>1111</onright>
        <onup>1000</onup>
        <ondown>1000</ondown>
        <scrolltime>180</scrolltime>
        <preloaditems>1</preloaditems>
        <itemlayout width="1700" height="112">
          <control type="image">
            <left>0</left>
            <top>3</top>
            <width>1676</width>
            <height>98</height>
            <texture colordiffuse="FF202020" border="20">am6b/cinema/rounded.png</texture>
          </control>
          <control type="label">
            <left>30</left>
            <top>23</top>
            <width>1608</width>
            <height>54</height>
            <label>$INFO[ListItem.Label]</label>
            <font>font12</font>
            <textcolor>FFB3B3B3</textcolor>
            <scroll>false</scroll>
          </control>
        </itemlayout>
        <focusedlayout width="1700" height="112">
          <control type="image">
            <left>0</left>
            <top>3</top>
            <width>1676</width>
            <height>98</height>
            <texture colordiffuse="FF383838" border="20">am6b/cinema/rounded.png</texture>
          </control>
          <control type="image">
            <left>0</left>
            <top>3</top>
            <width>1676</width>
            <height>98</height>
            <visible>Control.HasFocus(1000)</visible>
            <texture colordiffuse="FFF5F5F5" border="20">am6b/cinema/outline.png</texture>
          </control>
          <control type="label">
            <left>30</left>
            <top>23</top>
            <width>1608</width>
            <height>54</height>
            <label>$INFO[ListItem.Label]</label>
            <font>font12</font>
            <textcolor>FFF5F5F5</textcolor>
            <scroll>true</scroll>
          </control>
        </focusedlayout>
      </control>
      <control type="scrollbar" id="1111">
        <left>1820</left>
        <top>282</top>
        <width>10</width>
        <height>676</height>
        <onleft>1000</onleft>
        <onright>1000</onright>
        <onup>1111</onup>
        <ondown>1111</ondown>
        <orientation>vertical</orientation>
        <showonepage>false</showonepage>
        <texturesliderbackground colordiffuse="FF242424">am6b/white.png</texturesliderbackground>
        <texturesliderbar colordiffuse="FF777777">am6b/white.png</texturesliderbar>
        <texturesliderbarfocus colordiffuse="FFF5F5F5">am6b/white.png</texturesliderbarfocus>
        <textureslidernib>am6b/transparent.png</textureslidernib>
        <textureslidernibfocus>am6b/transparent.png</textureslidernibfocus>
      </control>
    </control>
    <control type="label">
      <left>96</left>
      <top>455</top>
      <width>1728</width>
      <height>72</height>
      <label>正在解析所选文件…</label>
      <font>font30_title</font>
      <textcolor>FFF5F5F5</textcolor>
      <visible>String.IsEqual(Window().Property(resolving),true)</visible>
      <align>center</align>
    </control>
    <control type="label">
      <left>98</left>
      <top>1008</top>
      <width>1710</width>
      <height>42</height>
      <label>请按文件名核对正片或集数</label>
      <font>font11</font>
      <textcolor>FFB3B3B3</textcolor>
    </control>
  </controls>
</window>
