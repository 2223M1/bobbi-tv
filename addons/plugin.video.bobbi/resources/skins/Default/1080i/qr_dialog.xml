<?xml version='1.0' encoding='utf-8'?>
<window type="dialog" id="12000">
  <coordinates>
    <left>480</left>
    <top>300</top>
    <width>900</width>
    <height>450</height>
  </coordinates>
  <defaultcontrol always="true">12003</defaultcontrol>
  <animation type="WindowOpen" reversible="false" condition="!Skin.HasSetting(BobiReduceMotion)">
    <effect type="zoom" start="80" end="100" center="50%,50%" delay="160" tween="back" time="180" />
    <effect type="fade" delay="160" end="100" time="180" />
  </animation>
  <animation type="WindowClose" reversible="false" condition="!Skin.HasSetting(BobiReduceMotion)">
    <effect type="zoom" start="100" end="80" center="50%,50%" easing="in" tween="back" time="180" />
    <effect type="fade" start="100" end="0" time="180" />
  </animation>
  <depth>0.40</depth>
  <controls>
    <control type="image">
      <width>900</width>
      <height>450</height>
      <texture border="30">circle.png</texture>
      <colordiffuse>CC000000</colordiffuse>
    </control>
    <control type="label" id="12001">
      <top>20</top>
      <width>880</width>
      <height>40</height>
      <align>center</align>
      <font>font16</font>
      <textcolor>white</textcolor>
      <shadowcolor>AA000000</shadowcolor>
    </control>
    <control type="image" id="12006">
      <top>80</top>
      <left>60</left>
      <width>220</width>
      <height>220</height>
      <texture>qr_placeholder.png</texture>
    </control>
    <control type="label" id="12002">
      <top>80</top>
      <left>300</left>
      <width>580</width>
      <height>220</height>
      <align>left</align>
      <font>font14</font>
      <textcolor>white</textcolor>
      <shadowcolor>AA000000</shadowcolor>
      <wrapmultiline>true</wrapmultiline>
    </control>
    <control type="progress" id="12004">
      <top>320</top>
      <left>60</left>
      <width>780</width>
      <height>30</height>
      <info>percentage</info>
    </control>
    <control type="grouplist" orientation="horizontal">
      <orientation>horizontal</orientation>
      <top>370</top>
      <left>360</left>
      <itemgap>120</itemgap>
      <control type="button" id="12003">
        <width>140</width>
        <height>50</height>
        <label>关闭</label>
        <align>center</align>
        <font>font14</font>
        <textcolor>DDFFFFFF</textcolor>
        <focusedcolor>EEFFFFFF</focusedcolor>
        <selectedcolor>DDFFFFFF</selectedcolor>
        <texturefocus border="25" colordiffuse="FF999999">circle.png</texturefocus>
        <texturenofocus border="25" colordiffuse="99000000">circle.png</texturenofocus>
        <pulseonselect>no</pulseonselect>
      </control>
    </control>
  </controls>
</window>