<?xml version="1.0" encoding="utf-8"?>
<!-- Skip intro: bottom-right pill. Ids: 4001 skip (default), 4002 dismiss. Reads skip_label. -->
<window>
  <defaultcontrol always="true">4001</defaultcontrol>
  <coordinates><left>1304</left><top>888</top></coordinates>
  <animation type="WindowOpen" reversible="false">
    <effect type="fade" start="0" end="100" time="200" />
    <effect type="slide" start="32,0" end="0,0" time="220" tween="cubic" easing="out" />
  </animation>
  <animation effect="fade" start="100" end="0" time="160">WindowClose</animation>
  <controls>
    <control type="image">
      <left>-28</left><top>-24</top><width>576</width><height>128</height>
      <texture colordiffuse="99000000" border="40">bobi/shadow-r14.png</texture>
    </control>
    <control type="grouplist">
      <left>0</left><top>0</top><width>520</width><height>80</height>
      <orientation>horizontal</orientation><itemgap>12</itemgap><align>right</align>
      <control type="button" id="4002">
        <width>148</width><height>80</height>
        <label>忽略</label>
        <font>Button24</font><textcolor>FFF5F3EF</textcolor><focusedcolor>FF0A0B0E</focusedcolor>
        <align>center</align><aligny>center</aligny>
        <texturefocus colordiffuse="FFFFFFFF" border="40">bobi/pill.png</texturefocus>
        <texturenofocus colordiffuse="FF1E2128" border="40">bobi/pill.png</texturenofocus>
      </control>
      <control type="button" id="4001">
        <width>360</width><height>80</height>
        <label>$INFO[Window().Property(skip_label)]</label>
        <font>Button28</font><textcolor>FFF5F3EF</textcolor><focusedcolor>FF0A0B0E</focusedcolor>
        <align>center</align><aligny>center</aligny>
        <texturefocus colordiffuse="FFFFFFFF" border="40">bobi/pill.png</texturefocus>
        <texturenofocus colordiffuse="FF1E2128" border="40">bobi/pill.png</texturenofocus>
      </control>
    </control>
  </controls>
</window>
