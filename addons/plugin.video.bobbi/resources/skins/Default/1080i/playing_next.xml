<?xml version="1.0" encoding="utf-8"?>
<window>
  <defaultcontrol always="true">3001</defaultcontrol>
  <coordinates><left>1080</left><top>616</top></coordinates>
  <animation type="WindowOpen" reversible="false" condition="!Skin.HasSetting(BobbiReduceMotion)">
    <effect type="fade" start="0" end="100" time="200" />
    <effect type="slide" start="40,0" end="0,0" time="240" tween="cubic" easing="out" />
  </animation>
  <animation effect="fade" start="100" end="0" time="160" condition="!Skin.HasSetting(BobbiReduceMotion)">WindowClose</animation>
  <controls>
    <control type="image">
      <left>-48</left><top>-48</top><width>856</width><height>476</height>
      <texture border="64">bobbi/glass/modal-shadow.png</texture>
    </control>
    <control type="image">
      <left>0</left><top>0</top><width>760</width><height>380</height>
      <texture colordiffuse="FF25252C" border="46">bobbi/glass/modal-glass.png</texture>
      <visible>Skin.HasSetting(BobbiLiquidGlassEnabled)</visible>
    </control>
    <control type="image">
      <left>0</left><top>0</top><width>760</width><height>380</height>
      <texture colordiffuse="FF50545C" border="46">bobbi/glass/modal-glass.png</texture>
      <visible>!Skin.HasSetting(BobbiLiquidGlassEnabled)</visible>
    </control>
    <control type="image">
      <left>0</left><top>0</top><width>760</width><height>380</height>
      <texture border="46">bobbi/glass/modal-glass-rim.png</texture>
    </control>
    <control type="image">
      <left>24</left><top>24</top><width>320</width><height>180</height>
      <texture>bobbi/glass/tile-320x180.png</texture>
    </control>
    <control type="image">
      <left>24</left><top>24</top><width>320</width><height>180</height>
      <aspectratio scalediffuse="false">scale</aspectratio>
      <texture background="true" diffuse="bobbi/glass/mask-320x180.png">$INFO[Window().Property(next.fanart)]</texture>
    </control>
    <control type="image">
      <left>24</left><top>24</top><width>320</width><height>180</height>
      <texture>bobbi/glass/rim-320x180.png</texture>
    </control>
    <control type="progress" id="3014">
      <left>24</left><top>216</top><width>320</width><height>6</height>
      <texturebg colordiffuse="48FFFFFF" border="4">bobbi/glass/progress-track.png</texturebg>
      <midtexture colordiffuse="FFFFFFFF" border="4">bobbi/glass/progress-fill.png</midtexture>
    </control>
    <control type="label">
      <left>368</left><top>24</top><width>368</width><height>28</height>
      <label>下一集   $INFO[Window().Property(timer_label)]</label>
      <font>NavHead24</font><textcolor>E6EBEBF5</textcolor>
      <animation effect="fade" start="100" end="68" time="0" condition="Skin.HasSetting(BobbiLiquidGlassEnabled)">Conditional</animation>
    </control>
    <control type="label">
      <left>368</left><top>58</top><width>368</width><height>44</height>
      <label>$INFO[Window().Property(next.title)]</label>
      <font>Head30</font><textcolor>FFF5F5F7</textcolor><aligny>center</aligny>
    </control>
    <control type="label">
      <left>368</left><top>104</top><width>368</width><height>34</height>
      <label>$INFO[Window().Property(next.episode_label)]</label>
      <font>Card26</font><textcolor>FFF5F5F7</textcolor><aligny>center</aligny>
    </control>
    <control type="textbox">
      <left>368</left><top>144</top><width>368</width><height>64</height>
      <label>$INFO[Window().Property(next.episode_name)]</label>
      <font>CardSub22</font><textcolor>E6EBEBF5</textcolor>
      <animation effect="fade" start="100" end="68" time="0" condition="Skin.HasSetting(BobbiLiquidGlassEnabled)">Conditional</animation>
    </control>
    <control type="grouplist">
      <left>24</left><top>284</top><width>712</width><height>68</height>
      <orientation>horizontal</orientation><itemgap>16</itemgap>
      <control type="button" id="3001">
        <width>340</width><height>66</height>
        <label>立即播放</label>
        <font>HeroPlay29</font><textcolor>FF1D1D1F</textcolor><focusedcolor>FF1D1D1F</focusedcolor>
        <align>center</align><aligny>center</aligny>
        <texturefocus colordiffuse="FFFFFFFF" border="33,0,33,0">bobbi/glass/capsule-66.png</texturefocus>
        <texturenofocus colordiffuse="FFE2E3E6" border="33,0,33,0">bobbi/glass/capsule-66.png</texturenofocus>
      </control>
      <control type="button" id="3002">
        <width>216</width><height>66</height>
        <label>继续看片尾</label>
        <font>Button24</font><textcolor>FFF5F5F7</textcolor><focusedcolor>FF1D1D1F</focusedcolor>
        <align>center</align><aligny>center</aligny>
        <texturefocus colordiffuse="FFFFFFFF" border="33,0,33,0">bobbi/glass/capsule-66.png</texturefocus>
        <texturenofocus colordiffuse="24FFFFFF" border="33,0,33,0">bobbi/glass/capsule-66.png</texturenofocus>
      </control>
    </control>
  </controls>
</window>
