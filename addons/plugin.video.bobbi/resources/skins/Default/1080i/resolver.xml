<?xml version="1.0" encoding="utf-8"?>
<window type="dialog">
  <coordinates><left>0</left><top>0</top></coordinates>
  <animation effect="fade" start="0" end="100" time="200" tween="cubic" easing="out" condition="!Skin.HasSetting(BobbiReduceMotion)">WindowOpen</animation>
  <animation effect="fade" start="100" end="0" time="160" condition="!Skin.HasSetting(BobbiReduceMotion)">WindowClose</animation>
  <controls>
    <control type="image">
      <left>0</left><top>0</top><width>1920</width><height>1080</height>
      <texture>bobbi/glass/stage-ambient.png</texture>
    </control>
    <control type="image">
      <left>0</left><top>0</top><width>1920</width><height>1080</height>
      <aspectratio>scale</aspectratio>
      <texture background="true" colordiffuse="66FFFFFF">$INFO[Window().Property(info.fanart)]</texture>
    </control>
    <control type="image">
      <left>0</left><top>0</top><width>1920</width><height>1080</height>
      <texture>bobbi/glass/scrim-top.png</texture>
    </control>
    <control type="image">
      <left>0</left><top>0</top><width>1920</width><height>1080</height>
      <texture>bobbi/glass/scrim-left.png</texture>
    </control>
    <control type="image">
      <left>0</left><top>0</top><width>1920</width><height>1080</height>
      <texture>bobbi/glass/scrim-bottom.png</texture>
    </control>
    <control type="group">
      <left>180</left><top>300</top>
      <control type="image">
        <left>-48</left><top>-48</top><width>396</width><height>546</height>
        <texture>bobbi/glass/shadow-300x450.png</texture>
      </control>
      <control type="image">
        <left>0</left><top>0</top><width>300</width><height>450</height>
        <texture>bobbi/glass/tile-300x450.png</texture>
      </control>
      <control type="image">
        <left>0</left><top>0</top><width>300</width><height>450</height>
        <aspectratio scalediffuse="false">scale</aspectratio>
        <texture background="true" diffuse="bobbi/glass/mask-300x450.png">$INFO[Window().Property(info.poster)]</texture>
      </control>
      <control type="image">
        <left>0</left><top>0</top><width>300</width><height>450</height>
        <texture>bobbi/glass/rim-300x450.png</texture>
      </control>
      <control type="label">
        <left>364</left><top>44</top><width>1200</width><height>28</height>
        <label>正在准备播放</label>
        <font>NavHead24</font><textcolor>9CEBEBF5</textcolor>
      </control>
      <control type="label">
        <left>364</left><top>80</top><width>1200</width><height>80</height>
        <label>$INFO[Window().Property(info.display_title)]</label>
        <font>Hero60</font><textcolor>FFFFFFFF</textcolor><aligny>center</aligny>
      </control>
      <control type="label">
        <left>366</left><top>168</top><width>1200</width><height>36</height>
        <label>$INFO[Window().Property(info.season_episode)]$INFO[Window().Property(info.display_subtitle),   ·   ]</label>
        <font>HeroMeta24</font><textcolor>D9EBEBF5</textcolor><aligny>center</aligny>
      </control>
      <control type="image">
        <left>366</left><top>268</top><width>56</width><height>56</height>
        <texture>bobbi/glass/icon-disc-44.png</texture>
      </control>
      <control type="image">
        <left>378</left><top>280</top><width>32</width><height>32</height>
        <texture colordiffuse="FFFFFFFF">bobbi/spinner.png</texture>
        <animation effect="rotate" end="-360" center="394,296" time="900" loop="true" condition="!Skin.HasSetting(BobbiReduceMotion)">Conditional</animation>
      </control>
      <control type="label">
        <left>442</left><top>266</top><width>1100</width><height>60</height>
        <label>$INFO[Window().Property(loading_stage)]</label>
        <font>Head30</font><textcolor>FFF5F5F7</textcolor><aligny>center</aligny>
      </control>
      <control type="label">
        <left>366</left><top>356</top><width>1100</width><height>32</height>
        <label>开始播放后自动全屏   ·   按 返回 取消</label>
        <font>CardSub22</font><textcolor>9CEBEBF5</textcolor>
      </control>
    </control>
  </controls>
</window>
