<?xml version="1.0" encoding="utf-8"?>
<!--
  Resolving / buffering between source pick and playback (Jacktook ResolverWindow).
  Must stay type="dialog": the playback service finds it through window properties.
  Reads: info.fanart, info.poster, info.display_title, info.season_episode, loading_stage.
  Back cancels (Jacktook sets bobbi_cinema_cancel).
-->
<window type="dialog">
  <coordinates><left>0</left><top>0</top></coordinates>
  <animation effect="fade" start="0" end="100" time="200" tween="cubic" easing="out">WindowOpen</animation>
  <animation effect="fade" start="100" end="0" time="160">WindowClose</animation>
  <controls>
    <control type="image">
      <left>0</left><top>0</top><width>1920</width><height>1080</height>
      <texture colordiffuse="FF0A0B0E">bobi/white.png</texture>
    </control>
    <control type="image">
      <left>0</left><top>0</top><width>1920</width><height>1080</height>
      <aspectratio>scale</aspectratio>
      <texture background="true" colordiffuse="59FFFFFF">$INFO[Window().Property(info.fanart)]</texture>
    </control>
    <control type="image">
      <left>0</left><top>0</top><width>1920</width><height>1080</height>
      <texture colordiffuse="B30A0B0E">bobi/white.png</texture>
    </control>
    <control type="group">
      <left>200</left><top>300</top>
      <control type="image">
        <left>0</left><top>0</top><width>300</width><height>450</height>
        <texture colordiffuse="FF1E2128" border="16">bobi/r20.png</texture>
      </control>
      <control type="image">
        <left>0</left><top>0</top><width>300</width><height>450</height>
        <aspectratio scalediffuse="false">scale</aspectratio>
        <texture background="true" diffuse="bobi/mask-300x450.png">$INFO[Window().Property(info.poster)]</texture>
      </control>
      <control type="label">
        <left>360</left><top>40</top><width>1200</width><height>32</height>
        <label>正在准备播放</label>
        <font>Label24</font><textcolor>FFFFB27F</textcolor>
      </control>
      <control type="label">
        <left>360</left><top>80</top><width>1200</width><height>80</height>
        <label>$INFO[Window().Property(info.display_title)]</label>
        <font>Display56</font><textcolor>FFF5F3EF</textcolor><aligny>center</aligny>
      </control>
      <control type="label">
        <left>362</left><top>168</top><width>1200</width><height>40</height>
        <label>$INFO[Window().Property(info.season_episode)]$INFO[Window().Property(info.display_subtitle),   ·   ]</label>
        <font>Label28</font><textcolor>FFB4B2AD</textcolor><aligny>center</aligny>
      </control>
      <!-- stage line with spinner -->
      <control type="image">
        <left>362</left><top>276</top><width>48</width><height>48</height>
        <texture colordiffuse="FFFF8A3D">bobi/spinner.png</texture>
        <animation effect="rotate" end="-360" center="386,300" time="900" loop="true" condition="true">Conditional</animation>
      </control>
      <control type="label">
        <left>432</left><top>270</top><width>1100</width><height>60</height>
        <label>$INFO[Window().Property(loading_stage)]</label>
        <font>Head34</font><textcolor>FFF5F3EF</textcolor><aligny>center</aligny>
      </control>
      <control type="label">
        <left>362</left><top>360</top><width>1100</width><height>36</height>
        <label>开始播放后自动全屏   ·   按 返回 取消</label>
        <font>Meta24</font><textcolor>FF7E7D79</textcolor>
      </control>
    </control>
  </controls>
</window>
