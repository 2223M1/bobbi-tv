<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog">
  <defaultcontrol always="true">9003</defaultcontrol>
  <animation effect="fade" start="0" end="100" time="160" condition="!Skin.HasSetting(BobbiReduceMotion)">WindowOpen</animation>
  <animation effect="fade" start="100" end="0" time="120" condition="!Skin.HasSetting(BobbiReduceMotion)">WindowClose</animation>
  <controls>
    <control type="image">
      <left>0</left><top>0</top><width>1920</width><height>1080</height>
      <texture colordiffuse="A6000000">bobbi/white.png</texture>
      <animation effect="fade" start="100" end="48" time="0" condition="!Skin.HasSetting(BobbiLiquidGlassEnabled)">Conditional</animation>
    </control>
    <control type="group">
      <left>420</left><top>320</top>
      <animation type="WindowOpen" reversible="false" condition="!Skin.HasSetting(BobbiReduceMotion)">
        <effect type="slide" start="0,16" end="0,0" time="200" tween="cubic" easing="out" />
      </animation>
      <control type="image">
        <left>-48</left><top>-48</top><width>1176</width><height>536</height>
        <texture border="64">bobbi/glass/modal-shadow.png</texture>
      </control>
      <control type="image">
        <width>1080</width><height>440</height>
        <texture colordiffuse="FF25252C" border="46">bobbi/glass/modal-glass.png</texture>
        <visible>Skin.HasSetting(BobbiLiquidGlassEnabled)</visible>
      </control>
      <control type="image">
        <width>1080</width><height>440</height>
        <texture colordiffuse="FF50545C" border="46">bobbi/glass/modal-glass.png</texture>
        <visible>!Skin.HasSetting(BobbiLiquidGlassEnabled)</visible>
      </control>
      <control type="image">
        <width>1080</width><height>440</height>
        <texture border="46">bobbi/glass/modal-glass-rim.png</texture>
      </control>
      <control type="label" id="100">
        <left>52</left><top>42</top><width>976</width><height>56</height>
        <font>Head34</font><textcolor>FFF5F5F7</textcolor><aligny>center</aligny>
      </control>
      <control type="label" id="101">
        <left>52</left><top>116</top><width>976</width><height>40</height>
        <font>Plot26</font><label>可返回选源重试，不会自动更换版本。</label><textcolor>D9EBEBF5</textcolor>
      </control>
      <control type="label">
        <left>52</left><top>166</top><width>976</width><height>40</height>
        <font>Plot26</font><label>20 秒无操作自动返回；已保留续看进度。</label><textcolor>E6EBEBF5</textcolor>
        <animation effect="fade" start="100" end="68" time="0" condition="Skin.HasSetting(BobbiLiquidGlassEnabled)">Conditional</animation>
      </control>
      <control type="button" id="9001">
        <left>52</left><top>300</top><width>308</width><height>66</height>
        <font>Button24</font><label>重选当前片源</label>
        <textcolor>FFF5F5F7</textcolor><focusedcolor>FF1D1D1F</focusedcolor><align>center</align><aligny>center</aligny>
        <texturefocus colordiffuse="FFFFFFFF" border="33,0,33,0">bobbi/glass/capsule-66.png</texturefocus>
        <texturenofocus colordiffuse="24FFFFFF" border="33,0,33,0">bobbi/glass/capsule-66.png</texturenofocus>
        <onright>9002</onright><onleft>9003</onleft>
      </control>
      <control type="button" id="9002">
        <left>386</left><top>300</top><width>308</width><height>66</height>
        <font>Button24</font><label>查看分集</label>
        <textcolor>FFF5F5F7</textcolor><focusedcolor>FF1D1D1F</focusedcolor><align>center</align><aligny>center</aligny>
        <texturefocus colordiffuse="FFFFFFFF" border="33,0,33,0">bobbi/glass/capsule-66.png</texturefocus>
        <texturenofocus colordiffuse="24FFFFFF" border="33,0,33,0">bobbi/glass/capsule-66.png</texturenofocus>
        <onright>9003</onright><onleft>9001</onleft>
      </control>
      <control type="button" id="9003">
        <left>720</left><top>300</top><width>308</width><height>66</height>
        <font>Button24</font><label>返回</label>
        <textcolor>FFF5F5F7</textcolor><focusedcolor>FF1D1D1F</focusedcolor><align>center</align><aligny>center</aligny>
        <texturefocus colordiffuse="FFFFFFFF" border="33,0,33,0">bobbi/glass/capsule-66.png</texturefocus>
        <texturenofocus colordiffuse="24FFFFFF" border="33,0,33,0">bobbi/glass/capsule-66.png</texturenofocus>
        <onright>9001</onright><onleft>9002</onleft>
      </control>
    </control>
  </controls>
</window>
