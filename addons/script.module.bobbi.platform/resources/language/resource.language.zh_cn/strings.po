msgstr "需要启动或重试"

msgctxt "#32035"
msgid "Retry check"
msgstr "连接失败，点此重试"

msgctxt "#32036"
msgid "Check config"
msgstr "配置需要检查"

msgctxt "#32037"
msgid "Unavailable"
msgstr "组件暂不可用"

msgctxt "#32038"
