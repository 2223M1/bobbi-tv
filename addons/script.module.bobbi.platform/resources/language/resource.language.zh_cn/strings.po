msgctxt "#32000"
msgid "Sign in to 115 Share Playback"
msgstr "登录 115 分享播放"

msgctxt "#32001"
msgid "Scan with the 115 Life app"
msgstr "用「115 生活」App 扫码"

msgctxt "#32002"
msgid "Preparing QR code; press Back to cancel."
msgstr "正在准备二维码，可按返回取消。"

msgctxt "#32003"
msgid "Cancel"
msgstr "取消"

msgctxt "#32004"
msgid "Confirm on your phone after scanning. Cancelling keeps the current account."
msgstr "扫码后在手机确认。取消会保留当前账号。"

msgctxt "#32005"
msgid "Preparing QR code"
msgstr "准备二维码"

msgctxt "#32006"
msgid "Waiting for phone confirmation"
msgstr "等待手机确认"

msgctxt "#32007"
msgid "Fetching sign-in token"
msgstr "获取登录信息"

msgctxt "#32008"
msgid "Verifying account identity"
msgstr "核验登录信息"

msgctxt "#32009"
msgid "Saving sign-in"
msgstr "保存登录"

msgctxt "#32010"
msgid "Completed"
msgstr "完成"

msgctxt "#32011"
msgid "Cancelled"
msgstr "取消"

msgctxt "#32012"
msgid "Sign-in"
msgstr "登录"

msgctxt "#32013"
msgid "Save receipt confirmed"
msgstr "已收到保存回执"

msgctxt "#32014"
msgid "Save receipt pending"
msgstr "保存回执待确认"

msgctxt "#32015"
msgid "Not submitted for save yet"
msgstr "尚未提交保存"

msgctxt "#32016"
msgid "%s (%s); %s."
msgstr "%s（%s）；%s。"

msgctxt "#32017"
msgid "Open bobbi Helper and tap \"Start\" first, then return and retry."
msgstr "请先打开 bobbi 助手并点击“启动”，然后回来重试。"

msgctxt "#32018"
msgid "Local Helper timed out. Open Helper to check its status, then retry."
msgstr "本机助手响应超时，请打开助手查看状态，再回来重试。"

msgctxt "#32019"
msgid "Pairing expired. Export a new pairing file in Helper and import it again."
msgstr "配对已失效。请在助手重新导出配对文件，再导入一次。"

msgctxt "#32020"
msgid "Port is occupied by another app or an unsupported helper. Open Helper to check status."
msgstr "后台端口被其他程序占用或不是受支持的助手，请打开助手查看状态。"

msgctxt "#32021"
msgid "Helper settings are incompatible with this version. Stop and restart Helper, then retry."
msgstr "助手设置与此版本不兼容，请在助手停止后重新启动，再重试。"

msgctxt "#32022"
msgid "Helper and Cinema versions do not match. Install the matching release and retry."
msgstr "助手与影院版本不配套，请安装同一发行版本后重试。"

msgctxt "#32023"
msgid "Timed out waiting for source metadata. Retry or pick another source manually."
msgstr "等待片源信息超时。可以重试，或手动选其他片源。"

msgctxt "#32024"
msgid "No playable video file found in this source. Please pick another source."
msgstr "这个片源没有可播放的视频文件，请手动选择其他片源。"

msgctxt "#32025"
msgid "Invalid pairing file. Use the file exported by bobbi Helper on this device."
msgstr "配对文件无效，请使用本机 bobbi 助手导出的文件。"

msgctxt "#32026"
msgid "Source hash mismatch; resolution stopped. Refresh and select a source again."
msgstr "片源标识不一致，已停止解析。请刷新后重新选源。"

msgctxt "#32027"
msgid "Missing verifiable torrent hash. Refresh and select a source again."
msgstr "这个片源缺少可核对的种子标识，请刷新后重新选源。"

msgctxt "#32028"
msgid "Could not connect or resolve this source. Open Helper to check status and retry."
msgstr "本次未能连接或解析片源，请打开助手检查状态后重试。"

msgctxt "#32029"
msgid "Built-in"
msgstr "已内置，选源时启动"

msgctxt "#32030"
