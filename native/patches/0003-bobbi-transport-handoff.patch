+
+std::string BobiStableStreamKey(const SelectionStream& stream)
+{
+  // Demuxer instance IDs, source counters and list indexes are deliberately
+  // excluded. Container stream IDs are checked with the full stream catalog.
+  std::string value;
+  for (const auto& field : {std::to_string(stream.type), std::to_string(stream.id),
+       std::to_string(static_cast<unsigned int>(stream.flags)), stream.language,
+       stream.name, stream.codec, std::to_string(stream.channels),
+       std::to_string(stream.bitrate), std::to_string(stream.width),
+       std::to_string(stream.height)})
+    value += std::to_string(field.size()) + ":" + field;
+  return KODI::UTILITY::CDigest::Calculate(KODI::UTILITY::CDigest::Type::SHA256, value);
+}
+
+std::string BobiInternalCatalog(CSelectionStreams& streams)
+{
+  std::vector<std::string> keys;
+  for (const auto type : {STREAM_VIDEO, STREAM_AUDIO, STREAM_SUBTITLE})
+    for (const auto& stream : streams.Get(type))
+      if (STREAM_SOURCE_MASK(stream.source) == STREAM_SOURCE_DEMUX)
+        keys.push_back(BobiStableStreamKey(stream));
+  std::sort(keys.begin(), keys.end());
+  std::string value;
+  for (const auto& key : keys) value += key;
+  return KODI::UTILITY::CDigest::Calculate(KODI::UTILITY::CDigest::Type::SHA256, value);
+}
+
+bool BobiReadSubtitleHash(const std::string& path, std::string& result)
+{
+  if (path.empty() || path.size() > 4096) return false;
+  const auto translated = CSpecialProtocol::TranslatePath(path);
+  for (const auto* location : {"special://profile/", "special://temp/"})
+  {
+    KODI::UTILITY::CDigest digest(KODI::UTILITY::CDigest::Type::SHA256);
+    if (BobiReadHandoffFile(CSpecialProtocol::TranslatePath(location), translated,
+        [&](const void* data, size_t length) { digest.Update(data, length); }))
+    {
+      result = digest.Finalize();
+      return true;
+    }
+  }
+  return false;
+}
 }
 
