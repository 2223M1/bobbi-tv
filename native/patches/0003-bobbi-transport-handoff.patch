diff --git a/xbmc/dialogs/BobiHandoffFile.h b/xbmc/dialogs/BobiHandoffFile.h
new file mode 100644
--- /dev/null
+++ b/xbmc/dialogs/BobiHandoffFile.h
@@ -0,0 +1,87 @@
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <chrono>
+#include <functional>
+#include <string>
+#if !defined(_WIN32)
+#include <cerrno>
+#include <climits>
+#include <cstdlib>
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#else
+#include <filesystem>
+#include <fstream>
+#endif
+
+// The host supplies its own translated profile/temp roots. No network URLs,
+// external mounts chosen by an addon, or platform-specific /storage assumption.
+inline bool BobiReadHandoffFile(const std::string& root, const std::string& path,
+    const std::function<void(const void*, size_t)>& consume)
+{
+  using namespace std::chrono;
+  const auto deadline = steady_clock::now() + seconds(2);
+  if (root.empty() || path.size() > 4096) return false;
+  std::string prefix = root;
+  while (!prefix.empty() && prefix.back() == '/') prefix.pop_back();
+  prefix += '/';
+  if (path.compare(0, prefix.size(), prefix) != 0) return false;
+  const auto relative = path.substr(prefix.size());
+  if (relative.empty() || relative.front() == '/' || relative.back() == '/') return false;
+  for (size_t start = 0; start < relative.size();)
+  {
+    const auto end = relative.find('/', start);
+    const auto part = relative.substr(start, end == std::string::npos ? end : end - start);
+    if (part.empty() || part == "." || part == ".." || part.find('\\') != std::string::npos)
+      return false;
+    if (end == std::string::npos) break;
+    start = end + 1;
+  }
+#if !defined(_WIN32)
+  char canonical[PATH_MAX];
+  if (root.front() != '/' || !realpath(root.c_str(), canonical)) return false;
+  struct Descriptor { int value; ~Descriptor() { if (value >= 0) close(value); } } node{
+      open(canonical, O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC)};
+  if (node.value < 0) return false;
+  for (size_t start = 0; start < relative.size();)
+  {
+    const auto end = relative.find('/', start);
+    const bool last = end == std::string::npos;
+    const auto part = relative.substr(start, last ? end : end - start);
+    const int fd = openat(node.value, part.c_str(), O_RDONLY | O_NOFOLLOW | O_CLOEXEC |
+                         O_NONBLOCK | (last ? 0 : O_DIRECTORY));
+    if (fd < 0) return false;
+    close(node.value);
+    node.value = fd;
+    if (last) break;
+    start = end + 1;
+  }
+  struct stat before{}, after{};
+  if (fstat(node.value, &before) || !S_ISREG(before.st_mode) || before.st_size <= 0 ||
+      before.st_size > 64 * 1024 * 1024) return false;
+  std::array<char, 16384> buffer;
+  off_t total = 0;
+  while (total < before.st_size && steady_clock::now() < deadline)
+  {
+    const auto count = read(node.value, buffer.data(),
+        std::min<off_t>(buffer.size(), before.st_size - total));
+    if (count < 0 && errno == EINTR) continue;
+    if (count <= 0) return false;
+    consume(buffer.data(), static_cast<size_t>(count));
+    total += count;
+  }
+  return total == before.st_size && steady_clock::now() < deadline &&
+      !fstat(node.value, &after) && before.st_size == after.st_size &&
+      before.st_mtim.tv_sec == after.st_mtim.tv_sec &&
+      before.st_mtim.tv_nsec == after.st_mtim.tv_nsec &&
+      before.st_ctim.tv_sec == after.st_ctim.tv_sec &&
+      before.st_ctim.tv_nsec == after.st_ctim.tv_nsec;
+#else
+  // The generic Windows host does not yet certify external subtitle handoff.
+  // Internal tracks still use the same capsule without any filesystem access.
+  return false;
+#endif
+}
