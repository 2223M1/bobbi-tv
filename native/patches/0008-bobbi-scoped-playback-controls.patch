+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+
+#include "utils/Variant.h"
+#include <deque>
+#include <string>
+
+// Shared by admission and the real actor. A received request is never evidence
+// that the demuxer/stream operation was applied. No URL, credentials or indexes
+// supplied without an instance-bound key can grant authority here.
+inline bool BobiScopedAction(const std::string& action)
+{
+  return action == "seek" || action == "audio_stream" ||
+      action == "manual_subtitle_stream" || action == "subtitle_visible";
+}
+
+inline bool BobiScopedMatches(const CVariant& command, const CVariant& state,
+                              uint64_t selectionEpoch, const std::string& fileSha)
+{
+  if (!BobiScopedAction(command["action"].asString()) ||
+      command["control_protocol"].asInteger() != 1 ||
+      state["phase"].asString() != "AV_STARTED" ||
+      command["request_id"].asString().size() != 32 ||
+      command["native_instance"] != state["native_instance"] ||
+      command["request_id"] != state["request_id"] ||
+      command["file_sha256"].asString() != fileSha || fileSha.size() != 64)
+    return false;
+  for (const auto* key : {"user_intent", "subtitle_intent", "audio_intent"})
+    if (!(command[key].isInteger() || command[key].isUnsignedInteger()) ||
+        command[key].asInteger(-1) < 0 || command[key].asUnsignedInteger() != state[key].asUnsignedInteger()) return false;
+  return command["expected_sequence"].asUnsignedInteger() == state["sequence"].asUnsignedInteger() &&
+      command["selection_epoch"].asUnsignedInteger() == state["open_epoch"].asUnsignedInteger() &&
+      command["selection_epoch"].asUnsignedInteger() == selectionEpoch;
+}
+
+inline bool BobiScopedSeek(const CVariant& value, int64_t duration, bool canSeek)
+{
+  return canSeek && duration > 0 && (value.isInteger() || value.isUnsignedInteger()) &&
+      value.asInteger(-1) >= 0 && value.asInteger(-1) < duration;
+}
+
+// Per native instance, protected by its existing receipt lock. Exhaustion
+// closes admission instead of evicting IDs and accidentally replaying them.
+class CBobiScopedCommands
+{
+public:
+  void Reset() { m_rows.clear(); }
+  bool Admit(const CVariant& command)
+  {
+    const auto id = command["command_id"].asString();
+    if (id.size() != 32 || id.find_first_not_of("0123456789abcdef") != std::string::npos)
+      return false;
+    for (const auto& row : m_rows)
+      if (row["command_id"] == command["command_id"]) return false;
+    if (m_rows.size() >= 256) return false;
+    CVariant row(CVariant::VariantTypeObject);
+    for (const auto* key : {"command_id", "request_id", "native_instance", "action", "file_sha256"})
+      row[key] = command[key];
+    row["control_protocol"] = 1;
+    row["status"] = "queued";
+    m_rows.push_back(row);
+    return true;
+  }
+  CVariant Finish(const CVariant& command, const std::string& status)
+  {
+    for (auto& row : m_rows)
+      if (row["command_id"] == command["command_id"] && row["status"].asString() == "queued" &&
+          row["native_instance"] == command["native_instance"] && row["request_id"] == command["request_id"] &&
+          row["file_sha256"] == command["file_sha256"] && row["action"] == command["action"])
+      {
+        row["status"] = status;
+        return row;
+      }
+    return CVariant();
+  }
+  CVariant Recent() const
+  {
+    CVariant result(CVariant::VariantTypeArray);
+    const size_t start = m_rows.size() > 16 ? m_rows.size() - 16 : 0;
+    for (size_t i = start; i < m_rows.size(); ++i) result.push_back(m_rows[i]);
+    return result;
+  }
+private:
+  std::deque<CVariant> m_rows;
+};
