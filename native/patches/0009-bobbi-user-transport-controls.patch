+            fileSha == command["file_sha256"].asString() &&
+            terminal["open_epoch"].asUnsignedInteger() == command["selection_epoch"].asUnsignedInteger() &&
+            terminal["sequence"].asUnsignedInteger() > command["expected_sequence"].asUnsignedInteger() &&
