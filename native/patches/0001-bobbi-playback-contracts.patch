+JSONRPC_STATUS CPlayerOperations::BobiState(const std::string&, ITransportLayer*, IClient*, const CVariant&, CVariant& result)
+{
+  const auto player = CServiceBroker::GetAppComponents().GetComponent<CApplicationPlayer>();
+  result["protocol"] = 1;
+  result["selection_epoch"] = CBobiOpenGate::Get().Epoch();
+  result["playback"] = player->GetBobiState();
+  const auto gui = CBobiGuiGate::Get().Snapshot();
+  result["gui_generation"] = gui.generation;
+  result["gui_user_intent"] = gui.userIntent;
+  result["fullscreen_instance"] = gui.fullscreenInstance;
+  result["windows"] = CVariant(CVariant::VariantTypeArray);
+  for (const auto& [id, window] : gui.windows)
+  {
+    CVariant item(CVariant::VariantTypeObject);
+    item["token"] = window.token;
+    item["role"] = window.role;
+    item["request_id"] = window.request;
+    item["native_instance"] = window.instance;
+    result["windows"].push_back(item);
+  }
+  return OK;
+}
+
+JSONRPC_STATUS CPlayerOperations::BobiFullscreen(const std::string&, ITransportLayer*, IClient*, const CVariant& command, CVariant& result)
+{
+  CServiceBroker::GetAppMessenger()->PostMsg(TMSG_BOBI_FULLSCREEN, -1, -1, new CVariant(command));
+  result["queued"] = true; // Not confirmation: inspect the GUI-thread receipt.
+  return OK;
+}
+
+JSONRPC_STATUS CPlayerOperations::BobiIntent(const std::string&, ITransportLayer*, IClient*, const CVariant& command, CVariant& result)
+{
+  auto& gate = CBobiOpenGate::Get();
+  std::lock_guard<std::recursive_mutex> lock(gate.Mutex());
+  result["reserved"] = gate.Reserve(command["expected_epoch"].asUnsignedInteger(), command["request_id"].asString());
+  result["selection_epoch"] = gate.Epoch();
+  return OK;
+}
+
+JSONRPC_STATUS CPlayerOperations::BobiControl(const std::string&, ITransportLayer*, IClient*, const CVariant& command, CVariant& result)
+{
+  const auto player = CServiceBroker::GetAppComponents().GetComponent<CApplicationPlayer>();
+  result["queued"] = player->BobiControl(command);
+  result["command_id"] = command["command_id"];
+  return OK;
+}
+
+JSONRPC_STATUS CPlayerOperations::BobiSubtitles(const std::string&, ITransportLayer*, IClient*, const CVariant&, CVariant& result)
+{
+  const auto player = CServiceBroker::GetAppComponents().GetComponent<CApplicationPlayer>();
+  result = player->GetBobiSubtitles();
+  return OK;
+}
+
+JSONRPC_STATUS CPlayerOperations::BobiSubtitle(const std::string&, ITransportLayer*, IClient*, const CVariant& command, CVariant& result)
+{
+  const auto player = CServiceBroker::GetAppComponents().GetComponent<CApplicationPlayer>();
+  CVariant scoped = command;
+  scoped["action"] = "subtitle_stream";
+  result["queued"] = player->BobiControl(scoped);
+  result["command_id"] = command["command_id"];
+  return OK;
+}
+
+JSONRPC_STATUS CPlayerOperations::BobiSubtitleFile(const std::string&, ITransportLayer*, IClient*, const CVariant& command, CVariant& result)
+{
+  const auto player = CServiceBroker::GetAppComponents().GetComponent<CApplicationPlayer>();
+  CVariant scoped = command;
+  scoped["action"] = "subtitle_file_auto";
+  result["queued"] = player->BobiControl(scoped);
+  result["command_id"] = command["command_id"];
+  return OK;
+}
