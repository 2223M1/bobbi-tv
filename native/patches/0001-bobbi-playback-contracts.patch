diff --git a/xbmc/cores/BobiGuiGate.h b/xbmc/cores/BobiGuiGate.h
new file mode 100644
index 0000000..4832658
--- /dev/null
+++ b/xbmc/cores/BobiGuiGate.h
@@ -0,0 +1,71 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+#include <cstdint>
+#include <mutex>
+#include <string>
+#include <map>
+
+// GUI lifecycle, not a reusable window id. Updates are cheap and bounded.
+class CBobiGuiGate
+{
+public:
+  struct Window
+  {
+    std::string token, role, request, instance;
+  };
+  struct State
+  {
+    uint64_t generation{0};
+    uint64_t userIntent{0};
+    std::string fullscreenInstance;
+    std::map<int, Window> windows;
+  };
+  static CBobiGuiGate& Get() { static CBobiGuiGate gate; return gate; }
+  State Snapshot() const { std::lock_guard<std::mutex> lock(m_mutex); return m_state; }
+  void WindowChanged() { std::lock_guard<std::mutex> lock(m_mutex); ++m_state.generation; }
+  void UserReturn() { std::lock_guard<std::mutex> lock(m_mutex); ++m_state.userIntent; }
+  void OpenWindow(int id, const Window& window)
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (m_state.windows.size() < 8 || m_state.windows.count(id))
+      m_state.windows[id] = window;
+  }
+  bool CloseWindow(int id)
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    return m_state.windows.erase(id) != 0;
+  }
+  bool AllowsPause(const std::string& action, const std::string& token, const std::string& instance) const
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (token.empty())
+      return false;
+    bool ownWindow = false, anyWindow = false;
+    for (const auto& [id, window] : m_state.windows)
+      if (window.instance == instance)
+      {
+        anyWindow = true;
+        ownWindow = ownWindow || window.token == token;
+      }
+    return action == "pause" ? ownWindow : action == "resume" && !anyWindow;
+  }
+  bool Claim(uint64_t generation, uint64_t intent, const std::string& instance)
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (generation != m_state.generation || intent != m_state.userIntent ||
+        instance.empty() || instance == m_attempted)
+      return false;
+    m_attempted = instance;
+    return true;
+  }
+  void Confirm(const std::string& instance)
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (instance == m_attempted)
+      m_state.fullscreenInstance = instance;
+  }
+private:
+  mutable std::mutex m_mutex;
+  State m_state;
+  std::string m_attempted;
+};
diff --git a/xbmc/cores/BobiOpenGate.h b/xbmc/cores/BobiOpenGate.h
new file mode 100644
index 0000000..519a40e
--- /dev/null
+++ b/xbmc/cores/BobiOpenGate.h
@@ -0,0 +1,77 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+
+#include <cstdint>
+#include <atomic>
+#include <mutex>
+#include <string>
+
+inline bool BobiControlEpochAllows(const std::string& action, uint64_t playerEpoch,
+                                  uint64_t commandEpoch, uint64_t currentEpoch)
+{
+  // B may stop A at B's current selection epoch. Old A pause/resume may not
+  // resume A after B was selected, nor may B's delayed stop survive C.
+  return commandEpoch == currentEpoch && (action == "stop" ||
+      ((action == "pause" || action == "resume") && playerEpoch == commandEpoch));
+}
+
+// Process-local selection fence, not an audio/video player id. Network and
+// plugin resolution must happen outside this lock. Only the final native open
+// consumes a reservation. An ordinary untagged open invalidates pending work.
+class CBobiOpenGate
+{
+public:
+  static CBobiOpenGate& Get()
+  {
+    static CBobiOpenGate gate;
+    return gate;
+  }
+
+  bool Reserve(uint64_t expected, const std::string& request)
+  {
+    std::lock_guard<std::recursive_mutex> lock(m_mutex);
+    if (expected != m_epoch || (!request.empty() && (request.size() != 32 ||
+        request.find_first_not_of("0123456789abcdef") != std::string::npos)))
+      return false;
+    ++m_epoch;
+    m_request = request;
+    m_claimed = false;
+    return true;
+  }
+
+  bool Allowed(const std::string& request) const
+  {
+    std::lock_guard<std::recursive_mutex> lock(m_mutex);
+    return request.empty() || (request == m_request && !m_claimed);
+  }
+
+  bool Claim(const std::string& request)
+  {
+    std::lock_guard<std::recursive_mutex> lock(m_mutex);
+    if (request.empty())
+    {
+      ++m_epoch;
+      m_request.clear();
+      m_claimed = false;
+      return true;
+    }
+    if (!Allowed(request))
+      return false;
+    m_claimed = true;
+    return true;
+  }
+
+  uint64_t Epoch() const
+  {
+    // Player actors must not wait on a gate held by OpenFile/CloseFile callers.
+    return m_epoch.load();
+  }
+
+  std::recursive_mutex& Mutex() { return m_mutex; }
+
+private:
+  mutable std::recursive_mutex m_mutex;
+  std::atomic<uint64_t> m_epoch{0};
+  std::string m_request;
+  bool m_claimed{false};
+};
diff --git a/xbmc/cores/BobiReadStatus.h b/xbmc/cores/BobiReadStatus.h
new file mode 100644
index 0000000..e009438
--- /dev/null
+++ b/xbmc/cores/BobiReadStatus.h
@@ -0,0 +1,37 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+#include <cstdint>
+
+// Preserve signed failures before converting bytes to Blu-ray sectors. A short
+// read can be completed, but a fractional sector must never look like EOF.
+template<class Reader>
+int BobiReadBlocks(Reader&& read, uint8_t* buffer, int requested)
+{
+  if (requested < 0 || requested % 2048 != 0)
+    return -1;
+  int total = 0;
+  for (unsigned reads = 0; total < requested && reads < 32; ++reads)
+  {
+    const int got = read(buffer + total, requested - total);
+    if (got < 0 || got > requested - total)
+      return -1;
+    if (got == 0)
+      return total % 2048 == 0 ? total / 2048 : -1;
+    total += got;
+  }
+  return total == requested ? total / 2048 : -1;
+}
+
+inline int BobiDemuxReadFailure(int result, int ioError, int eof, int again, int interrupted)
+{
+  if (result >= 0 || result == again || result == interrupted)
+    return 0;
+  if (result != eof)
+    return result;
+  return ioError < 0 && ioError != eof && ioError != again && ioError != interrupted ? ioError : 0;
+}
+
+inline bool BobiClearInputReadError(int bytes, bool disc)
+{
+  return bytes > 0 && !disc;
+}
