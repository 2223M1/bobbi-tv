+void AnnounceBobiReceipt(const CVariant& receipt)
+{
+  // Immutable data only: no URL, no mutable m_item and no callback-time lookup
+  // of a Python property that may already belong to the next selection.
+  CServiceBroker::GetAnnouncementManager()->Announce(
+      ANNOUNCEMENT::Player, "OnBobiState", receipt);
+}
+
+std::string BobiSubtitleKey(const SelectionStream& stream, const std::string& instance)
+{
+  std::string value = instance;
+  for (const auto& field : {std::to_string(stream.source), std::to_string(stream.demuxerId),
+       std::to_string(stream.id), std::to_string(static_cast<unsigned int>(stream.flags)),
+       stream.filename, stream.filename2, stream.language, stream.name, stream.codec})
+    value += std::to_string(field.size()) + ":" + field;
+  return KODI::UTILITY::CDigest::Calculate(KODI::UTILITY::CDigest::Type::SHA256, value);
+}
+}
+
+CVariant CVideoPlayer::GetBobiState() const
+{
+  std::unique_lock<CCriticalSection> lock(m_bobiLock);
+  return m_bobiState;
+}
+
+CVariant CVideoPlayer::GetBobiSubtitles() const
+{
+  const auto selectionEpoch = CBobiOpenGate::Get().Epoch();
+  const auto before = GetBobiState();
+  if (before["phase"].asString() != "AV_STARTED") return CVariant();
+  CVariant result(CVariant::VariantTypeObject);
+  result["receipt"] = before;
+  result["selection_epoch"] = selectionEpoch;
+  result["streams"] = CVariant(CVariant::VariantTypeArray);
+  {
+    // Never nest the playback-receipt and content locks.
+    std::unique_lock<CCriticalSection> lock(m_content.m_section);
+    const int count = m_content.m_selectionStreams.CountType(STREAM_SUBTITLE);
+    if (count > 256) { result["status"] = "CATALOG_LIMIT"; return result; }
+    result["current_index"] = m_content.m_subtitleIndex;
+    for (int index = 0; index < count; ++index)
+    {
+      const auto& stream = m_content.m_selectionStreams.Get(STREAM_SUBTITLE, index);
+      CVariant item(CVariant::VariantTypeObject);
+      item["index"] = index;
+      item["stream_key"] = BobiSubtitleKey(stream, before["native_instance"].asString());
+      item["language"] = stream.language.substr(0, 32);
+      item["name"] = stream.name.substr(0, 128);
+      item["isforced"] = (stream.flags & StreamFlags::FLAG_FORCED) != StreamFlags::FLAG_NONE;
+      item["isimpaired"] = (stream.flags & StreamFlags::FLAG_HEARING_IMPAIRED) != StreamFlags::FLAG_NONE;
+      result["streams"].push_back(item);
+    }
+  }
+  result["visible"] = GetSubtitleVisible();
+  const auto after = GetBobiState();
+  if (before["native_instance"] != after["native_instance"] ||
+      before["subtitle_intent"] != after["subtitle_intent"] ||
+      selectionEpoch != CBobiOpenGate::Get().Epoch() ||
+      after["phase"].asString() != "AV_STARTED")
+    return CVariant();
+  result["status"] = "READY";
+  return result;
+}
+
+void CVideoPlayer::BeginBobiInstance(const CFileItem& file)
+{
+  using KODI::UTILITY::CDigest;
+  std::unique_lock<CCriticalSection> lock(m_bobiLock);
+  m_bobiState = CVariant(CVariant::VariantTypeObject);
+  m_bobiState["protocol"] = 1;
+  m_bobiState["native_instance"] = StringUtils::CreateUUID();
+  m_bobiState["open_epoch"] = CBobiOpenGate::Get().Epoch();
+  const auto request = file.GetProperty("bobitv.request_id").asString();
+  const auto identity = file.GetProperty("bobitv.file_identity").asString();
+  m_bobiState["request_id"] = request.size() == 32 ? request : "";
+  m_bobiState["file_identity"] = identity.size() <= 1024 ? identity : "";
+  // PluginDirectory retains GetPath() as the original plugin route and puts
+  // setResolvedUrl's real transport in GetDynPath(). Hash exactly the path
+  // DVDInputStreamFile opens, not a per-request plugin URL or an addon claim.
+  m_bobiState["url_sha256"] = CDigest::Calculate(CDigest::Type::SHA256, file.GetDynPath());
+  m_bobiState["user_intent"] = static_cast<uint64_t>(0);
+  m_bobiState["subtitle_intent"] = static_cast<uint64_t>(0);
+  m_bobiState["subtitle_auto_intent"] = static_cast<uint64_t>(0);
+  m_bobiState["sequence"] = static_cast<uint64_t>(0);
+  m_bobiState["phase"] = "OPEN";
+  m_bobiState["paused"] = false;
+}
+
+CVariant CVideoPlayer::BobiEvent(const std::string& phase, const std::string& reason)
+{
+  std::unique_lock<CCriticalSection> lock(m_bobiLock);
+  if (phase == "AV_STARTED" && m_bobiState["phase"].asString() == "OPEN")
+    m_bobiState["subtitle_auto_intent"] = m_bobiState["subtitle_intent"];
+  m_bobiState["sequence"] = m_bobiState["sequence"].asUnsignedInteger() + 1;
+  m_bobiState["phase"] = phase;
+  m_bobiState["reason"] = reason;
+  m_bobiState["monotonic_us"] = static_cast<uint64_t>(
+      std::chrono::duration_cast<std::chrono::microseconds>(
+          std::chrono::steady_clock::now().time_since_epoch()).count());
+  return m_bobiState;
+}
+
+void CVideoPlayer::BobiUserIntent()
+{
+  std::unique_lock<CCriticalSection> lock(m_bobiLock);
+  if (m_bobiState.isObject())
+    m_bobiState["user_intent"] = m_bobiState["user_intent"].asUnsignedInteger() + 1;
+}
+
+void CVideoPlayer::BobiSubtitleIntent()
+{
+  std::unique_lock<CCriticalSection> lock(m_bobiLock);
+  if (m_bobiState.isObject())
+    m_bobiState["subtitle_intent"] = m_bobiState["subtitle_intent"].asUnsignedInteger() + 1;
+}
+
+CVariant CVideoPlayer::ReserveBobiSubtitle(const CVariant& expected)
+{
+  std::unique_lock<CCriticalSection> lock(m_bobiLock);
+  if (m_bobiState["phase"].asString() != "AV_STARTED" ||
+      expected["native_instance"] != m_bobiState["native_instance"] ||
+      expected["subtitle_intent"] != m_bobiState["subtitle_intent"] ||
+      m_bobiState["open_epoch"].asUnsignedInteger() != CBobiOpenGate::Get().Epoch())
+    return CVariant();
+  m_bobiState["subtitle_intent"] = m_bobiState["subtitle_intent"].asUnsignedInteger() + 1;
+  return m_bobiState;
+}
+
+bool CVideoPlayer::BobiControl(const CVariant& command)
+{
+  // Queue acceptance is not execution success. The actor emits the result.
+  const auto action = command["action"].asString();
+  if (!m_messenger.IsInited() ||
+      (action != "stop" && action != "pause" && action != "resume" &&
+       action != "subtitle_stream" && action != "subtitle_file" && action != "subtitle_file_auto") ||
+      command["native_instance"].asString().size() != 36 ||
+      command["command_id"].asString().size() != 32)
+    return false;
+  m_messenger.Put(std::make_shared<CDVDMsgType<CVariant>>(
+      CDVDMsg::PLAYER_BOBI_CONTROL, command), 1);
+  return true;
+}
