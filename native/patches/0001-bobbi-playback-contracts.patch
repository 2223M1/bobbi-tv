diff --git a/xbmc/dialogs/BobiSubtitleFile.h b/xbmc/dialogs/BobiSubtitleFile.h
new file mode 100644
index 0000000..701df78
--- /dev/null
+++ b/xbmc/dialogs/BobiSubtitleFile.h
@@ -0,0 +1,132 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <fstream>
+#include <functional>
+#include <string>
+#if defined(__ANDROID__)
+#include <cerrno>
+#include <climits>
+#include <cstdlib>
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#else
+#include <filesystem>
+#endif
+#ifdef _WIN32
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+#endif
+
+// Only a direct file in Kodi's own profile cache is eligible. This portable
+// boundary does not assume CoreELEC /storage, ext4, or an external CLI runtime.
+inline bool BobiVerifiedSubtitleFile(const std::string& directory, const std::string& value)
+{
+#if defined(__ANDROID__)
+  // NDK 21's libc++ does not export the C++17 filesystem implementation.
+  // Keep the same direct-child/local-file boundary using the POSIX API, not
+  // a newer NDK or a target-library copied from another operating system.
+  if (directory.empty() || value.empty() || directory[0] != '/' || value[0] != '/' ||
+      directory.find("/../") != std::string::npos || directory.back() == '/' ||
+      value.substr(0, value.find_last_of('/')) != directory) return false;
+  const auto name = value.substr(value.find_last_of('/') + 1);
+  const auto dot = name.find('.');
+  const std::string allowed = "|.utf|.utf8|.utf-8|.sub|.srt|.smi|.rt|.txt|.ssa|.aqt|.jss|.ass|.vtt|.idx|.sup|";
+  if (dot != 32 || name.substr(0, dot).find_first_not_of("0123456789abcdef") != std::string::npos ||
+      allowed.find("|" + name.substr(dot) + "|") == std::string::npos) return false;
+  struct stat root{}, file{};
+  if (lstat(directory.c_str(), &root) || !S_ISDIR(root.st_mode) ||
+      lstat(value.c_str(), &file) || !S_ISREG(file.st_mode) ||
+      file.st_size <= 0 || file.st_size > 64 * 1024 * 1024) return false;
+  char actualRoot[PATH_MAX], actualFile[PATH_MAX];
+  if (!realpath(directory.c_str(), actualRoot) || !realpath(value.c_str(), actualFile)) return false;
+  const std::string canonicalFile(actualFile);
+  return canonicalFile.substr(0, canonicalFile.find_last_of('/')) == actualRoot;
+#else
+  namespace fs = std::filesystem;
+  try
+  {
+    const auto root = fs::u8path(directory);
+    const auto path = fs::u8path(value);
+    if (!root.is_absolute() || !path.is_absolute() ||
+        path.lexically_normal().parent_path() != root.lexically_normal()) return false;
+#ifdef _WIN32
+    if (root.root_name().native().size() != 2) return false;
+    const auto type = GetDriveTypeW(root.root_path().c_str());
+    if (type != DRIVE_FIXED && type != DRIVE_REMOVABLE && type != DRIVE_RAMDISK) return false;
+    const auto attributes = GetFileAttributesW(path.c_str());
+    if (attributes == INVALID_FILE_ATTRIBUTES || (attributes & FILE_ATTRIBUTE_REPARSE_POINT)) return false;
+#endif
+    const auto name = path.filename().u8string();
+    const auto dot = name.find('.');
+    const std::string allowed = "|.utf|.utf8|.utf-8|.sub|.srt|.smi|.rt|.txt|.ssa|.aqt|.jss|.ass|.vtt|.idx|.sup|";
+    if (dot != 32 || name.substr(0, dot).find_first_not_of("0123456789abcdef") != std::string::npos ||
+        allowed.find("|" + name.substr(dot) + "|") == std::string::npos) return false;
+    if (!fs::is_directory(root) || fs::is_symlink(root) || fs::is_symlink(path) ||
+        !fs::is_regular_file(path) || fs::canonical(path).parent_path() != fs::canonical(root)) return false;
+    const auto size = fs::file_size(path);
+    return size > 0 && size <= 64 * 1024 * 1024;
+  }
+  catch (...) { return false; }
+#endif
+}
+
+inline bool BobiReadVerifiedSubtitle(const std::string& directory, const std::string& value,
+    size_t expected, const std::function<void(const void*, size_t)>& consume,
+    const std::function<bool()>& alive)
+{
+#if defined(__ANDROID__)
+  if (!expected || expected > 8 * 1024 * 1024 || !alive() ||
+      !BobiVerifiedSubtitleFile(directory, value)) return false;
+  const int fd = open(value.c_str(), O_RDONLY | O_CLOEXEC | O_NOFOLLOW);
+  if (fd < 0) return false;
+  struct CloseFile { int fd; ~CloseFile() { close(fd); } } closeFile{fd};
+  struct stat before{}, after{}, current{};
+  if (fstat(fd, &before) || !S_ISREG(before.st_mode) ||
+      before.st_size != static_cast<off_t>(expected)) return false;
+  std::array<char, 65536> buffer;
+  size_t total = 0;
+  while (total < expected && alive())
+  {
+    const auto count = read(fd, buffer.data(), std::min(buffer.size(), expected - total));
+    if (count < 0 && errno == EINTR) continue;
+    if (count <= 0) return false;
+    consume(buffer.data(), static_cast<size_t>(count));
+    total += static_cast<size_t>(count);
+  }
+  return total == expected && alive() && !fstat(fd, &after) && !lstat(value.c_str(), &current) &&
+      after.st_dev == current.st_dev && after.st_ino == current.st_ino &&
+      before.st_size == after.st_size && before.st_mtim.tv_sec == after.st_mtim.tv_sec &&
+      before.st_mtim.tv_nsec == after.st_mtim.tv_nsec && BobiVerifiedSubtitleFile(directory, value);
+#else
+  namespace fs = std::filesystem;
+  if (!expected || expected > 8 * 1024 * 1024 || !alive() ||
+      !BobiVerifiedSubtitleFile(directory, value)) return false;
+  try
+  {
+    const auto path = fs::u8path(value);
+    const auto stamp = fs::last_write_time(path);
+    if (fs::file_size(path) != expected) return false;
+    std::ifstream input(path, std::ios::binary);
+    if (!input) return false;
+    std::array<char, 65536> buffer;
+    size_t total = 0;
+    while (total < expected && alive())
+    {
+      input.read(buffer.data(), std::min(buffer.size(), expected - total));
+      const auto count = input.gcount();
+      if (count <= 0) return false;
+      consume(buffer.data(), static_cast<size_t>(count));
+      total += count;
+    }
+    return total == expected && alive() && fs::last_write_time(path) == stamp &&
+           fs::file_size(path) == expected && BobiVerifiedSubtitleFile(directory, value);
+  }
+  catch (...) { return false; }
+#endif
+}
