diff --git a/xbmc/platform/win32/BobiHostLease.h b/xbmc/platform/win32/BobiHostLease.h
new file mode 100644
index 0000000..a318215
--- /dev/null
+++ b/xbmc/platform/win32/BobiHostLease.h
@@ -0,0 +1,40 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+#include <windows.h>
+#include <tlhelp32.h>
+#include <cwchar>
+#include <cstdint>
+
+// This excludes ordinary direct launches and accidental concurrent maintenance.
+// It is not a security boundary against a malicious program under the same user.
+inline bool BobiHasHostLease()
+{
+  wchar_t pipeText[32]{}, parentText[32]{}, lockText[32]{}, profile[32768]{};
+  if (!GetEnvironmentVariableW(L"BOBBI_LAUNCHER_PIPE", pipeText, 32) ||
+      !GetEnvironmentVariableW(L"BOBBI_LAUNCHER_PID", parentText, 32) ||
+      !GetEnvironmentVariableW(L"BOBBI_LAUNCHER_LOCK", lockText, 32) ||
+      !GetEnvironmentVariableW(L"BOBBI_PROFILE_PATH", profile, 32768)) return false;
+  const HANDLE pipe = reinterpret_cast<HANDLE>(static_cast<uintptr_t>(_wcstoui64(pipeText, nullptr, 10)));
+  const HANDLE lock = reinterpret_cast<HANDLE>(static_cast<uintptr_t>(_wcstoui64(lockText, nullptr, 10)));
+  const DWORD parent = wcstoul(parentText, nullptr, 10);
+  DWORD available = 0;
+  if (!parent || GetFileType(pipe) != FILE_TYPE_PIPE || GetFileType(lock) != FILE_TYPE_DISK ||
+      !PeekNamedPipe(pipe, nullptr, 0, nullptr, &available, nullptr) || available) return false;
+  const HANDLE snapshot = CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0);
+  if (snapshot == INVALID_HANDLE_VALUE) return false;
+  PROCESSENTRY32W entry{sizeof(PROCESSENTRY32W)};
+  bool isParent = false;
+  if (Process32FirstW(snapshot, &entry)) do {
+    if (entry.th32ProcessID == GetCurrentProcessId()) {
+      isParent = entry.th32ParentProcessID == parent;
+      break;
+    }
+  } while (Process32NextW(snapshot, &entry));
+  CloseHandle(snapshot);
+  if (!isParent) return false;
+  const HANDLE owner = OpenProcess(SYNCHRONIZE, FALSE, parent);
+  if (!owner) return false;
+  const bool alive = WaitForSingleObject(owner, 0) == WAIT_TIMEOUT;
+  CloseHandle(owner);
+  return alive;
+}
