 using namespace JSONRPC;
+
+JSONRPC_STATUS CSystemOperations::BobiAndroid(const std::string& method,
+    ITransportLayer* transport, IClient* client, const CVariant& parameterObject, CVariant& result)
+{
+#ifdef TARGET_ANDROID
+  using namespace jni;
+  const auto action = parameterObject["action"].asString();
+  if (action == "install" &&
+      CServiceBroker::GetAppComponents().GetComponent<CApplicationPlayer>()->IsPlaying())
+  {
+    result["state"] = "PLAYING";
+    return OK;
+  }
+  auto className = std::string(CCompileInfo::GetClass()) + "/HostBridge";
+  std::replace(className.begin(), className.end(), '/', '.');
+  const auto clazz = CJNIContext::getClassLoader().loadClass(className);
+  const auto response = call_static_method<jhstring>(xbmc_jnienv(), clazz, "request",
+      "(Ljava/lang/String;Ljava/lang/String;)Ljava/lang/String;",
+      jcast<jhstring>(action), jcast<jhstring>(parameterObject["argument"].asString()));
+  if (xbmc_jnienv()->ExceptionCheck())
+  {
+    xbmc_jnienv()->ExceptionClear();
+    return FailedToExecute;
+  }
+  return CJSONVariantParser::Parse(jcast<std::string>(response), result) ? OK : FailedToExecute;
+#else
+  result["state"] = "UNSUPPORTED";
+  return OK;
+#endif
+}
 
