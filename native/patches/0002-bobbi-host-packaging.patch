diff --git a/tools/android/packaging/Makefile.in b/tools/android/packaging/Makefile.in
index 98a1522..6462578 100644
--- a/tools/android/packaging/Makefile.in
+++ b/tools/android/packaging/Makefile.in
@@ -2,6 +2,7 @@ include ../../depends/Makefile.include
 
 BUILD_TYPE:=@CMAKE_BUILD_TYPE@
 BUILD_TYPE_LC:=$(shell echo $(BUILD_TYPE) | tr A-Z a-z)
+BOBBI_GRADLE ?= ./gradlew
 
 OBJS = libshairplay.so
 
@@ -97,9 +98,13 @@ java: res
 	mkdir -p xbmc/java/$(APP_PACKAGE_DIR) xbmc/obj
 	@cp -R xbmc/src/* xbmc/java/$(APP_PACKAGE_DIR)/
 
-package: libs python java
+bobbi_components: sharedapk
+	test -n "$(BOBBI_COMPONENTS_MANIFEST)" && test -n "$(BOBBI_STAGE_TOOL)"
+	python3 "$(BOBBI_STAGE_TOOL)" "$(BOBBI_COMPONENTS_MANIFEST)" xbmc/assets
+
+package: libs python java bobbi_components
 	@echo "Gradle build and sign..."
-	ANDROID_HOME=$(SDKROOT) ./gradlew assemble$(BUILD_TYPE)
+	ANDROID_HOME=$(SDKROOT) $(BOBBI_GRADLE) assemble$(BUILD_TYPE)
 	@cp xbmc/build/outputs/apk/$(BUILD_TYPE_LC)/xbmc-$(BUILD_TYPE_LC).apk $(CMAKE_SOURCE_DIR)/@APP_NAME_LC@app-$(CPU)-$(BUILD_TYPE_LC).apk
 
 $(PREFIX)/lib/xbmc/lib@APP_NAME_LC@.so: $(SRCLIBS)
