+// Pool teardown visits every frame before resetting or closing the decoder. Keep
+// that barrier across BOTH hardware calls; a shared_ptr copy alone only pins memory.
+void CAMLVideoBuffer::Present(uint64_t& previousPts, const CRect& src, const CRect& dst)
+{
+  std::lock_guard lock(m_frameMutex);
+  if (!m_amlCodec || m_omxPts == previousPts)
+    return;
+
+  m_amlCodec->ReleaseFrame(m_bufferIndex);
+  m_amlCodec->SetVideoRect(src, dst);
+  previousPts = m_omxPts;
+  m_amlCodec.reset();
+}
+
+void CAMLVideoBuffer::Discard()
+{
+  std::lock_guard lock(m_frameMutex);
+  if (m_amlCodec)
+    m_amlCodec->ReleaseFrame(m_bufferIndex, true);
+  m_amlCodec.reset();
+}
