+void CVideoPlayer::ObserveBobiCompletion(bool video, bool domainValid, double durationMs)
+{
+  double presented = DVD_NOPTS_VALUE;
+  int late = 0, queued = 0, discard = 0;
+  // Renderer PTS is a media timestamp, not extrapolated by GetClock(). Stalled
+  // unchanged frames retain their original observation age in the tracker.
+  const bool available = video && domainValid &&
+      m_renderManager.GetStats(late, presented, queued, discard) &&
+      presented != DVD_NOPTS_VALUE;
+  std::unique_lock<CCriticalSection> lock(m_bobiLock);
+  m_bobiCompletion.Observe(presented * 1000 / DVD_TIME_BASE, durationMs, available);
+}
+
+void CVideoPlayer::InvalidateBobiCompletion()
+{
+  double presented = DVD_NOPTS_VALUE;
+  int late = 0, queued = 0, discard = 0;
+  m_renderManager.GetStats(late, presented, queued, discard);
+  std::unique_lock<CCriticalSection> lock(m_bobiLock);
+  m_bobiCompletion.Invalidate(presented * 1000 / DVD_TIME_BASE);
+}
