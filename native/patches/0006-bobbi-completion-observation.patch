+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+
+#include "utils/Variant.h"
+
+#include <chrono>
+#include <cmath>
+#include <cstdint>
+
+// A presentation observation, not EOF or control authority. Never advance a
+// media position using elapsed wall time, speed, or the free-running DVD clock.
+class CBobiCompletion
+{
+public:
+  using Clock = std::chrono::steady_clock;
+
+  void Reset()
+  {
+    m_valid = false;
+    m_position = 0;
+    m_duration = 0;
+    m_changed = {};
+    m_waitForChange = false;
+  }
+
+  void Invalidate(double previousPositionMs)
+  {
+    Reset();
+    m_waitForChange = std::isfinite(previousPositionMs) && previousPositionMs >= 0;
+    m_previous = previousPositionMs;
+  }
+
+  void Observe(double positionMs, double durationMs, bool supported,
+               Clock::time_point now = Clock::now())
+  {
+    constexpr double maxExactInteger = 9007199254740991.0;
+    if (!supported || !std::isfinite(positionMs) || !std::isfinite(durationMs) ||
+        positionMs < 0 || durationMs <= 0 || positionMs > durationMs + 3000 ||
+        durationMs > maxExactInteger || positionMs > maxExactInteger)
+    {
+      m_valid = false;
+      return;
+    }
+    const auto position = static_cast<int64_t>(std::llround(positionMs));
+    const auto duration = static_cast<int64_t>(std::llround(durationMs));
+    if (m_waitForChange && positionMs == m_previous)
+      return; // a stale on-screen frame from before a seek/replaced instance
+    m_waitForChange = false;
+    if (m_changed == Clock::time_point{} || position != m_position || duration != m_duration)
+      m_changed = now;
+    m_valid = true;
+    m_position = position;
+    m_duration = duration;
+  }
+
+  CVariant Snapshot(Clock::time_point now = Clock::now()) const
+  {
+    CVariant result(CVariant::VariantTypeObject);
+    const auto age = std::chrono::duration_cast<std::chrono::microseconds>(now - m_changed).count();
+    const bool valid = m_valid && age >= 0;
+    result["schema"] = 1;
+    result["valid"] = valid;
+    result["position_ms"] = valid ? m_position : int64_t{0};
+    result["duration_ms"] = valid ? m_duration : int64_t{0};
+    result["age_us"] = valid ? static_cast<int64_t>(age) : int64_t{0};
+    return result;
+  }
+
+private:
+  bool m_valid{false};
+  bool m_waitForChange{false};
+  double m_previous{0};
+  int64_t m_position{0};
+  int64_t m_duration{0};
+  Clock::time_point m_changed{};
+};
