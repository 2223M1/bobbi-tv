diff --git a/xbmc/cores/VideoPlayer/VideoPlayer.cpp b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
--- a/xbmc/cores/VideoPlayer/VideoPlayer.cpp
+++ b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
@@ -3843,3 +3843,5 @@
-void CVideoPlayer::QueueSubtitleSwitchSeek(const SelectionStream& stream)
+void CVideoPlayer::QueueSubtitleSwitchSeek(const SelectionStream& stream,
+                                          const CVariant& command,
+                                          const CVariant& claim)
 {
   // if (!m_subtitleSeekGate.IsTimePast())
@@ -3861,5 +3863,21 @@
   mode.accurate = true;
   mode.trickplay = true;
   mode.sync = true;
-  m_messenger.Put(std::make_shared<CDVDMsgPlayerSeek>(mode));
+  if (!command.isObject())
+  {
+    m_messenger.Put(std::make_shared<CDVDMsgPlayerSeek>(mode));
+    return;
+  }
+  // CE's subtitle resync is part of the original track operation, not a
+  // second user seek. Preserve the original actor and claimed intent even
+  // when decoder work allowed a later manual command to arrive.
+  auto sync = command;
+  sync["action"] = "seek";
+  sync["audio_sync"] = true;
+  sync["position_ms"] = static_cast<int64_t>(mode.time);
+  sync["expected_sequence"] = claim["sequence"];
+  for (const auto* key : {"user_intent", "subtitle_intent", "audio_intent"})
+    sync[key] = claim[key];
+  m_messenger.Put(std::make_shared<CDVDMsgType<CVariant>>(CDVDMsg::PLAYER_BOBI_CONTROL, sync));
 }
