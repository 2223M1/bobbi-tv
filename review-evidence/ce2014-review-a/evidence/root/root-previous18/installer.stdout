{
  "schema": 1,
  "cases": [
    {
      "id": "INSTALL-BOOT-GATE",
      "expected": "provider starts while its verified activation is pending, or reopening repairs it",
      "actual": {
        "events": [
          "enable_provider",
          "host_started"
        ],
        "phase": "complete",
        "provider_enabled": true,
        "reopening_recovered": false
      },
      "passed": true
    },
    {
      "id": "INSTALL-BOOT-AFTER-ENABLED-PROCESS-LOSS",
      "expected": "an already-enabled provider runs after reboot plus pending-activation recovery",
      "actual": {
        "events": [
          "host_started"
        ],
        "phase": "complete",
        "provider_enabled": true,
        "reopening_recovered": true
      },
      "passed": true
    },
    {
      "id": "CONTROL-BLOCK-STAGED",
      "expected": "unverified file vector cannot start the provider",
      "actual": {
        "phase": "staged",
        "events": [
          "service_exit:0"
        ]
      },
      "passed": true
    },
    {
      "id": "CONTROL-BLOCK-SWITCHING",
      "expected": "unverified file vector cannot start the provider",
      "actual": {
        "phase": "switching",
        "events": [
          "service_exit:0"
        ]
      },
      "passed": true
    },
    {
      "id": "CONTROL-BLOCK-RESTORING",
      "expected": "unverified file vector cannot start the provider",
      "actual": {
        "phase": "restoring",
        "events": [
          "service_exit:0"
        ]
      },
      "passed": true
    },
    {
      "id": "CONTROL-RESTORED-HOST-PENDING",
      "expected": "verified restored files satisfy both the old gate and the actual service gate",
      "actual": {
        "events": [
          "host_started"
        ],
        "old_gate": true,
        "host_pending": "restore"
      },
      "passed": true
    },
    {
      "id": "CONTROL-NOOP-ENABLE",
      "expected": "an acknowledged but ineffective Kodi enable cannot complete the installation",
      "actual": {
        "error": "HOST_ACTIVATION_NOT_CONFIRMED",
        "phase": "activation_pending"
      },
      "passed": true
    },
    {
      "id": "INSTALL-STALE-RUNTIME",
      "expected": "OS-released runtime ownership permits recovery after an actual process loss",
      "actual": {
        "child_exit": 73,
        "marker_after_kill": true,
        "exclusive_runtime_lease_available": true,
        "attempts": [
          {
            "recovered": true
          },
          {
            "recovered": false
          }
        ],
        "phase": "restored",
        "marker_remaining": false
      },
      "passed": true
    },
    {
      "id": "CONTROL-ACTIVE-RUNTIME-OWNER",
      "expected": "quiesce does not delete the registration or admit replacement while its OS lease is held",
      "actual": {
        "lease_busy": true,
        "error": "CINEMA_SERVICE_NOT_STOPPED",
        "marker_unchanged": true,
        "process_alive": true
      },
      "passed": true
    },
    {
      "id": "INSTALL-ENABLE-SNAPSHOT-UNKNOWN",
      "expected": "transient state-read error aborts snapshot capture or preserves the original enable vector",
      "actual": {
        "snapshot_error": "fixture inventory unavailable",
        "originally_enabled_provider": true,
        "saved_enabled_provider": false,
        "final_enabled_provider": true,
        "all_old_files_restored": true,
        "phase": null
      },
      "passed": true
    }
  ],
  "passed": 10,
  "failed": 0
}
