msgctxt "#31103"
msgid "Doubao key check"
msgstr "豆包 Key 检查"

msgctxt "#31104"
msgid "Key works. Use resource type: {0}"
msgstr "Key 可用。资源类型请选：{0}"

msgctxt "#31105"
msgid "The add-on needs a streaming model. Recording-file recognition is not supported."
msgstr "插件用的是流式模型，录音文件识别不支持。"

msgctxt "#31106"
msgid "Key length {0}"
msgstr "Key 长度 {0}"

msgctxt "#31107"
msgid "Key rejected (HTTP 401)."
msgstr "Key 被拒绝（HTTP 401）。"

msgctxt "#31108"
msgid "The service did not recognise this key at all, so the model being enabled is not the problem. Check: 1) the key comes from the Doubao Speech API Key page, not the Ark platform; 2) the console project matches the one that owns the speech service; 3) the key is not disabled; 4) paste it again with the copy button rather than by selecting the text."
msgstr "服务端根本没认出这把 Key，所以问题不在「模型有没有开通」。依次检查：1）Key 是否取自豆包语音的 API Key 页，而不是方舟平台；2）控制台项目是否与开通语音服务的项目一致；3）Key 是否被禁用；4）用页面上的复制按钮重新复制，不要手动框选。"

msgctxt "#31109"
msgid "Key is valid but not entitled to this service."
msgstr "Key 有效，但没有这个服务的权限。"

msgctxt "#31110"
msgid "Could not check the key."
msgstr "无法检查 Key。"

msgctxt "#31111"
msgid "No key file at {0}. Fill it in the scan-to-configure page first."
msgstr "找不到 Key 文件：{0}。请先在扫码配置网页里填写。"

msgctxt "#31112"
msgid "No response from the service. Check the box's network."
msgstr "服务没有响应，请检查盒子网络。"

msgctxt "#31113"
msgid "Unexpected output: {0}"
msgstr "返回异常：{0}"
