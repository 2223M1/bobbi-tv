<?xml version="1.0" encoding="UTF-8"?>
<addon id="plugin.emby_helper"
       name="Emby分库助手"
       version="1.0.2"
       provider-name="YiJun">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
  </requires>
  <extension point="xbmc.python.script" library="default.py">
    <provides>executable</provides>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="zh_CN">Emby 分库管理工具</summary>
    <description lang="zh_CN">自动重建/添加 Emby 同步分库、动态分库、剧集分库播放记录到收藏夹，清理缓存。（注：个人爱好学习与非商业使用，禁止商用）</description>
    <platform>all</platform>
    <license>GPL-2.0-or-later</license>
    <assets>
      <icon>icon.png</icon>
    </assets>
  </extension>
</addon>