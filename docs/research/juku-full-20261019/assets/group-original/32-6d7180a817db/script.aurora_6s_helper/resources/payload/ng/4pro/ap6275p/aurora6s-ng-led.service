[Unit]
Description=Aurora 4 Pro AP6275P NG led driver
After=systemd-modules-load.service
Before=kodi.service
ConditionKernelVersion=4.9.269

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh /storage/.config/aurora6s-ng/load-drivers.sh led
TimeoutStartSec=30

[Install]
WantedBy=multi-user.target
