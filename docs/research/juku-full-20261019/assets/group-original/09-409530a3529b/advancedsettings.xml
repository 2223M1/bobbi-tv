<advancedsettings>
  <!-- ======================================================== -->
  <!-- 1. 音频引擎 (Audio Engine & ALSA Sink)                     -->
  <!-- ======================================================== -->
  <audio>
    <!-- PCM 最大位深限制 (0=不限制由硬件自协商, 常用值: 16, 24, 32) -->
    <!-- 针对非源码透传(PCM输出)时，若外部DAC/功放与32bit握手异常或出现爆音，可限制为16或24 -->
    <pcmsinkbitsmax>0</pcmsinkbitsmax>

    <!-- 音频输出初始化静音保持时间 (单位: 毫秒, 范围: 0-2000, 默认: 0) -->
    <!-- 在切换音频格式/采样率时静音指定时间，彻底消除功放/回音壁锁定时钟瞬间的“噼啪”爆音 -->
    <sinksettleholdms>0</sinksettleholdms>
  </audio>

  <!-- ======================================================== -->
  <!-- 2. 视频播放器与硬件解码 (VideoPlayer, AMLCodec & VC-1)      -->
  <!-- ======================================================== -->
  <video>
    <!-- 蓝光/DVD 交互菜单域数据缓冲队列时长 (单位: 秒, 范围: 0.0-16.0, 默认: 1.0) -->
    <!-- 增大该值可有效避免播放原盘导航菜单时的卡顿与加载延迟 -->
    <menudomainqueuetimesize>1.0</menudomainqueuetimesize>

    <!-- 蓝光无缝分段(Seamless Branching)跨片段边界排空缓冲 (默认: true) -->
    <!-- 在蓝光切片跳转时排空旧解码缓冲，防止多版本/分段蓝光跨 m2ts 衔接处出现音画不同步或马赛克 -->
    <bdboundarydrain>true</bdboundarydrain>

    <!-- 异步字幕解析 (默认: true) -->
    <!-- 将 ASS/SSA 复杂特效字幕和 PGS 图形字幕解析移至后台工作线程，消除加载字幕瞬间的掉帧微卡 -->
    <subtitleasyncparse>true</subtitleasyncparse>

    <!-- 全屏 OSD 异步渲染模式 (0=禁用, 1=强制开启, 2=自动/仅全屏视频活动时开启, 默认: 2) -->
    <!-- 将全屏播放时的进度条、信息面板等 OSD 渲染与主视频播放解耦，大幅提升 OSD 弹出与滑动流畅度 -->
    <asyncfullscreenosd>2</asyncfullscreenosd>

    <!-- 异步视频图层渲染 (默认: true；新版双子的特效字幕闪烁，改为false可以解决) -->
    <asyncvideolayerrender>true</asyncvideolayerrender>

    <!-- 文件末尾最小 Seek 安全距离 (单位: 秒, 范围: 0-600, 默认: 10) -->
    <!-- 防止快进/Seek 过于靠近片尾时直接触发意外退出或连播下一个视频 -->
    <seekminimumdistancebeforeeof>10</seekminimumdistancebeforeeof>

    <!-- 强制使用 Dolby Vision VSVDB V1 数据块 (默认: false) -->
    <!-- 默认使用标准的 V2 格式。若连接极老款仅支持 V1 规范的杜比视界电视/投影仪时可设为 true -->
    <dvvsvdbv1>false</dvvsvdbv1>

    <!-- 隔行扫描硬件反交错延迟补偿 (默认: false) -->
    <!-- 针对 50i/60i 等反交错流，自动补偿硬件 Deinterlacer 带来的 1~2 场时钟延迟以保证绝对唇音同步 -->
    <deinterlacedelaycompensation>false</deinterlacedelaycompensation>

    <!-- 视频场频保持 (默认: true) -->
    <!-- 播放隔行/逐行交替片源时抑制过快的刷新率反复切换，避免电视黑屏闪烁 -->
    <videoratefieldhold>true</videoratefieldhold>

    <!-- VC-1 Amlogic 硬件解码优化: 自动区分逐行与隔行并写入驱动 (默认: true) -->
    <!-- 自动向 /sys/module/amvdec_vc1/parameters/force_frame_int 注入模式，彻底根治晶晨芯片 VC-1 播放卡顿与绿屏 -->
    <vc1forceframeint>true</vc1forceframeint>

    <!-- VC-1 坏帧丢弃机制 (默认: true) -->
    <!-- 遇到损坏或时间戳错乱的 VC-1 帧允许解码器丢帧恢复，防止解码器死锁假死 -->
    <vc1dropframe>true</vc1dropframe>

    <!-- VC-1 时间戳自动修复 (默认: true) -->
    <!-- 对 PTS/DTS 时间戳抖动不平整的 VC-1 片源进行重校准，保证 23.976fps 流畅播放 -->
    <vc1repairtimestamps>true</vc1repairtimestamps>
  </video>

  <!-- ======================================================== -->
  <!-- 3. GUI 渲染与 Mali 绘图管线优化 (EGL, Buffer Age & Shader)   -->
  <!-- ======================================================== -->
  <gui>
    <!-- 基于 EGL Buffer Age 的局部重绘 (0=关闭/全屏重绘, 1=开启局部脏区重绘, 默认: 1) -->
    <!-- 大幅减轻 Amlogic Mali GPU 渲染负担，显著降低发热并提升操作跟手度 -->
    <bufferagepartialredraw>1</bufferagepartialredraw>

    <!-- 渲染作用域结束后更新 Buffer Age 跟踪 (默认: true) -->
    <bufferageafterrenderscope>true</bufferageafterrenderscope>

    <!-- 最大独立脏区跟踪矩形数 (范围: 0-64, 默认: 4) -->
    <!-- 超过该数量时合并为单一外接大包围盒，平衡 CPU 碰撞计算与 GPU 绘制开销 -->
    <maxdirtyregions>4</maxdirtyregions>

    <!-- 交互后跳过休眠的活动窗口时间 (单位: 毫秒, 范围: 0-2000, 默认: 250) -->
    <!-- 用户按键或滑动列表后的 250ms 内不限速，保证界面即时丝滑响应 -->
    <skipsleepactivewindow>250</skipsleepactivewindow>

    <!-- 菜单静止/空闲时的帧率上限 (单位: FPS, 0=不限制/跟随刷新率, 范围: 0-60, 默认: 0) -->
    <!-- 若希望机顶盒在界面停顿时极度省电与降温，可设为 30 或 20 -->
    <menuidleframeratecap>0</menuidleframeratecap>

    <!-- 皮肤 HDR 帧缓冲渲染 (0=关闭, 1=开启, 默认: 0) -->
    <!-- 实验性：允许 Kodi 皮肤直接在 HDR FBO 中以宽色域渲染 -->
    <skinhdrfbo>0</skinhdrfbo>

    <!-- OSD 客制化合成模式 (0=默认, 1=开启, 默认: 0) -->
    <osdguestcomposite>0</osdguestcomposite>

    <!-- OSD 脏区调试跟踪 (0=关闭, 1=开启, 默认: 0) -->
    <osdtrace>0</osdtrace>

    <!-- GUI 材质各向异性过滤 (可选值: 0, 2, 4, 8, 16, 默认: 0 关闭) -->
    <!-- 提升倾斜视角或 3D 视图中皮肤海报和文字的清晰度 -->
    <anisotropicfiltering>0</anisotropicfiltering>

    <!-- 由前到后 (Front-to-Back) 渲染排序 (默认: false) -->
    <!-- 配合早期深度测试减少透明/不透明图层之间的 Overdraw 覆写开销 -->
    <fronttobackrendering>false</fronttobackrendering>

    <!-- 帧交换前清空几何体缓冲 (默认: true) -->
    <geometryclear>true</geometryclear>

    <!-- 交换前后缓冲前等待垂直同步 (默认: true) -->
    <!-- 防止界面滑动撕裂，提供平滑 VSync 锁定 -->
    <waitvsyncbeforeswap>true</waitvsyncbeforeswap>

    <!-- 帧交换前等待 GPU 执行完毕 (0=不等待, 1=始终等待, 2=仅全屏视频播放时等待, 默认: 2) -->
    <!-- 设为 2 时保证全屏播放下视频平面与界面字幕/OSD 刷新步调严格一致 -->
    <waitgpubeforeswap>2</waitgpubeforeswap>

    <!-- sRGB 色彩校正混合 (默认: true) -->
    <!-- 避免 SDR 皮肤界面在覆盖于 HDR / Dolby Vision 视频上方时产生色彩过饱和与刺眼过曝 -->
    <srgbhdrcomposite>true</srgbhdrcomposite>

    <!-- 界面合成抖动抗色带处理 (默认: true) -->
    <!-- 消除暗色渐变背景和半透明浮层上的阶梯色彩断层(Color Banding) -->
    <compositedither>true</compositedither>

    <!-- 异步材质上传 PBO (默认: true) -->
    <!-- 使用 Pixel Buffer Object 在后台上传海报缩略图，杜绝快速翻页时的微顿卡 -->
    <asynctextureupload>true</asynctextureupload>

    <!-- 皮肤纹理 Mipmapping 多级渐远纹理 (默认: false) -->
    <mipmapping>false</mipmapping>

    <!-- Mipmap 锐化偏差值 (范围: 0.0-3.0, 默认: 0.5) -->
    <!-- 负向 LOD 偏移，改善微缩图标的清晰锐利度 -->
    <mipmappingsharpen>0.5</mipmappingsharpen>

    <!-- 仅针对缩小显示的纹理生成 Mipmap (默认: true) -->
    <!-- 节省显存占用，只为小尺寸缩略图生成 Mipmap -->
    <minifiedmipmapping>true</minifiedmipmapping>
  </gui>

  <!-- ======================================================== -->
  <!-- 4. 媒体库管理 (Video Library)                             -->
  <!-- ======================================================== -->
  <videolibrary>
    <!-- 本地同名封面/海报是否区分大小写 (默认: true) -->
    <!-- 若挂载 Linux/NAS/SMB 共享中混有 Poster.JPG 与 poster.jpg，设为 false 可避免搜刮漏图 -->
    <casesensitivelocalartmatch>true</casesensitivelocalartmatch>
  </videolibrary>

  <!-- ======================================================== -->
  <!-- 5. 局域网与网络协议 (Network & NFS)                         -->
  <!-- ======================================================== -->
  <network>
    <!-- NFS 连接超时时间 (单位: 秒, 范围: 0-3600, 默认: 0) -->
    <nfstimeout>0</nfstimeout>

    <!-- NFS 重试次数 (范围: -1 到 30, -1 为默认) -->
    <nfsretries>-1</nfsretries>
  </network>

  <!-- ======================================================== -->
  <!-- 6. 远程 MySQL/MariaDB 连接超时保护 (Database Connect)     -->
  <!-- ======================================================== -->
  <!-- 防止 NAS 睡眠或断网时 Kodi 启动死锁卡在黑屏或 Splash 界面 -->
  <videodatabase>
    <connecttimeout>5</connecttimeout>
  </videodatabase>
  <musicdatabase>
    <connecttimeout>5</connecttimeout>
  </musicdatabase>
  <tvdatabase>
    <connecttimeout>5</connecttimeout>
  </tvdatabase>
  <epgdatabase>
    <connecttimeout>5</connecttimeout>
  </epgdatabase>

  <!-- ======================================================== -->
  <!-- 7. 蓝光 ISO 块缓存 (注: R10 引入；后续 F10 演进至 v22 机制)    -->
  <!-- ======================================================== -->
  <!-- 如果你使用的是纯 R10 镜像，可保留此项；若是最新 F10，此项已内化为 LRU -->
  <blurayisocache>
    <pagesize>262144</pagesize>          <!-- 缓存页大小 256KB -->
    <maxbytes>67108864</maxbytes>        <!-- 最大内存缓存 64MB -->
    <forwardprefetchpages>1</forwardprefetchpages> <!-- 顺序读取预读页数 -->
  </blurayisocache>
</advancedsettings>
