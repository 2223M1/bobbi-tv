<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<settings version="1">
    <section id="plugin.video.juku">
        <category id="general" label="常规设置">
            <group id="1" label="跨屏漫游">
                <setting id="primary_emby_user" type="string" label="绑定的主账号 (默认 admin)">
                    <level>0</level>
                    <default>admin</default>
                    <control type="edit" format="string">
                        <heading>输入 Emby 主账号名称</heading>
                    </control>
                </setting>
            </group>
            <group id="2" label="界面显示">
                <setting id="use_library_view" type="boolean" label="启用库视图 (缩略图/背景/简介)" help="开启后主菜单与各二级菜单以海报缩略图+简介的信息流方式展示；关闭则恢复默认的文件列表视图。">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle"/>
                </setting>
            </group>
        </category>
    </section>
</settings>
