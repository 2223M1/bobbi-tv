msgctxt "#30000"
msgid "General"
msgstr "常规设置"

msgctxt "#30001"
msgid "Cross-screen Roaming"
msgstr "跨屏漫游"

msgctxt "#30002"
msgid "Bound Primary Account (Default: admin)"
msgstr "绑定的主账号 (默认 admin)"

msgctxt "#30003"
msgid "Enter Emby Primary Account Name"
msgstr "输入 Emby 主账号名称"

msgctxt "#30004"
msgid "Interface Display"
msgstr "界面显示"

msgctxt "#30005"
msgid "Enable Library View (Thumb/Fanart/Plot)"
msgstr "启用库视图 (缩略图/背景/简介)"

msgctxt "#30006"
msgid "When enabled, menus display with posters and plot info; when disabled, falls back to default list view."
msgstr "开启后主菜单与各二级菜单以海报缩略图+简介的信息流方式展示；关闭则恢复默认的文件列表视图。"

msgctxt "#30007"
msgid "Phone Connection Mode"
msgstr "手机连接方式"

msgctxt "#30008"
msgid "Choose connection mode for phone scanning. Local Web uses IP:17654 for stable LAN connection without dropouts; PWA Web uses cloud signaling across networks."
msgstr "选择手机扫码连接电视的方式。内置网页适合在同一Wi-Fi局域网下稳定使用，速度快且不掉线；PWA网站使用公网信令穿透，支持跨网络推送。"

msgctxt "#30009"
msgid "Local Web (IP:17654 LAN Direct, Recommended)"
msgstr "内置网页 (IP:17654 局域网直连，推荐)"

msgctxt "#30010"
msgid "PWA Web (Cloud Signaling / Cross-Network)"
msgstr "PWA网站 (公网信令/跨网络)"

msgctxt "#30100"
msgid "Main Menu Management"
msgstr "主菜单管理"

msgctxt "#30101"
msgid "Quick Actions"
msgstr "快捷操作"

msgctxt "#30102"
msgid "Visually Adjust Menu Order and Visibility"
msgstr "可视化调整菜单排序与显示"

msgctxt "#30103"
msgid "Open visual manager dialog to reorder, pin to top, or toggle visibility."
msgstr "打开可视化菜单管理窗口，支持自由上移、下移、置顶与一键切换显示/隐藏。"

msgctxt "#30104"
msgid "Restore Default Menu Order and Visibility"
msgstr "恢复默认菜单排序与全部显示"

msgctxt "#30105"
msgid "Reset all menus to default visibility and order."
msgstr "重置所有菜单为初始显示状态与官方默认顺序。"

msgctxt "#30106"
msgid "Show 'Main Menu Settings' Entry at Bottom of Root Menu"
msgstr "在主菜单末尾显示“主菜单设置”入口"

msgctxt "#30107"
msgid "Adds a settings entry at the bottom of the main menu for quick access."
msgstr "开启后会在主菜单最底部增加一个“主菜单设置”项目，方便随时调整。"

