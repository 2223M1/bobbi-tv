<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.video.juku" name="巨库" version="0.78.9" provider-name="juku">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="default.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.service" library="service.py"/>
    <extension point="xbmc.metadata.scraper.movies" library="resources/lib/scraper.py"/>
    <extension point="xbmc.addon.metadata">
        <platform>all</platform>
        <summary lang="zh_CN">巨库 Kodi 视频插件</summary>
        <description lang="zh_CN">基于 Kodi 19+ VFS 规范，全面升级影视库视图（支持海报墙、背景图与剧情简介，适配皮肤小部件，可在设置中自由切换），提供最近热门、片单浏览和视频搜索等功能,网页端IP:17654</description>
        <assets>
            <icon>resources/icon.png</icon>
            <fanart>resources/fanart.webp</fanart>
        </assets>
    </extension>
</addon>
