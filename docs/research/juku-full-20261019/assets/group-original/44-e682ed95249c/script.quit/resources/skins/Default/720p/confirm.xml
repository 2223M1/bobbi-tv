<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog">
    <defaultcontrol always="true">10</defaultcontrol>
    <backgroundcolor>0</backgroundcolor>
    <allowoverlay>yes</allowoverlay>
    <coordinates>
        <system>1</system>
        <posx>400</posx>
        <posy>200</posy>
        <width>500</width>
        <height>263</height>
    </coordinates>
    <controls>
        <control type="image">
            <posx>0</posx>
            <posy>0</posy>
            <width>500</width>
            <height>263</height>
            <texture border="20" colordiffuse="80000000">/storage/.kodi/addons/script.quit/resources/media/corner_small.png</texture>
        </control>
        <control type="image">
            <posx>5</posx>
            <posy>35</posy>
            <width>125</width>
            <height>188</height>
            <aspectratio>keep</aspectratio>
            <visible>!String.IsEmpty(Window.Property(PosterPath))</visible>
            <texture>$INFO[Window.Property(PosterPath)]</texture>
        </control>
        <control type="label">
            <posx>90</posx>
            <posy>0</posy>
            <width>340</width>
            <height>28</height>
            <label>退出当前播放？</label>
            <font>font14</font>
            <textcolor>FFFF0000</textcolor>
            <align>center</align>
            <aligny>center</aligny>
        </control>
        <control type="image">
            <posx>5</posx>
            <posy>29</posy>
            <width>490</width>
            <height>1</height>
            <texture colordiffuse="FFCCCCCC">/storage/.kodi/addons/script.quit/resources/media/fm_white.png</texture>
        </control>
        <control type="textbox" id="101">
            <posx>140</posx>
            <posy>32</posy>
            <width>355</width>
            <height>223</height>
            <label>$INFO[Window.Property(ContentText)]</label>
            <font>font12</font>
            <textcolor>FFFFFFFF</textcolor>
            <autoscroll delay="1500" time="1500" repeat="1500">true</autoscroll>
            <scroll>true</scroll>
            <scrollspeed>200</scrollspeed>
            <enablefocus>true</enablefocus>
            <pagecontrol>102</pagecontrol>
        </control>
        <control type="scrollbar" id="102">
            <posx>494</posx>
            <posy>32</posy>
            <width>6</width>
            <height>223</height>
            <visible>false</visible>
            <texturesliderbackground>/storage/.kodi/addons/script.quit/resources/media/fm_white.png</texturesliderbackground>
            <texturesliderbar>/storage/.kodi/addons/script.quit/resources/media/fm_white.png</texturesliderbar>
            <texturesliderbarfocus>/storage/.kodi/addons/script.quit/resources/media/fm_white.png</texturesliderbarfocus>
            <textureslidernib>/storage/.kodi/addons/script.quit/resources/media/fm_white.png</textureslidernib>
            <textureslidernibfocus>/storage/.kodi/addons/script.quit/resources/media/fm_white.png</textureslidernibfocus>
        </control>
        <control type="button" id="10">
            <posx>5</posx>
            <posy>226</posy>
            <width>125</width>
            <height>35</height>
            <label>退出</label>
            <font>font14</font>
            <align>center</align>
            <aligny>center</aligny>
            <texturefocus colordiffuse="FFCCCCCC">/storage/.kodi/addons/script.quit/resources/media/selectbox_thin_border.png</texturefocus>
            <texturenofocus></texturenofocus>
        </control>
    </controls>
</window>
